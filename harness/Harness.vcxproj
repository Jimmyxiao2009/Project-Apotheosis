<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM">
      <Configuration>Release</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-0001-4E5F-9A0B-EDGEHTML0001}</ProjectGuid>
    <RootNamespace>Harness</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <ApotheosisWindowsSdkVersion Condition="'$(ApotheosisWindowsSdkVersion)' == ''">10.0.22621.0</ApotheosisWindowsSdkVersion>
    <WindowsTargetPlatformVersion>$(ApotheosisWindowsSdkVersion)</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.15063.0</WindowsTargetPlatformMinVersion>
    <!-- Apotheosis: use a selectable installed SDK, but do not let MSBuild replace the manifest MinVersion;
         保留 Package.appxmanifest 里手写的 10.0.14393.0 → 包可装到 1607/14393 设备。 -->
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <ProjectName>Harness</ProjectName>
    <ApotheosisRoot>$(MSBuildThisFileDirectory)..\</ApotheosisRoot>
    <ApotheosisVcpkgRoot Condition="'$(ApotheosisVcpkgRoot)' == ''">C:\vcpkg</ApotheosisVcpkgRoot>
    <ApotheosisIcuRoot Condition="'$(ApotheosisIcuRoot)' == ''">C:\icu-arm-uwp</ApotheosisIcuRoot>
    <!-- Apotheosis (M4): engine tree and driver directory are overridable so an A/B engine
         (e.g. build-clang-gpu-jit with its own WebCoreDriver-gpu.lib/.dll) can be packaged
         without touching the baseline. Defaults keep the original layout. -->
    <ApotheosisEngineBuildDir Condition="'$(ApotheosisEngineBuildDir)' == ''">$(ApotheosisRoot)build-clang-gpu</ApotheosisEngineBuildDir>
    <ApotheosisDriverDir Condition="'$(ApotheosisDriverDir)' == ''">$(ApotheosisRoot)port</ApotheosisDriverDir>
    <ApotheosisUseOfficialXaml Condition="'$(ApotheosisUseOfficialXaml)' == ''">false</ApotheosisUseOfficialXaml>
    <ApotheosisConsumeOfficialXaml Condition="'$(ApotheosisConsumeOfficialXaml)' == ''">false</ApotheosisConsumeOfficialXaml>
    <ApotheosisXamlIncludeDir Condition="'$(ApotheosisUseOfficialXaml)' == 'true' Or '$(ApotheosisConsumeOfficialXaml)' == 'true'">$(ProjectDir)Generated Files\</ApotheosisXamlIncludeDir>
    <ApotheosisXamlIncludeDir Condition="'$(ApotheosisUseOfficialXaml)' != 'true' And '$(ApotheosisConsumeOfficialXaml)' != 'true'">$(ProjectDir)xamlgen\</ApotheosisXamlIncludeDir>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- Apotheosis: Windows::UI::ViewManagement::StatusBar (status-bar overlay, item 1 of the
       2026-09-03 UI package) is declared in the Windows Mobile Extension SDK, not the base
       Windows.winmd — without this reference the type does not exist at compile time even
       behind an ApiInformation::IsTypePresent guard (that only gates the call at runtime). -->
  <ItemGroup>
    <SDKReference Include="WindowsMobile, Version=$(ApotheosisWindowsSdkVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>Harness_TemporaryKey.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword>apotheosis</PackageCertificatePassword>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ApotheosisXamlIncludeDir);$(ApotheosisRoot)angle\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(ApotheosisUseOfficialXaml)' == 'true' Or '$(ApotheosisConsumeOfficialXaml)' == 'true'">APOTHEOSIS_OFFICIAL_XAML;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ApotheosisXamlCodegen)' == 'true'">APOTHEOSIS_XAML_CODEGEN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <!-- Phase 1b: 链接 build-clang-webcore 的 4 个引擎库 + 驱动/stub 库 + 全部软渲染依赖。
           顺序 WebCore->JSC->PAL->WTF(被依赖者在后);MS link.exe 多遍解析,顺序容错。 -->
      <AdditionalDependencies>libEGL.lib;libGLESv2.lib;WebCoreDriver-gpu.lib;WebCore.lib;JavaScriptCore.lib;PAL.lib;WTF.lib;JavaScriptCore.lib;WTF.lib;libcurl.lib;libssl.lib;libcrypto.lib;cairo.lib;pixman-1.lib;freetype.lib;fontconfig.lib;libexpat.lib;harfbuzz.lib;jpeg.lib;libpng16.lib;libwebp.lib;libwebpdemux.lib;libsharpyuv.lib;libxml2.lib;sqlite3.lib;z.lib;bz2.lib;brotlidec.lib;brotlicommon.lib;icuuc.lib;icuin.lib;icudt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ApotheosisRoot)angle\arm;$(ApotheosisDriverDir);$(ApotheosisEngineBuildDir)\lib;$(ApotheosisVcpkgRoot)\installed\arm-uwp\lib;$(ApotheosisIcuRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- 与 lld-link 验证一致:/OPT:REF 死剥未引用代码,只保留渲染路径闭包(146 stub 覆盖之)。 -->
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>false</EnableCOMDATFolding>
      <!-- Apotheosis: JSC CLoop 解释器(无 JIT)极耗原生栈;真实站点 JS 递归会爆默认 1MB
           线程栈 → 栈溢出闪退(且无 dump)。把 exe 默认栈预留调到 16MB,std::thread 用
           的就是这个 PE 默认栈大小。 -->
      <StackReserveSize>16777216</StackReserveSize>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h" />
    <ClInclude Include="MainPage.xaml.h" />
    <ClInclude Include="WebCoreDriver.h" />
    <ClInclude Include="JitProbe.h" />
    <ClInclude Include="GpuProbe.h" />
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp" />
    <ClCompile Include="MainPage.xaml.cpp" />
    <!-- Apotheosis: official XAML codegen is produced by VS2017 and consumed by the v143 final build.
         xamlgen remains available only for the explicit fallback mode. -->
    <ClCompile Include="JitProbe.cpp">
      <CompileAsWinRT>false</CompileAsWinRT>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="GpuProbe.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Condition="'$(ApotheosisConsumeOfficialXaml)' == 'true'" Include="Generated Files\XamlTypeInfo.Impl.g.cpp" />
    <ClCompile Condition="'$(ApotheosisConsumeOfficialXaml)' == 'true'" Include="Generated Files\XamlTypeInfo.g.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <ItemGroup Condition="'$(ApotheosisUseOfficialXaml)' != 'true' And '$(ApotheosisConsumeOfficialXaml)' != 'true'">
    <None Include="App.xaml" />
    <None Include="MainPage.xaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(ApotheosisUseOfficialXaml)' == 'true'">
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup Condition="'$(ApotheosisConsumeOfficialXaml)' == 'true'">
    <None Include="Generated Files\App.xbf"><DeploymentContent>true</DeploymentContent><Link>App.xbf</Link></None>
    <None Include="Generated Files\MainPage.xbf"><DeploymentContent>true</DeploymentContent><Link>MainPage.xbf</Link></None>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!-- 运行期动态依赖 DLL:全部随 appx 打包(设备无对应版本)。软渲染栈 + ICU。 -->
  <ItemGroup>
    <None Include="$(ApotheosisIcuRoot)\bin\icuuc78.dll"><DeploymentContent>true</DeploymentContent><Link>icuuc78.dll</Link></None>
    <None Include="$(ApotheosisIcuRoot)\bin\icuin78.dll"><DeploymentContent>true</DeploymentContent><Link>icuin78.dll</Link></None>
    <None Include="$(ApotheosisIcuRoot)\bin\icudt78.dll"><DeploymentContent>true</DeploymentContent><Link>icudt78.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\cairo-2.dll"><DeploymentContent>true</DeploymentContent><Link>cairo-2.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\pixman-1-0.dll"><DeploymentContent>true</DeploymentContent><Link>pixman-1-0.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\freetype.dll"><DeploymentContent>true</DeploymentContent><Link>freetype.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\fontconfig-1.dll"><DeploymentContent>true</DeploymentContent><Link>fontconfig-1.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libexpat.dll"><DeploymentContent>true</DeploymentContent><Link>libexpat.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\harfbuzz.dll"><DeploymentContent>true</DeploymentContent><Link>harfbuzz.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\jpeg62.dll"><DeploymentContent>true</DeploymentContent><Link>jpeg62.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libpng16.dll"><DeploymentContent>true</DeploymentContent><Link>libpng16.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libwebp.dll"><DeploymentContent>true</DeploymentContent><Link>libwebp.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libwebpdemux.dll"><DeploymentContent>true</DeploymentContent><Link>libwebpdemux.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libsharpyuv.dll"><DeploymentContent>true</DeploymentContent><Link>libsharpyuv.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libxml2.dll"><DeploymentContent>true</DeploymentContent><Link>libxml2.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\z.dll"><DeploymentContent>true</DeploymentContent><Link>z.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\bz2.dll"><DeploymentContent>true</DeploymentContent><Link>bz2.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\brotlidec.dll"><DeploymentContent>true</DeploymentContent><Link>brotlidec.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\brotlicommon.dll"><DeploymentContent>true</DeploymentContent><Link>brotlicommon.dll</Link></None>
    <!-- Apotheosis: current vcpkg builds sqlite3 as a DLL (import lib only) and libxml2 against libiconv;
         without these two the app fails activation with "The app didn't start" (0x8027025B). Conditional so a
         vcpkg tree with static sqlite3 / iconv-less libxml2 keeps working. -->
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\sqlite3.dll" Condition="Exists('$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\sqlite3.dll')"><DeploymentContent>true</DeploymentContent><Link>sqlite3.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\iconv-2.dll" Condition="Exists('$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\iconv-2.dll')"><DeploymentContent>true</DeploymentContent><Link>iconv-2.dll</Link></None>
    <!-- Apotheosis: curl[http2] links nghttp2 (HTTP/2 multiplexing - the port was HTTP/1.1 only before). -->
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\nghttp2.dll" Condition="Exists('$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\nghttp2.dll')"><DeploymentContent>true</DeploymentContent><Link>nghttp2.dll</Link></None>
    <!-- 网络栈(Phase 1b):curl + OpenSSL 3.6.3(TLS 1.3)。 -->
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libcurl.dll"><DeploymentContent>true</DeploymentContent><Link>libcurl.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libssl-3-arm.dll"><DeploymentContent>true</DeploymentContent><Link>libssl-3-arm.dll</Link></None>
    <None Include="$(ApotheosisVcpkgRoot)\installed\arm-uwp\bin\libcrypto-3-arm.dll"><DeploymentContent>true</DeploymentContent><Link>libcrypto-3-arm.dll</Link></None>
    <!-- GPU 路径1:ANGLE(老 ms-master ANGLE.WindowsStore)ARM UWP 运行时,随 appx 打包。 -->
    <None Include="$(ApotheosisRoot)angle\arm\libEGL.dll"><DeploymentContent>true</DeploymentContent><Link>libEGL.dll</Link></None>
    <None Include="$(ApotheosisRoot)angle\arm\libGLESv2.dll"><DeploymentContent>true</DeploymentContent><Link>libGLESv2.dll</Link></None>
    <!-- WebCore 驱动 DLL(port/*.cpp 编成的 clang-cl ARM32 引擎桥接层,含全部 C ABI 导出)。 -->
    <None Include="$(ApotheosisDriverDir)\WebCoreDriver-gpu.dll"><DeploymentContent>true</DeploymentContent><Link>WebCoreDriver-gpu.dll</Link></None>
    <!-- CA 根证书包(App Container 无系统证书库,curl 用 CURLOPT_CAINFO 指向它做 TLS 校验)。 -->
    <None Include="Assets\cacert.pem"><DeploymentContent>true</DeploymentContent><Link>cacert.pem</Link></None>
    <!-- 字体(App Container 拿不到设备系统字体,必须打包;fontconfig 在运行期经 LocalFolder\fonts.conf 指向这里)。 -->
    <None Include="Assets\fonts\segoeui.ttf"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\segoeui.ttf</Link></None>
    <None Include="Assets\fonts\arial.ttf"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\arial.ttf</Link></None>
    <None Include="Assets\fonts\times.ttf"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\times.ttf</Link></None>
    <None Include="Assets\fonts\cour.ttf"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\cour.ttf</Link></None>
    <!-- Apotheosis: the bold cuts. Without them fontconfig answers every `font-weight: bold` with
         the regular file, WebCore turns that into a *synthetic* bold and draws the whole glyph run
         twice, offset by one CSS pixel - which the page-scale factor multiplies, so a pinch-zoomed
         headline shows two copies of every letter about ten device pixels apart (the "doubled
         text" of packages 11-16). Real bold faces make syntheticBold false and cost ~3.8 MB.
         Conditional like the Noto faces below: fonts are gitignored, so a fresh clone may not have them. -->
    <None Include="Assets\fonts\segoeuib.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\segoeuib.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\segoeuib.ttf</Link></None>
    <None Include="Assets\fonts\arialbd.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\arialbd.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\arialbd.ttf</Link></None>
    <None Include="Assets\fonts\timesbd.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\timesbd.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\timesbd.ttf</Link></None>
    <None Include="Assets\fonts\courbd.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\courbd.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\courbd.ttf</Link></None>
    <!-- Apotheosis: the fallback faces for everything the eight Latin cuts above do not cover -
         Simplified Chinese, the symbol blocks (arrows, check marks, technical and miscellaneous
         symbols) and emoji as monochrome outlines. All four are Noto under the SIL Open Font
         License 1.1, so they may travel inside the package; the licence text of each ships next
         to it. Fetch them with port\fetch-fonts.ps1 - the binaries are gitignored like the
         Microsoft cuts, so the entries stay conditional and a clone that has not run the script
         still packages (it will draw boxes for those characters, which is the old behaviour). -->
    <None Include="Assets\fonts\NotoSansSC-Regular.otf" Condition="Exists('$(ProjectDir)Assets\fonts\NotoSansSC-Regular.otf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\NotoSansSC-Regular.otf</Link></None>
    <None Include="Assets\fonts\NotoSansSymbols-Regular.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\NotoSansSymbols-Regular.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\NotoSansSymbols-Regular.ttf</Link></None>
    <None Include="Assets\fonts\NotoSansSymbols2-Regular.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\NotoSansSymbols2-Regular.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\NotoSansSymbols2-Regular.ttf</Link></None>
    <None Include="Assets\fonts\NotoEmoji-VariableFont_wght.ttf" Condition="Exists('$(ProjectDir)Assets\fonts\NotoEmoji-VariableFont_wght.ttf')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\NotoEmoji-VariableFont_wght.ttf</Link></None>
    <None Include="Assets\fonts\OFL-NotoSansSC.txt" Condition="Exists('$(ProjectDir)Assets\fonts\OFL-NotoSansSC.txt')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\OFL-NotoSansSC.txt</Link></None>
    <None Include="Assets\fonts\OFL-NotoSansSymbols.txt" Condition="Exists('$(ProjectDir)Assets\fonts\OFL-NotoSansSymbols.txt')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\OFL-NotoSansSymbols.txt</Link></None>
    <None Include="Assets\fonts\OFL-NotoSansSymbols2.txt" Condition="Exists('$(ProjectDir)Assets\fonts\OFL-NotoSansSymbols2.txt')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\OFL-NotoSansSymbols2.txt</Link></None>
    <None Include="Assets\fonts\OFL-NotoEmoji.txt" Condition="Exists('$(ProjectDir)Assets\fonts\OFL-NotoEmoji.txt')"><DeploymentContent>true</DeploymentContent><Link>Assets\fonts\OFL-NotoEmoji.txt</Link></None>
  </ItemGroup>

  <ItemGroup>
    <Image Include="Assets\Square150x150Logo.png" />
    <Image Include="Assets\Square44x44Logo.png" />
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\SplashScreen.png" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
