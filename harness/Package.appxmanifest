<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    IgnorableNamespaces="uap mp">

  <Identity Name="EdgeHTMLReborn.Harness"
            Publisher="CN=EdgeHTMLReborn"
            Version="0.1.8.6"
            ProcessorArchitecture="arm" />

  <mp:PhoneIdentity PhoneProductId="b3a9e5c2-1d4f-4a7b-9c8e-0f1a2b3c4d5e" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Apotheosis</DisplayName>
    <PublisherDisplayName>Apotheosis</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.14393.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Harness.App">
      <uap:VisualElements
        DisplayName="Apotheosis"
        Description="现代 WebKit 浏览器 on Windows 10 Mobile (ARM32)"
        BackgroundColor="#1E1E1E"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- JIT 测试:运行期生成可执行代码需此能力(VirtualProtectFromApp 改 PAGE_EXECUTE_* 否则 ACCESS_DENIED)。 -->
    <Capability Name="codeGeneration" />
  </Capabilities>
</Package>
