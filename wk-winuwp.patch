+#pragma once
+
+// Apotheosis (M4 load): attribute the main-thread time that the WinUWP driver's load pump
+// cannot see.
+//
+// The driver drives a navigation from a 50 ms RunLoop timer ("the pump"). It measures its own
+// callback (ms_tick_cb) and infers everything else from the spacing between two callbacks
+// (ms_offpump = period - max(50 ms, previous callback)). On the Lumia that inferred bucket is
+// the largest single one of a page load - 2.6 s of a 4.5 s news-site load, 1.9 s of a 3.2 s
+// tech-news-site one - and until now nothing said what ran in it.
+//
+// This is the accounting for it. A scope is opened at the few places that own main-thread time
+// during a load; each scope charges its bucket only its *self* time (total minus the time its
+// children claimed), so an inner scope always wins over the generic run-loop one that contains
+// it: a DOM timer that runs script is Js, not Timer, and a forced layout inside that script is
+// Js as well, because the script is what asked for it.
+//
+// Deliberate properties:
+//   - off by default. g_apoPhaseEnabled is armed by the driver only while the pump is running
+//     with perf logging on, so the shipping build pays one predictable-branch load per scope.
+//   - the Pump bucket is the driver's own callback: it takes part in the stack (so the
+//     enclosing Timer scope does not charge itself our work) but is never accumulated, because
+//     ms_tick_cb already measures it. Buckets therefore sum to ms_offpump minus run-loop
+//     overhead, and the driver reports that remainder as off_other.
+//   - the state is thread_local, so decode worker threads and WorkQueue run loops accumulate
+//     into their own copies, which nobody reads. No locks, no atomics, no allocation.
+
+#include <wtf/MonotonicTime.h>
+#include <wtf/Noncopyable.h>
+
+#if defined(WK_WINUWP)
+
+namespace WTF {
+
+enum class ApoPhaseBucket : unsigned char {
+    Js = 0,     // DOMTimer::fired, ScriptController::evaluateInWorld
+    Parse,      // HTMLDocumentParser::pumpTokenizer
+    Style,      // Document::resolveStyle, LocalFrameViewLayoutContext::layout
+    Decode,     // BitmapImageSource::nativeImageAtIndexCacheIfNeeded (synchronous decode)
+    Timer,      // a RunLoop scheduled task none of the above claimed
+    Dispatch,   // a RunLoop::dispatch / callOnMainThread function
+    Pump,       // the driver's own pump callback - measured, never accumulated
+    Count
+};
+
+constexpr unsigned apoPhaseBucketCount = static_cast<unsigned>(ApoPhaseBucket::Count);
+
+// Apotheosis (M4 load): how *often*, not how long. The Style bucket sums
+// style resolution and layout into one number, which cannot tell a page that resolves its style
+// once expensively from one the pump re-resolves twenty times. Counted at the same two scopes,
+// plus DOM timer entries so the effect of the load-window timer alignment
+// (wtf/ApoLoadThrottle.h) is visible as "fewer, larger timer runs" rather than only as a total.
+enum class ApoPhaseCounter : unsigned char {
+    StyleRecalc = 0,   // Document::resolveStyle entries
+    Layout,            // LocalFrameViewLayoutContext::layout entries
+    DomTimer,          // DOMTimer::fired entries
+    Count
+};
+
+constexpr unsigned apoPhaseCounterCount = static_cast<unsigned>(ApoPhaseCounter::Count);
+
+class ApoPhase;
+
+inline bool g_apoPhaseEnabled = false;
+inline thread_local double g_apoPhaseMs[apoPhaseBucketCount] { };
+inline thread_local unsigned g_apoPhaseCount[apoPhaseBucketCount] { };
+inline thread_local ApoPhase* g_apoPhaseCurrent = nullptr;
+inline thread_local unsigned g_apoPhaseEvents[apoPhaseCounterCount] { };
+
+class ApoPhase {
+    WTF_MAKE_NONCOPYABLE(ApoPhase);
+public:
+    explicit ApoPhase(ApoPhaseBucket bucket)
+    {
+        if (!g_apoPhaseEnabled)
+            return;
+        m_bucket = bucket;
+        m_parent = g_apoPhaseCurrent;
+        g_apoPhaseCurrent = this;
+        m_start = MonotonicTime::now();
+    }
+
+    ~ApoPhase()
+    {
+        if (!m_start)
+            return;
+        const double total = (MonotonicTime::now() - m_start).milliseconds();
+        g_apoPhaseCurrent = m_parent;
+        if (m_bucket != ApoPhaseBucket::Pump) {
+            const double self = total - m_childMs;
+            g_apoPhaseMs[static_cast<unsigned>(m_bucket)] += self > 0 ? self : 0;
+            ++g_apoPhaseCount[static_cast<unsigned>(m_bucket)];
+        }
+        if (m_parent)
+            m_parent->m_childMs += total;
+    }
+
+private:
+    ApoPhase* m_parent { nullptr };
+    MonotonicTime m_start;
+    double m_childMs { 0 };
+    ApoPhaseBucket m_bucket { ApoPhaseBucket::Timer };
+};
+
+inline void apoPhaseCount(ApoPhaseCounter counter)
+{
+    if (g_apoPhaseEnabled)
+        ++g_apoPhaseEvents[static_cast<unsigned>(counter)];
+}
+
+// Called by the driver at the start of every navigation.
+inline void apoPhaseReset()
+{
+    for (unsigned i = 0; i < apoPhaseBucketCount; ++i) {
+        g_apoPhaseMs[i] = 0;
+        g_apoPhaseCount[i] = 0;
+    }
+    for (unsigned i = 0; i < apoPhaseCounterCount; ++i)
+        g_apoPhaseEvents[i] = 0;
+}
+
+inline double apoPhaseMilliseconds(ApoPhaseBucket bucket)
+{
+    return g_apoPhaseMs[static_cast<unsigned>(bucket)];
+}
+
+inline unsigned apoPhaseEntries(ApoPhaseBucket bucket)
+{
+    return g_apoPhaseCount[static_cast<unsigned>(bucket)];
+}
+
+inline unsigned apoPhaseEvents(ApoPhaseCounter counter)
+{
+    return g_apoPhaseEvents[static_cast<unsigned>(counter)];
+}
+
+} // namespace WTF
+
+#define APO_LOAD_PHASE(bucket) WTF::ApoPhase apoLoadPhaseScope(WTF::ApoPhaseBucket::bucket)
+#define APO_LOAD_COUNT(counter) WTF::apoPhaseCount(WTF::ApoPhaseCounter::counter)
+
+#else
+
+#define APO_LOAD_PHASE(bucket) ((void)0)
+#define APO_LOAD_COUNT(counter) ((void)0)
+
+#endif // defined(WK_WINUWP)
