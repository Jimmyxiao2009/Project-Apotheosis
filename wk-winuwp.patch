+        store->wkSetPanGesture(panning);
+}
+
+// ---------------------------------------------------------------------------
+// Apotheosis (package 4): the raster counters and the per-frame upload budget. They lived in
+// TextureMapperTile.cpp while a second store implementation existed, because they are global facts
+// about a frame that both had to share; they belong here now, and TextureMapperTile is upstream's
+// file again. The names and the contracts are unchanged: the driver declares them by hand and
+// perf.csv's raster_* columns keep their meaning. Engine thread except where an atomic says
+// otherwise.
+// ---------------------------------------------------------------------------
+
+// Apotheosis (package 5): whether a *layer* pass rasterises its tiles on a worker. This used to be
+// the wkWinUWPSetThreadedRaster() runtime switch, carried in the binary for a device A/B; the A/B
+// was decided in 0.1.9.18 (2.9 ms against 25 ms per scroll tick) and it has shipped on since, so it
+// is a constant. Not a switch, not a setting: the only thing that still varies is the *kind* of
+// pass - an image pass replays inline (TileGridBackends::beginImagePass()), and without Cairo there
+// is no recording to hand a worker at all.
+#if USE(CAIRO)
+static const bool wkLayerPassIsThreaded = true;
+#else
+static const bool wkLayerPassIsThreaded = false;
+#endif
+
+// Replays posted but not yet uploaded. Read by the driver to decide whether another composite has
+// to be scheduled.
+static std::atomic<unsigned> s_wkPendingRasterTiles { 0 };
+// Replays that finished since the driver last asked; a tile that is painted for the first time
+// draws nothing until its replay lands, so a missed present is an empty tile on screen.
+static std::atomic<unsigned> s_wkFinishedRasterTiles { 0 };
+// Optional wake-up for the driver, called on the worker - see the header for the contract.
+static std::atomic<void (*)()> s_wkRasterCompletionHandler { nullptr };
+// Level counters for the device A/B.
+static std::atomic<unsigned> s_wkRasterPosted { 0 };
+static std::atomic<unsigned> s_wkRasterCancelled { 0 };
+static std::atomic<unsigned> s_wkRasterBlockingWaits { 0 };
+
+// Apotheosis (2026-09-06/07): uploading a finished replay is not free. A 1024x1024 tile is 4 MB of
+// BGRA that glTexSubImage2D hands to the GL driver on the engine thread - ~8-10 ms each on the
+// Adreno 430 - and a drain that takes every finished tile in one go is what turned an average
+// 4 ms backing-store pass into an occasional 80 ms one (measured on the device). So the
+// drain gets a budget and the remainder is uploaded on the following frames: the pixels are already
+// in memory, nothing is recomputed, only the hand-off to GL is spread out. Two tiles and 12 ms -
+// three at 8-10 ms each *is* the 30 ms frame the budget exists to prevent - and the cells the
+// viewer would notice missing are exempt anyway (R4).
+static const unsigned wkMaxUploadsPerPass = 2;
+static const double wkMaxUploadSecondsPerPass = 0.012;
+// Uploads done and time spent in them since wkWinUWPTexmapBeginUploadPass(). Engine thread only -
+// uploads need the GL context current - so plain variables.
+static unsigned s_wkUploadsThisPass = 0;
+static double s_wkUploadSecondsThisPass = 0;
+// A backing-store walk has opened the pass the next composite paint belongs to. See below.
+static bool s_wkUploadPassOpen = false;
+// Finished replays pushed to a later frame, since the driver last asked. See the header.
+static unsigned s_wkDeferredUploads = 0;
+
+void wkWinUWPTexmapBeginUploadPass(bool startsFrame)
+{
+    // A frame drains finished replays twice: once in the backing-store walk (startsFrame = true,
+    // GraphicsLayerTextureMapper::updateBackingStoreIncludingSubLayers) and once in the composite
+    // that follows it (startsFrame = false, TextureMapperLayer::paint). Both are GL work on the
+    // engine thread inside the same frame, so they have to share one budget - giving each its own
+    // would simply double it and hand back half of the stall the budget exists to remove. The
+    // composite therefore continues the walk's pass instead of opening its own. It does open one
+    // when no walk preceded it, so a paint on its own can never inherit a spent budget and defer
+    // for ever.
+    if (!startsFrame && s_wkUploadPassOpen) {
+        s_wkUploadPassOpen = false;
+        return;
+    }
+    s_wkUploadPassOpen = startsFrame;
+    s_wkUploadsThisPass = 0;
+    s_wkUploadSecondsThisPass = 0;
+}
+
+unsigned wkWinUWPTexmapTakeDeferredUploads()
+{
+    return std::exchange(s_wkDeferredUploads, 0u);
+}
+
+unsigned wkWinUWPTexmapPendingRasterTiles()
+{
+    return s_wkPendingRasterTiles.load(std::memory_order_relaxed);
+}
+
+unsigned wkWinUWPTexmapTakeFinishedRasterTiles()
+{
+    return s_wkFinishedRasterTiles.exchange(0, std::memory_order_acquire);
+}
+
+void wkWinUWPSetRasterCompletionHandler(void (*handler)())
+{
+    s_wkRasterCompletionHandler.store(handler, std::memory_order_relaxed);
+}
+
+void wkWinUWPTexmapRasterStats(unsigned& posted, unsigned& cancelled, unsigned& blockingWaits)
+{
+    posted = s_wkRasterPosted.load(std::memory_order_relaxed);
+    cancelled = s_wkRasterCancelled.load(std::memory_order_relaxed);
+    blockingWaits = s_wkRasterBlockingWaits.load(std::memory_order_relaxed);
+}
+
+void wkWinUWPTexmapNoteRasterPosted()
+{
+    s_wkPendingRasterTiles.fetch_add(1, std::memory_order_relaxed);
+    s_wkRasterPosted.fetch_add(1, std::memory_order_relaxed);
+}
+
+void wkWinUWPTexmapNoteRasterFinished()
+{
+    s_wkPendingRasterTiles.fetch_sub(1, std::memory_order_relaxed);
+    s_wkFinishedRasterTiles.fetch_add(1, std::memory_order_release);
+    if (auto* handler = s_wkRasterCompletionHandler.load(std::memory_order_relaxed))
+        handler();
+}
+
+void wkWinUWPTexmapNoteRasterCancelled()
+{
+    s_wkPendingRasterTiles.fetch_sub(1, std::memory_order_relaxed);
+    s_wkRasterCancelled.fetch_add(1, std::memory_order_relaxed);
+}
+
+void wkWinUWPTexmapNoteRasterBlockingWait()
+{
+    s_wkRasterBlockingWaits.fetch_add(1, std::memory_order_relaxed);
+}
+
+unsigned wkWinUWPTexmapUploadsRemainingThisPass()
+{
+    if (s_wkUploadsThisPass >= wkMaxUploadsPerPass || s_wkUploadSecondsThisPass >= wkMaxUploadSecondsPerPass)
+        return 0;
+    return wkMaxUploadsPerPass - s_wkUploadsThisPass;
+}
+
+void wkWinUWPTexmapNoteUpload(double seconds)
+{
+    ++s_wkUploadsThisPass;
+    s_wkUploadSecondsThisPass += seconds;
+}
+
+void wkWinUWPTexmapNoteDeferredUpload()
+{
+    ++s_wkDeferredUploads;
+}
+
+// ---------------------------------------------------------------------------
+// Apotheosis (package 4): the store identifier space, the input trace ring and the texmap dump.
+// They were in TextureMapperTiledBackingStore.cpp while v1 owned the diagnostics; the zoom and the
+// ghost/cover rings that used to sit beside this one are gone with the mechanics they described,
+// so one ring is left and wkWinUWPTakeTexmapZoomTrace() drains only it.
+// ---------------------------------------------------------------------------
+
+unsigned wkWinUWPNextTexmapStoreId()
+{
+    static unsigned nextStoreId = 1;
+    return nextStoreId++;
+}
+
+// A fixed ring of fixed-length lines - no allocation, no lock, engine thread only, and it must stay
+// affordable inside the very composite it measures. `tg S<id> pass ...` is a complete PassInput, so
+// a device session replays on the PC (tests/tilegrid/replay); that only works if the sequence has
+// no gaps, and a pass line is written on every update of every tiled layer. 256 lines hold a second
+// or two of a scroll on a page with a handful of content layers; the driver drains at the end of
+// every operation.
+static const unsigned wkTileGridTraceLines = 256;
+static const size_t wkTileGridTraceLineLength = 320;
+static char s_wkTileGridTrace[wkTileGridTraceLines][wkTileGridTraceLineLength];
+// Total lines written / already handed out. Unsigned difference, so the counters may wrap.
+static unsigned s_wkTileGridTraceWritten = 0;
+static unsigned s_wkTileGridTraceRead = 0;
+
+void wkWinUWPAppendTileGridTrace(const char* line)
+{
+    if (!line || !*line)
+        return;
+    char* slot = s_wkTileGridTrace[s_wkTileGridTraceWritten % wkTileGridTraceLines];
+    ++s_wkTileGridTraceWritten;
+    // Whole lines only, newline-terminated, always NUL-terminated - the drain below copies with
+    // strlen() and refuses to split a line across two calls.
+    const size_t length = std::min(strlen(line), wkTileGridTraceLineLength - 2);
+    memcpy(slot, line, length);
+    slot[length] = '\n';
+    slot[length + 1] = '\0';
+}
+
+size_t wkWinUWPTakeTexmapZoomTrace(char* buffer, size_t length)
+{
+    if (!buffer || length < 2)
+        return 0;
+    buffer[0] = '\0';
+    size_t used = 0;
+    if (s_wkTileGridTraceRead == s_wkTileGridTraceWritten)
+        return 0;
+
+    // Lines the ring overwrote before anybody read them. Said out loud rather than passed over in
+    // silence: a trace with a gap in it must not read like a complete one.
+    const unsigned outstanding = s_wkTileGridTraceWritten - s_wkTileGridTraceRead;
+    if (outstanding > wkTileGridTraceLines) {
+        s_wkTileGridTraceRead = s_wkTileGridTraceWritten - wkTileGridTraceLines;
+        const int lost = snprintf(buffer, length, "tg lost=%u\n", outstanding - wkTileGridTraceLines);
+        if (lost > 0 && static_cast<size_t>(lost) < length)
+            used += static_cast<size_t>(lost);
+    }
+    while (s_wkTileGridTraceRead != s_wkTileGridTraceWritten) {
+        const char* line = s_wkTileGridTrace[s_wkTileGridTraceRead % wkTileGridTraceLines];
+        const size_t lineLength = strlen(line);
+        // Whole lines only - half a line in stage.txt is worse than a line next time.
+        if (used + lineLength + 1 > length)
+            break;
+        memcpy(buffer + used, line, lineLength);
+        used += lineLength;
+        ++s_wkTileGridTraceRead;
+    }
+    buffer[used] = '\0';
+    return used;
+}
+
+size_t wkWinUWPDumpTexmap(char* buffer, size_t length)
+{
+    if (!buffer || length < 2)
+        return 0;
+
+    unsigned posted = 0;
+    unsigned cancelled = 0;
+    unsigned blockingWaits = 0;
+    wkWinUWPTexmapRasterStats(posted, cancelled, blockingWaits);
+
+    // Apotheosis (package 5): tilegrid= and threadedRaster= are gone from this line with the two
+    // switches they reported - there is one store implementation and a layer pass is always
+    // threaded, so neither could ever say anything but "v2" and "1".
+    const int header = snprintf(buffer, length,
+        "texmap raster posted=%u cancelled=%u blockingWaits=%u\n",
+        posted, cancelled, blockingWaits);
+    if (header < 0)
+        return 0;
+
+    size_t used = std::min(static_cast<size_t>(header), length - 1);
+    // One line per live store.
+    if (used + 2 < length)
+        used += wkWinUWPAppendTileGridDiagnostics(buffer + used, length - used);
+    buffer[used] = '\0';
+    return used;
+}
+
+namespace {
+
+// ---------------------------------------------------------------------------
+// Geometry conversion. The model brings its own IntRect/IntSize so that it
+// builds on the PC without WebCore; this is the whole boundary between the two.
+// The model works in scaled layer coordinates with the origin at (0, 0), which
+// is exactly what GraphicsLayerTextureMapper already hands a backing store.
+// ---------------------------------------------------------------------------
+
+TileGrid::IntRect toModel(const IntRect& rect)
+{
+    return TileGrid::IntRect(rect.x(), rect.y(), rect.width(), rect.height());
+}
+
+IntRect fromModel(const TileGrid::IntRect& rect)
+{
+    return IntRect(rect.x, rect.y, rect.width, rect.height);
+}
+
+FloatRect floatFromModel(const TileGrid::IntRect& rect)
+{
+    return FloatRect(static_cast<float>(rect.x), static_cast<float>(rect.y),
+        static_cast<float>(rect.width), static_cast<float>(rect.height));
+}
+
+// ---------------------------------------------------------------------------
+// Device-pixel snapping: tile *edges* are rounded to whole device pixels rather
+// than tile sizes, so two neighbouring tiles land on the same edge and leave no
+// hairline seam at a non-integer scale. Written for v1 and kept when package 5
+// deleted it; this is the only copy.
+// ---------------------------------------------------------------------------
+
+bool deviceSpaceScaleAndOffset(const TransformationMatrix& matrix, double& scaleX, double& scaleY, double& offsetX, double& offsetY)
+{
+    if (!matrix.isAffine() || matrix.b() || matrix.c())
+        return false;
+    scaleX = matrix.a();
+    scaleY = matrix.d();
+    offsetX = matrix.e();
+    offsetY = matrix.f();
+    return std::isfinite(scaleX) && std::isfinite(scaleY) && std::isfinite(offsetX) && std::isfinite(offsetY)
+        && scaleX > 0 && scaleY > 0;
+}
+
+TransformationMatrix snapTileTransform(const FloatRect& tileRect, double scaleX, double scaleY, double offsetX, double offsetY)
+{
+    const double left = std::round(tileRect.x() * scaleX + offsetX);
+    const double top = std::round(tileRect.y() * scaleY + offsetY);
+    const double right = std::max(std::round(tileRect.maxX() * scaleX + offsetX), left + 1);
+    const double bottom = std::max(std::round(tileRect.maxY() * scaleY + offsetY), top + 1);
+    const double scaledWidth = (right - left) / tileRect.width();
+    const double scaledHeight = (bottom - top) / tileRect.height();
+    return TransformationMatrix(scaledWidth, 0, 0, scaledHeight, left - scaledWidth * tileRect.x(), top - scaledHeight * tileRect.y());
+}
+
+// Apotheosis (device round 1): where a tile rect actually lands, in device
+// pixels - the arithmetic of snapTileTransform() without building a matrix, so
+// the `draw` trace line prints the quad that was drawn rather than a
+// recomputation that could be wrong in a different way than the drawing is.
+// Same helper v1 has as wkDeviceQuad().
+FloatRect deviceQuad(const FloatRect& rect, double scaleX, double scaleY, double offsetX, double offsetY, bool snap)
+{
+    double left = rect.x() * scaleX + offsetX;
+    double top = rect.y() * scaleY + offsetY;
+    double right = rect.maxX() * scaleX + offsetX;
+    double bottom = rect.maxY() * scaleY + offsetY;
+    if (snap) {
+        left = std::round(left);
+        top = std::round(top);
+        right = std::max(std::round(right), left + 1);
+        bottom = std::max(std::round(bottom), top + 1);
+    }
+    return FloatRect(static_cast<float>(left), static_cast<float>(top),
+        static_cast<float>(right - left), static_cast<float>(bottom - top));
+}
+
+// ---------------------------------------------------------------------------
+// Constants (docs/TILEGRID-DESIGN.md 2.6). Everything else the model owns.
+// ---------------------------------------------------------------------------
+
+// R4: how many *budgeted* uploads one composite may offer the model. The
+// effective number is the smaller of this and what is left of the per-frame
+// budget the frame opens (wkWinUWPTexmapBeginUploadPass), which every store of
+// that frame shares.
+const unsigned wkMaxUploadsPerComposite = 2;
+// Replays in flight, i.e. running plus started; each one holds a tile-sized
+// BGRA buffer (4 MB for a full 1024 tile). workers + 2, computed once.
+const unsigned wkInFlightSlack = 2;
+// Threads exit after this idle time; every WTF thread reserves address space in
+// a 32-bit process (4d51f66672), which is why the pool is not kept warm.
+#if USE(CAIRO)
+const Seconds wkRasterWorkerTimeout = 10_s;
+#endif
+
+#if USE(CAIRO)
+// Apotheosis (2.6): clamp(cores - 2, 2, 4). The Snapdragon 808 has 2 x A57 +
+// 4 x A53 and the engine thread, the JSC threads and the image decoders already
+// compete for them. R3 depends on this being more than one: the visible cells
+// of a scale commit are replayed on every worker at once, so six cells cost two
+// replay latencies instead of six.
+unsigned rasterWorkerCount()
+{
+    const int cores = WTF::numberOfProcessorCores();
+    return static_cast<unsigned>(std::max(2, std::min(4, cores - 2)));
+}
+
+WorkerPool& rasterWorkerPool()
+{
+    // Leaked on purpose: the pool outlives every store and
+    // must not be torn down while a replay is running. It costs nothing while
+    // idle (the AutomaticThreads exit on the timeout).
+    static WorkerPool* pool = &WorkerPool::create("TexmapRasterV2"_s, rasterWorkerCount(), wkRasterWorkerTimeout).leakRef();
+    return *pool;
+}
+#endif
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// The key a landed pixel buffer is filed under. (grid, cell) is enough: I12
+// guarantees at most one replay job per tile at a time - a first paint or a
+// patch, never both - and a patch is only ever requested for a Ready tile.
+// "Which buffers are still wanted" is then answered by walking the model's
+// tiles (pruneLanded), not by a timeout.
+//
+// At namespace scope rather than in the anonymous namespace above, because
+// TextureMapperTileGridStore::Impl - a nested class of an externally linked one
+// - has members of these types.
+// ---------------------------------------------------------------------------
+
+struct GridBufferKey {
+    TileGrid::GridId grid { TileGrid::invalidGridId };
+    int column { 0 };
+    int row { 0 };
+};
+
+static bool operator<(const GridBufferKey& a, const GridBufferKey& b)
+{
+    if (a.grid != b.grid)
+        return a.grid < b.grid;
+    if (a.row != b.row)
+        return a.row < b.row;
+    return a.column < b.column;
+}
+
+static GridBufferKey gridKeyOf(TileGrid::GridId grid, TileGrid::CellIndex cell)
+{
+    GridBufferKey key;
+    key.grid = grid;
+    key.column = cell.column;
+    key.row = cell.row;
+    return key;
+}
+
+// ---------------------------------------------------------------------------
+// The two backends of docs/TILEGRID-DESIGN.md 5.1, in one object: the texture
+// side has to free the pixel buffer the raster side produced, and there is
+// exactly one of each per store.
+// ---------------------------------------------------------------------------
+
+class TileGridBackends final : public TileGrid::RasterBackend, public TileGrid::TextureBackend {
+public:
+    struct Job {
+        GridBufferKey key;
+        TileGrid::JobHandle handle { TileGrid::invalidJobHandle };
+        IntRect rect;              // absolute, in the grid's scaled coordinates
+        IntPoint cellOrigin;       // the tile's lattice origin, same coordinates
+        float scale { 1 };
+        bool posted { false };     // handed to a worker (vs replayed inline)
+        bool started { false };    // the model has been told the job is Running
+        bool queued { false };     // recorded, waiting for an in-flight slot (R5)
+#if USE(CAIRO)
+        RefPtr<CoordinatedTileBuffer> buffer;
+        // Held only while `queued`: the recording waits here for a free slot
+        // instead of the request being refused.
+        Cairo::PaintingOperations operations;
+#endif
+    };
+
+    explicit TileGridBackends(int tileEdge)
+        : m_tileEdge(tileEdge)
+    {
+    }
+
+    ~TileGridBackends()
+    {
+        // Nothing this store posted will ever be uploaded - a navigation, a
+        // layer removed, memory pressure. Cancel the replays instead of letting
+        // the workers rasterise tiles nobody will read; a task that has not
+        // started yet frees its recording and its buffer as soon as a worker
+        // reaches it.
+        for (auto& entry : m_inFlight)
+            abandon(*entry.second);
+        m_queue.clear();
+        m_inFlight.clear();
+        m_landed.clear();
+    }
+
+    // --- inputs from the store, set around a pass / a composite ------------
+
+    void beginPass(GraphicsLayer* sourceLayer)
+    {
+        m_sourceLayer = sourceLayer;
+        m_sourceImage = nullptr;
+        m_threadedRaster = wkLayerPassIsThreaded;
+    }
+
+    // Apotheosis (package 4): the image-store form of the same thing. The source is a decoded
+    // frame instead of a render tree, and it is never rasterised on a worker: an image store is
+    // one or two cells that are drawn once, the recording would hold a cairo_surface_t that this
+    // port has never handed across a thread, and there is nothing to gain - the whole point of the
+    // worker is to keep a *scrolling* page off the engine thread. Everything else - the lattice,
+    // the budget, the upload, the draw list - is the model's, exactly as for a layer.
+    void beginImagePass(Image* sourceImage)
+    {
+        m_sourceLayer = nullptr;
+        m_sourceImage = sourceImage;
+        m_threadedRaster = false;
+    }
+
+    void endPass()
+    {
+        m_sourceLayer = nullptr;
+        m_sourceImage = nullptr;
+    }
+
+    // --- TileGrid::RasterBackend ------------------------------------------
+
+    TileGrid::JobHandle record(TileGrid::GridId grid, TileGrid::CellIndex cell,
+        const TileGrid::IntRect& rect, float scale, bool sync) override
+    {
+#if USE(CAIRO)
+        if ((!m_sourceLayer && !m_sourceImage) || rect.isEmpty() || !(scale > 0))
+            return TileGrid::invalidJobHandle;
+
+        const IntRect target = fromModel(rect);
+        auto buffer = CoordinatedUnacceleratedTileBuffer::create(target.size(), CoordinatedTileBuffer::SupportsAlpha);
+        auto& unaccelerated = static_cast<CoordinatedUnacceleratedTileBuffer&>(buffer.get());
+        if (!unaccelerated.data())
+            return TileGrid::invalidJobHandle;
+
+        // Same coordinate set-up as v1's wkBeginThreadedPaint() and as the
+        // synchronous BitmapTexture::updateContents(GraphicsLayer*, ...), down to
+        // applyDeviceScaleFactor(), so all three paths produce the same pixels.
+        // The origin stays in floating point: truncating it shifts every tile's
+        // content by a different sub-pixel amount and leaves a hairline seam.
+        const FloatPoint sourceOrigin(target.x() / scale, target.y() / scale);
+        const IntRect sourceRect = enclosingIntRect(FloatRect(sourceOrigin,
+            FloatSize(target.width() / scale, target.height() / scale)));
+
+        Cairo::PaintingOperations operations;
+        Cairo::PaintingContext::record(operations, [&](GraphicsContext& context) {
+            context.setTextDrawingMode(TextDrawingMode::Fill);
+            // Apotheosis (0.1.9.31 zoom bisect): scale(), not applyDeviceScaleFactor().
+            // The base class implements the latter as scale(factor) - which is what the
+            // synchronous ImageBuffer path in BitmapTexture::updateContents() gets - but
+            // Cairo::OperationRecorder overrides it with an EMPTY function, so a recorded
+            // paint was never scaled: every zoomed tile held scale-1 content of a
+            // sourceRect-sized corner, shifted by origin/scale, and white where the
+            // unscaled page did not reach. Broken since threaded raster went default-on
+            // (0.1.9.18); v2 records on every path and was therefore broken even with
+            // the worker off.
+            context.scale(scale);
+            context.translate(-sourceOrigin.x(), -sourceOrigin.y());
+            if (m_sourceLayer)
+                m_sourceLayer->paintGraphicsLayerContents(context, sourceRect);
+            else {
+                // Apotheosis (package 4): the image-store cell. The frame is drawn at its own
+                // natural size into the same recording a layer paint uses, and the translate above
+                // puts this cell's part of it into the buffer. The scale is 1 for an image store
+                // (updateContentsScale() keeps it there, exactly as v1 did), so the context
+                // transform is the translate alone and the blit is 1:1; the scale() is kept in the
+                // common path so that the two sources cannot drift apart.
+                // Source-over onto a buffer that was just created transparent is a copy, and it
+                // does not touch the pixels outside the image the way CompositeOperator::Copy
+                // would; the tile buffer is exactly this store's own memory either way.
+                const FloatRect imageRect(FloatPoint::zero(), m_sourceImage->size());
+                context.drawImage(*m_sourceImage, imageRect, imageRect);
+            }
+        });
+
+        auto job = std::make_shared<Job>();
+        job->key = gridKeyOf(grid, cell);
+        job->handle = m_nextHandle++;
+        job->rect = target;
+        job->cellOrigin = IntPoint(cell.column * m_tileEdge, cell.row * m_tileEdge);
+        job->scale = scale;
+        job->buffer = WTF::move(buffer);
+
+        // Apotheosis (device round 2): the recording is the job's from here on,
+        // whichever path replays it. 0.1.9.30 moved it into the job only on the
+        // queued path, so post() below replayed an empty list for every job
+        // that found a free slot: the worker finished at once, the model saw a
+        // Finished event with a buffer full of nothing, the upload succeeded,
+        // and every tile was Ready with a transparent texture - background
+        // colour on every page, `holes=0`, no `fail` line. The host tests could
+        // not see it because the fake never replays a recording; an empty
+        // recording is also a legitimate result for an empty layer, so the
+        // guard is this assignment, not a check in post().
+        job->operations = WTF::move(operations);
+        job->buffer->beginPainting();
+        if (!m_threadedRaster) {
+            // Switch off: workerCount() is 0 and the queue is replayed inline on
+            // the engine thread, in the priority order the model handed us
+            // (R3). Nothing crosses a thread, so none of the shared counters
+            // move and no extra present is owed.
+            Cairo::PaintingContext::replay(*job->buffer, job->operations);
+            job->operations.clear();
+            job->buffer->completePainting();
+        } else if (sync || hasInFlightSlot()) {
+            post(*job);
+        } else {
+            // R5: "the in-flight cap of the pool bounds memory; overflow waits
+            // in the queue in priority order instead of falling back". It used
+            // to be refused instead, and a refusal at this point is a request
+            // the model has already committed to - see TileGridCore::dispatch().
+            // A pinch posts ten or more jobs at once, so on the device the cap
+            // (workers + 2) was hit on every zoomed pass. The recording is kept
+            // here and posted by the next poll() that finds a free slot; the
+            // model never sees a capacity refusal, so the only refusals left are
+            // real failures (no source layer, no buffer memory).
+            job->queued = true;
+            m_queue.append(job->handle);
+        }
+
+        m_inFlight[job->handle] = job;
+        return job->handle;
+#else
+        UNUSED_PARAM(grid);
+        UNUSED_PARAM(cell);
+        UNUSED_PARAM(rect);
+        UNUSED_PARAM(scale);
+        UNUSED_PARAM(sync);
+        return TileGrid::invalidJobHandle;
+#endif
+    }
+
+    void cancel(TileGrid::JobHandle handle) override
+    {
+        auto it = m_inFlight.find(handle);
+        if (it == m_inFlight.end())
+            return;
+        abandon(*it->second);
+        if (it->second->posted && m_inFlightPosted)
+            --m_inFlightPosted;
+        if (it->second->queued)
+            m_queue.removeFirst(handle);
+        m_landed.erase(handle);
+        m_inFlight.erase(it);
+    }
+
+    void waitFor(const std::vector<TileGrid::JobHandle>& handles) override
+    {
+#if USE(CAIRO)
+        // R3: all of them together, so n cells on w workers cost ceil(n / w)
+        // replay latencies rather than n. Not counted as a blocking wait: a Sync
+        // job is meant to be waited for, and v1's counter measures the opposite
+        // thing (the engine thread having to rescue a late Async replay).
+        //
+        // A Sync job is never queued (record() posts it whatever the cap says),
+        // but waiting on a job that is still sitting in the queue would hang for
+        // ever, so it is posted first - the cap is a memory bound, not a reason
+        // to deadlock.
+        for (TileGrid::JobHandle handle : handles) {
+            auto it = m_inFlight.find(handle);
+            if (it == m_inFlight.end() || !it->second->buffer)
+                continue;
+            if (it->second->queued)
+                post(*it->second);
+        }
+        for (TileGrid::JobHandle handle : handles) {
+            auto it = m_inFlight.find(handle);
+            if (it == m_inFlight.end() || !it->second->buffer)
+                continue;
+            it->second->buffer->waitUntilPaintingComplete();
+        }
+#else
+        UNUSED_PARAM(handles);
+#endif
+    }
+
+    std::vector<TileGrid::RasterEvent> poll() override
+    {
+        std::vector<TileGrid::RasterEvent> events;
+#if USE(CAIRO)
+        promoteQueuedJobs();
+        for (auto it = m_inFlight.begin(); it != m_inFlight.end();) {
+            Job& job = *it->second;
+            if (job.queued) {
+                ++it;
+                continue;
+            }
+            if (!job.buffer || (job.posted && !job.buffer->wkIsPaintingComplete())) {
+                ++it;
+                continue;
+            }
+
+            // The job machine of section 2.2b has no Queued -> Finished arrow,
+            // so a completion is always reported as Started first. Both land in
+            // the same drain, in job order, which is all the model asks for.
+            if (!job.started) {
+                job.started = true;
+                TileGrid::RasterEvent started;
+                started.kind = TileGrid::RasterEventKind::Started;
+                started.job = job.handle;
+                events.push_back(started);
+            }
+
+            TileGrid::RasterEvent event;
+            event.job = job.handle;
+            if (job.buffer->wkIsCancelled()) {
+                // A cancelled buffer was never replayed - the worker threw the
+                // recording away. R5: that is a failed replay, and the next pass
+                // asks again.
+                event.kind = TileGrid::RasterEventKind::Failed;
+            } else {
+                event.kind = TileGrid::RasterEventKind::Finished;
+                event.pixels.data = it->second.get();
+                event.pixels.rect = toModel(job.rect);
+                event.pixels.scale = job.scale;
+                event.pixels.job = job.handle;
+                m_landed[job.handle] = it->second;
+            }
+            events.push_back(event);
+
+            if (job.posted && m_inFlightPosted)
+                --m_inFlightPosted;
+            it = m_inFlight.erase(it);
+        }
+        promoteQueuedJobs();
+#endif
+        return events;
+    }
+
+    unsigned workerCount() const override
+    {
+#if USE(CAIRO)
+        return m_threadedRaster ? rasterWorkerCount() : 0;
+#else
+        return 0;
+#endif
+    }
+
+    // --- TileGrid::TextureBackend -----------------------------------------
+
+    TileGrid::TextureHandle acquire(TileGrid::IntSize size) override
+    {
+        if (size.isEmpty())
+            return TileGrid::invalidTextureHandle;
+        RefPtr<BitmapTexture> texture = BitmapTexturePool::singleton().acquireTexture(
+            IntSize(size.width, size.height), { BitmapTexture::Flags::SupportsAlpha });
+        if (!texture)
+            return TileGrid::invalidTextureHandle;
+        const TileGrid::TextureHandle handle = m_nextTextureHandle++;
+        m_textures.emplace(handle, WTF::move(texture));
+        return handle;
+    }
+
+    // Apotheosis (device round 2): there is no silent way out of here. The core
+    // has already committed the tile to Ready when it calls this, so a return
+    // without an upload is a Ready tile drawing a cleared pooled texture -
+    // background colour, `holes=0`, no counter moving. Every early return is
+    // therefore `false`, which the core turns into UploadFailed -> Missing and
+    // the trace into a `fail` line, and m_uploadSkips remembers the reason.
+    bool upload(TileGrid::TextureHandle handle, const TileGrid::PixelBuffer& pixels, const TileGrid::IntRect& rect) override
+    {
+#if USE(CAIRO)
+        auto textureIt = m_textures.find(handle);
+        if (textureIt == m_textures.end())
+            return skipUpload(UploadSkip::NoTexture);
+        if (!pixels.data)
+            return skipUpload(UploadSkip::NoBuffer);
+        // `pixels.data` is a Job owned by m_landed. The core and this class prune
+        // their copies of the same map from the same model state, so the two
+        // agree - but "the two agree" is an argument, not a check, and getting it
+        // wrong dereferences freed memory. The job handle travels with the buffer
+        // (device round 1), so the owner is looked up instead of trusted.
+        auto landedIt = m_landed.find(pixels.job);
+        if (landedIt == m_landed.end())
+            return skipUpload(UploadSkip::NotLanded);
+        const Job* job = landedIt->second.get();
+        if (job != static_cast<const Job*>(pixels.data) || !job->buffer)
+            return skipUpload(UploadSkip::WrongJob);
+        auto& unaccelerated = static_cast<CoordinatedUnacceleratedTileBuffer&>(*job->buffer);
+        if (!unaccelerated.data()) {
+            m_landed.erase(landedIt);
+            return skipUpload(UploadSkip::NoPixels);
+        }
+
+        // The model's upload rect is in the grid's coordinates, the buffer holds
+        // the rect the job was recorded for, and the texture holds the tile's
+        // paintedRect - whose origin is the cell's lattice origin (R6/I4). All
+        // three are the same coordinate system, so both offsets are subtractions.
+        const IntRect uploaded = intersection(fromModel(rect), job->rect);
+        if (uploaded.isEmpty()) {
+            m_landed.erase(landedIt);
+            return skipUpload(UploadSkip::EmptyRect);
+        }
+        const IntRect textureRect(uploaded.x() - job->cellOrigin.x(), uploaded.y() - job->cellOrigin.y(),
+            uploaded.width(), uploaded.height());
+        const IntPoint sourceOffset(uploaded.x() - job->rect.x(), uploaded.y() - job->rect.y());
+
+        BitmapTexture& texture = *textureIt->second;
+        if (!IntRect(IntPoint::zero(), texture.size()).contains(textureRect)) {
+            // I4 says this cannot happen (a texture is acquired for the rect its
+            // pixels were rasterised for and dies with the tile). Refusing the
+            // upload rather than writing out of bounds keeps that a diagnostic
+            // rather than a corruption, and the core hears about it.
+            m_landed.erase(landedIt);
+            ++m_refusedUploads;
+            return skipUpload(UploadSkip::OutOfBounds);
+        }
+
+        const MonotonicTime start = MonotonicTime::now();
+        texture.updateContents(unaccelerated.data(), textureRect, sourceOffset,
+            unaccelerated.stride(), PixelFormat::BGRA8);
+        wkWinUWPTexmapNoteUpload((MonotonicTime::now() - start).seconds());
+        m_landed.erase(landedIt);
+        return true;
+#else
+        UNUSED_PARAM(handle);
+        UNUSED_PARAM(pixels);
+        UNUSED_PARAM(rect);
+        return false;
+#endif
+    }
+
+    void release(TileGrid::TextureHandle handle) override
+    {
+        // The pool takes the texture back once nothing else holds it (its own
+        // timer frees it), which is what makes a scroll reuse tile textures
+        // instead of allocating new ones.
+        m_textures.erase(handle);
+    }
+
+    void beginComposite() override
+    {
+        // Deliberately empty. The upload budget is opened once per frame by the
+        // two tree walks (wkWinUWPTexmapBeginUploadPass), globally across every
+        // backing store of both implementations; opening it here would hand back
+        // half the stall it exists to remove.
+    }
+
+    unsigned uploadsRemainingThisComposite() const override
+    {
+        return wkWinUWPTexmapUploadsRemainingThisPass();
+    }
+
+    // --- housekeeping ------------------------------------------------------
+
+    // A landed buffer whose tile no longer exists (removed by R2, cancelled by a
+    // scale change) would otherwise hold its 4 MB for good. Nothing ages here:
+    // the live set is read off the model, exactly as the core prunes its own
+    // copy of the same map.
+    void pruneLanded(const std::set<GridBufferKey>& live)
+    {
+        for (auto it = m_landed.begin(); it != m_landed.end();)
+            it = live.count(it->second->key) ? std::next(it) : m_landed.erase(it);
+    }
+
+    // Why upload() said no, one counter per reason, for the texmap dump.
+    enum class UploadSkip { NoTexture, NoBuffer, NotLanded, WrongJob, NoPixels, EmptyRect, OutOfBounds, Count };
+    unsigned uploadSkips(UploadSkip reason) const { return m_uploadSkips[static_cast<size_t>(reason)]; }
+    unsigned uploadSkipsTotal() const
+    {
+        unsigned total = 0;
+        for (unsigned count : m_uploadSkips)
+            total += count;
+        return total;
+    }
+
+    BitmapTexture* textureFor(TileGrid::TextureHandle handle) const
+    {
+        auto it = m_textures.find(handle);
+        return it == m_textures.end() ? nullptr : it->second.get();
+    }
+
+    unsigned inFlight() const { return static_cast<unsigned>(m_inFlight.size()); }
+    unsigned landed() const { return static_cast<unsigned>(m_landed.size()); }
+    unsigned liveTextures() const { return static_cast<unsigned>(m_textures.size()); }
+    unsigned refusedUploads() const { return m_refusedUploads; }
+    unsigned queuedJobs() const { return static_cast<unsigned>(m_queue.size()); }
+
+private:
+    void abandon(Job& job)
+    {
+#if USE(CAIRO)
+        if (job.buffer)
+            job.buffer->wkCancel();
+        job.operations.clear();
+#else
+        UNUSED_PARAM(job);
+#endif
+    }
+
+#if USE(CAIRO)
+    // R5: the cap is global (a page has dozens of stores, and a cap each would
+    // be no cap at all) and counts running plus started replays, each holding a
+    // tile-sized BGRA buffer.
+    bool hasInFlightSlot() const
+    {
+        return wkWinUWPTexmapPendingRasterTiles() < rasterWorkerCount() + wkInFlightSlack;
+    }
+
+    void post(Job& job)
+    {
+        job.queued = false;
+        job.posted = true;
+        ++m_inFlightPosted;
+        wkWinUWPTexmapNoteRasterPosted();
+        rasterWorkerPool().postTask([operations = WTF::move(job.operations), buffer = Ref { *job.buffer }]() mutable {
+            // Worker thread. Everything the recording refers to was lowered to a
+            // thread-safe cairo object while recording, and the operations are
+            // destroyed here when the lambda goes away.
+            if (buffer->wkIsCancelled()) {
+                operations.clear();
+                buffer->completePainting();
+                wkWinUWPTexmapNoteRasterCancelled();
+                return;
+            }
+            Cairo::PaintingContext::replay(buffer.get(), operations);
+            operations.clear();
+            buffer->completePainting();
+            // Wakes a driver tick loop that has gone idle: with no tick there is
+            // no composite, and with no composite these pixels are never
+            // uploaded and the cell keeps drawing the backdrop.
+            wkWinUWPTexmapNoteRasterFinished();
+        });
+        job.operations.clear();
+    }
+
+    // The queue is drained in the order the model handed the requests over, and
+    // the model hands them over in priority order (R5), so a visible cell is
+    // never posted behind a non-visible one of the same pass. A cell that leaves
+    // the desired set has its job cancelled, which takes it out of the queue.
+    void promoteQueuedJobs()
+    {
+        while (!m_queue.isEmpty() && hasInFlightSlot()) {
+            const TileGrid::JobHandle handle = m_queue.first();
+            m_queue.removeAt(0);
+            auto it = m_inFlight.find(handle);
+            if (it == m_inFlight.end() || !it->second->queued || !it->second->buffer)
+                continue;
+            post(*it->second);
+        }
+    }
+#endif
+
+    int m_tileEdge { 1024 };
+    GraphicsLayer* m_sourceLayer { nullptr };
+    // Apotheosis (package 4): the image-store source, set for the duration of one pass by
+    // beginImagePass(). Exactly one of the two is non-null inside a pass, neither outside it.
+    Image* m_sourceImage { nullptr };
+    bool m_threadedRaster { true };
+    TileGrid::JobHandle m_nextHandle { 1 };
+    TileGrid::TextureHandle m_nextTextureHandle { 1 };
+    unsigned m_inFlightPosted { 0 };
+    unsigned m_refusedUploads { 0 };
+    unsigned m_uploadSkips[static_cast<size_t>(UploadSkip::Count)] {};
+
+    bool skipUpload(UploadSkip reason)
+    {
+        ++m_uploadSkips[static_cast<size_t>(reason)];
+        return false;
+    }
+
+    std::map<TileGrid::JobHandle, std::shared_ptr<Job>> m_inFlight;
+    // Landed pixels waiting for their upload, by job handle: two jobs of one
+    // cell (the initial raster and a whole-cell patch, R6/R10) never overwrite
+    // each other here, exactly as the core keys its copy by (cell, isPatch).
+    std::map<TileGrid::JobHandle, std::shared_ptr<Job>> m_landed;
+    std::map<TileGrid::TextureHandle, RefPtr<BitmapTexture>> m_textures;
+    Vector<TileGrid::JobHandle> m_queue;   // recorded, waiting for a slot (R5)
+};
+
+// ---------------------------------------------------------------------------
+// The store
+// ---------------------------------------------------------------------------
+
+class TextureMapperTileGridStore::Impl {
+public:
+    explicit Impl(unsigned storeId)
+        : m_storeId(storeId)
+        , m_backends(TileGrid::constants::tileEdge)
+        , m_core(storeId, m_backends, m_backends, coreConfig())
+    {
+        m_core.setIllegalArrowObserver([this](const TileGrid::IllegalArrow& arrow) {
+            // I16: one line, and the machine stays where it was. In the tests
+            // this is a failed check; in the engine it is the only way a
+            // combination nobody intended can reach a device log.
+            wkWinUWPAppendTileGridTrace(TileGrid::formatIllegalArrow(m_storeId, arrow).c_str());
+        });
+        m_core.setPanGesture(s_wkTileGridPanGesture);
+    }
+
+    static TileGrid::CoreConfig coreConfig()
+    {
+        TileGrid::CoreConfig config;
+        config.maxUploadsPerComposite = wkMaxUploadsPerComposite;
+        return config;
+    }
+
+    // The keys of every buffer the model still expects, for pruneLanded().
+    std::set<GridBufferKey> liveBufferKeys() const
+    {
+        std::set<GridBufferKey> live;
+        for (const TileGrid::TileInfo& tile : m_core.model().tiles()) {
+            if (tile.state == TileGrid::TileState::Rastering || tile.state == TileGrid::TileState::Landed
+                || tile.patch == TileGrid::PatchState::InFlight || tile.patch == TileGrid::PatchState::Landed)
+                live.insert(gridKeyOf(tile.grid, tile.cell));
+        }
+        return live;
+    }
+
+    FloatRect contentRect() const
+    {
+        FloatRect rect(FloatPoint::zero(), m_size);
+        rect.scale(m_contentsScale);
+        return rect;
+    }
+
+    unsigned m_storeId { 0 };
+    TileGridBackends m_backends;
+    TileGrid::TileGridCore m_core;
+
+    FloatSize m_size;
+    RefPtr<Image> m_image;
+    // Apotheosis (package 4): this store's content comes from an Image, not from a GraphicsLayer.
+    // Sticky - see setContentsToImage() / updateContentsScale().
+    bool m_isImageStore { false };
+    // Apotheosis (package 4): a frame that has not been handed to the model yet. Set by
+    // setContentsToImage(), consumed by the first pass that runs after it.
+    bool m_imageDirty { false };
+    float m_contentsScale { 1 };
+    float m_pageScale { 1 };
+    FloatRect m_visibleRect { FloatRect::infiniteRect() };
+
+    unsigned m_composites { 0 };
+    unsigned m_lastVisibleHoles { 0 };
+    unsigned m_lastVisibleCells { 0 };
+    unsigned m_lastBackdropClips { 0 };
+    // Section 5.3, `draw` line: the composites right after a scale change are the
+    // ones the traces were blind to on the device - the model's bookkeeping is
+    // complete there while the pixels are the newest thing on the page.
+    float m_tracedScale { 0 };
+    unsigned m_drawTraceComposites { 0 };
+};
+
+TextureMapperTileGridStore::TextureMapperTileGridStore()
+    : m_impl(std::make_unique<Impl>(wkWinUWPNextTexmapStoreId()))
+{
+    wkLiveGridStores().append(this);
+}
+
+TextureMapperTileGridStore::~TextureMapperTileGridStore()
+{
+    wkLiveGridStores().removeFirst(this);
+}
+
+void TextureMapperTileGridStore::setContentsToImage(Image* image)
+{
+    // Apotheosis (package 4): the store becomes an image store for good with the first image it
+    // is given, and stays one after m_image has been consumed - the flag is what makes
+    // updateContentsScale() below keep its promise for the whole life of the store.
+    m_impl->m_image = image;
+    if (image) {
+        m_impl->m_isImageStore = true;
+        // New content: the next pass invalidates the frame once. See updateContents(Image*).
+        m_impl->m_imageDirty = true;
+    }
+}
+
+void TextureMapperTileGridStore::updateContentsScale(float scale)
+{
+    // Apotheosis (package 4, v1's updateContentsScale()): an image backing store stays at scale 1.
+    // Its cells are rasterised from the decoded frame at one texel per image pixel, but
+    // contentRect() - which paintToTextureMapper() maps onto the layer's contents rect - does
+    // scale, and GraphicsLayerTextureMapper::setContentsToImage() calls us with
+    // pageScaleFactor() * deviceScaleFactor(). An image arriving during a pinch would otherwise be
+    // drawn into the top-left 1/scale of its own layer. Nothing else in an image store reads the
+    // contents scale, so simply keeping it at 1 is the whole fix, as it was in v1.
+    if (m_impl->m_isImageStore)
+        return;
+    m_impl->m_contentsScale = scale;
+}
+
+void TextureMapperTileGridStore::wkSetPageScale(float scale)
+{
+    m_impl->m_pageScale = scale;
+}
+
+void TextureMapperTileGridStore::wkSetVisibleRect(const FloatRect& rect)
+{
+    // No span, no pan bookkeeping, no cover-step reset: the model derives the
+    // pan direction from consecutive visible rects itself (R1) and the margin is
+    // its only pre-render (R11). This is the whole setter.
+    m_impl->m_visibleRect = rect;
+}
+
+void TextureMapperTileGridStore::wkSetPanGesture(bool panning)
+{
+    m_impl->m_core.setPanGesture(panning);
+}
+
+void TextureMapperTileGridStore::wkFinishPendingPaints()
+{
+    // Nothing to do: the composite drains the backends and performs the uploads
+    // R4 allows, and no other point in the frame may touch tile state (I17).
+}
+
+bool TextureMapperTileGridStore::wantsPass() const
+{
+    return m_impl->m_core.wantsPass();
+}
+
+unsigned TextureMapperTileGridStore::visibleHoles() const
+{
+    return m_impl->m_core.visibleHoles();
+}
+
+void TextureMapperTileGridStore::updateContentsFromImageIfNeeded(TextureMapper& textureMapper)
+{
+    Impl& impl = *m_impl;
+    if (!impl.m_image)
+        return;
+    // Apotheosis (v1's 18af3c3545): a frame that has not decoded yet must not be treated as
+    // painted. Recording a draw of it produces an empty tile and clearing m_image here would mean
+    // the layer stays blank until something sets a *different* NativeImage on it. Keep the image
+    // and retry on the next composite instead - the driver owes one anyway, because the model
+    // still reports the cells as holes.
+    if (!impl.m_image->currentNativeImage())
+        return;
+
+    updateContents(textureMapper, impl.m_image.get(), impl.m_image->size(),
+        enclosingIntRect(impl.m_image->rect()));
+}
+
+void TextureMapperTileGridStore::releaseImageIfPainted()
+{
+    Impl& impl = *m_impl;
+    if (!impl.m_image)
+        return;
+    // The reference is held until every desired cell is Ready, which is why this is asked at the
+    // END of the composite that ran the pass: the pass leaves the cells Landed and this composite's
+    // own upload turns them Ready, so the ordinary case releases the image in the same frame v1
+    // did. What v1 could not have is the other case - a cell the per-composite upload budget (R4)
+    // pushed to a later frame, whose pass needs the source again. R12 is exactly "some desired cell
+    // is not Ready yet"; visibleHoles() keeps asking the driver for the composite that clears it.
+    if (impl.m_core.wantsPass())
+        return;
+    if (auto observer = impl.m_image->imageObserver())
+        observer->didDraw(*impl.m_image);
+    impl.m_image = nullptr;
+}
+
+void TextureMapperTileGridStore::updateContents(TextureMapper&, Image* image, const FloatSize& totalSize,
+    const IntRect& dirtyRect)
+{
+    // Apotheosis (package 4): one pass over the image source. Everything the model needs is the
+    // same as for a layer, with three constants instead of inputs: the scale is 1 (an image store
+    // never zooms, see updateContentsScale()), the visible rect is unknown (nobody hands one to an
+    // image store, and R1 then takes cells(B) in row-major order), and isImage tells R7 that this
+    // grid has no backdrop to keep. Raster is never threaded here - see beginImagePass().
+    if (!image)
+        return;
+    Impl& impl = *m_impl;
+    impl.m_size = totalSize;
+
+    const IntRect bounds = enclosingIntRect(impl.contentRect());
+    impl.m_core.setBounds(TileGrid::IntSize(bounds.width(), bounds.height()));
+    impl.m_core.setScale(impl.m_contentsScale);
+    impl.m_core.setVisibleRect(std::nullopt);
+    impl.m_core.setImageStore(true);
+    // An image store is never budget-limited. The tile budget exists to bound how much of a page
+    // that is far longer than the screen is kept resident; an image store holds one frame that the
+    // decoder has already paid for in full, and R1 truncates the desired set from the top left when
+    // the budget bites, which would simply leave the bottom of a large image blank (v1 tiled all of
+    // it). So the budget is the cell count when that is larger than the default.
+    const unsigned cells = static_cast<unsigned>((bounds.width() + TileGrid::constants::tileEdge - 1) / TileGrid::constants::tileEdge)
+        * static_cast<unsigned>((bounds.height() + TileGrid::constants::tileEdge - 1) / TileGrid::constants::tileEdge);
+    impl.m_core.setTileBudget(std::max(TileGrid::constants::defaultTileBudget, cells));
+    impl.m_core.setThreadedRaster(false);
+    // Once per image, not once per composite. This runs again on every composite for as long as
+    // the model owes a cell (see updateContentsFromImageIfNeeded), and R10 turns a dirty rect over
+    // a Ready tile into a patch job - so re-invalidating the whole frame here would hand the grid
+    // a fresh patch every frame and nothing would ever come to rest. The content changes only when
+    // setContentsToImage() is handed a different NativeImage, which is where the flag is set.
+    if (impl.m_imageDirty && !dirtyRect.isEmpty()) {
+        impl.m_imageDirty = false;
+        impl.m_core.invalidate(toModel(dirtyRect));
+    }
+
+    impl.m_backends.beginImagePass(image);
+    const TileGrid::PassOutput out = impl.m_core.runPass();
+    impl.m_backends.endPass();
+
+    const TileGrid::TileGridModel& model = impl.m_core.model();
+    wkWinUWPAppendTileGridTrace(model.tracePass(impl.m_core.lastPassInput()).c_str());
+    wkWinUWPAppendTileGridTrace(model.traceOut(out).c_str());
+
+    impl.m_backends.pruneLanded(impl.liveBufferKeys());
+}
+
+void TextureMapperTileGridStore::updateContents(TextureMapper& textureMapper, GraphicsLayer* sourceLayer,
+    const FloatSize& totalSize, const IntRect& dirtyRect)
+{
+    Impl& impl = *m_impl;
+    impl.m_size = totalSize;
+
+    // B: the layer in scaled coordinates, origin always (0, 0). The lattice edge
+    // stays 1024 (TileGrid::constants::tileEdge); every GL implementation this
+    // port runs on has maxTextureSize >= 2048 (D3D feature level 9_3), so v1's
+    // min(1024, maxTextureSize) clamp cannot bite and the model's constant does
+    // not have to become an input.
+    const IntRect bounds = enclosingIntRect(impl.contentRect());
+    impl.m_core.setBounds(TileGrid::IntSize(bounds.width(), bounds.height()));
+    impl.m_core.setScale(impl.m_contentsScale);
+    if (impl.m_visibleRect.isInfinite())
+        impl.m_core.setVisibleRect(std::nullopt);
+    else
+        impl.m_core.setVisibleRect(toModel(enclosingIntRect(impl.m_visibleRect)));
+    impl.m_core.setImageStore(false);
+    impl.m_core.setTileBudget(TileGrid::constants::defaultTileBudget);
+    // Apotheosis (package 5): a layer pass is always rasterised on a worker where there is Cairo to
+    // record it - see wkLayerPassIsThreaded.
+    impl.m_core.setThreadedRaster(wkLayerPassIsThreaded);
+    if (!dirtyRect.isEmpty())
+        impl.m_core.invalidate(toModel(dirtyRect));
+
+    impl.m_backends.beginPass(sourceLayer);
+    const TileGrid::PassOutput out = impl.m_core.runPass();
+    impl.m_backends.endPass();
+
+    // Section 5.3: the `pass` line is the complete PassInput the model has just
+    // consumed (the core folds the accumulated dirty rect into it), so a device
+    // session replays on the PC.
+    const TileGrid::TileGridModel& model = impl.m_core.model();
+    wkWinUWPAppendTileGridTrace(model.tracePass(impl.m_core.lastPassInput()).c_str());
+    wkWinUWPAppendTileGridTrace(model.traceOut(out).c_str());
+
+    impl.m_backends.pruneLanded(impl.liveBufferKeys());
+    UNUSED_PARAM(textureMapper);
+}
+
+void TextureMapperTileGridStore::paintToTextureMapper(TextureMapper& textureMapper, const FloatRect& targetRect,
+    const TransformationMatrix& transform, float opacity)
+{
+    Impl& impl = *m_impl;
+    ++impl.m_composites;
+
+    // Apotheosis (package 4, v1's updateContentsFromImageIfNeeded()): an image store is never
+    // walked by updateBackingStoreIfNeeded() - the layer that owns it draws no content of its own -
+    // so the composite is the only place its pass can run. The pass leaves the cells Landed and the
+    // composite below uploads and draws them in this same frame, which is what v1's single
+    // synchronous upload did.
+    updateContentsFromImageIfNeeded(textureMapper);
+
+    // Six composites of `draw` lines after every scale change (section 5.3).
+    if (impl.m_tracedScale != impl.m_contentsScale) {
+        impl.m_tracedScale = impl.m_contentsScale;
+        impl.m_drawTraceComposites = 6;
+    } else if (impl.m_drawTraceComposites)
+        --impl.m_drawTraceComposites;
+
+    const TileGrid::CompositeResult result = impl.m_core.composite();
+
+    impl.m_lastVisibleHoles = result.visibleHoles;
+    impl.m_lastVisibleCells = result.visibleCells;
+    impl.m_lastBackdropClips = result.backdropClips;
+    s_wkTileGridVisibleHoles += result.visibleHoles;
+    // Pixels that exist and are waiting for a later composite. Same meaning as
+    // v1's counter, so perf.csv's raster_deferred column and the driver's "a
+    // present is owed" edge cover both implementations.
+    for (unsigned i = 0; i < result.uploadsDeferred; ++i)
+        wkWinUWPTexmapNoteDeferredUpload();
+
+    const FloatRect content = impl.contentRect();
+    // Apotheosis (device round 1): the rect the model tiles is
+    // enclosingIntRect(content) - that is what updateContents() hands it as B -
+    // and every cell rect is clipped to it. Testing the overhang against the
+    // float `content` therefore reported the right and bottom edge cells as
+    // overhanging on every composite at every non-integer scale, purely because
+    // the enclosing rect is up to a pixel wider: at 4.05x, content.maxX is
+    // 2917.72 and the edge cell's is 2918. That armed a full-layer clip - a
+    // stencil pass over a 2918 x 170748 quad - on every zoomed composite, which
+    // v1 never does. Test against B, the rect the tiles actually live in, so the
+    // clip fires only for a real overhang (the one pass in which a shrunk layer
+    // still draws a paintedRect from before the shrink, section 5.5).
+    const FloatRect tileSpace(FloatPoint::zero(), FloatSize(enclosingIntRect(content).size()));
+    if (!content.isEmpty() && !result.commands.empty()) {
+        const TransformationMatrix adjusted = transform * TransformationMatrix::rectToRect(content, targetRect);
+        double scaleX = 0, scaleY = 0, offsetX = 0, offsetY = 0;
+        const bool snap = deviceSpaceScaleAndOffset(adjusted, scaleX, scaleY, offsetX, offsetY);
+
+        // Section 5.5: a tile keeps drawing the rect it was rasterised for, so a
+        // layer that shrank can have one pass in which a paintedRect overhangs
+        // the new bounds. Clip rather than squeeze - stretching a texture over a
+        // rect it was not rasterised for is exactly what I6 forbids. One clip
+        // for the whole list, and only when something actually overhangs, so an
+        // ordinary composite pays nothing.
+        bool overhangs = false;
+        for (const TileGrid::DrawCommand& command : result.commands) {
+            if (command.op == TileGrid::DrawOp::DrawTile && !tileSpace.contains(floatFromModel(command.rect))) {
+                overhangs = true;
+                break;
+            }
+        }
+        if (overhangs)
+            textureMapper.beginClip(adjusted, FloatRoundedRect(content));
+
+        // Section 5.3, `draw`: what each DrawTile put on the screen, for the
+        // first few composites after a scale change and for every tile whose
+        // texture was filled in this very composite. Those are the draws no
+        // counter can judge - the model has already decided the cell is covered.
+        unsigned drawTraceLines = 0;
+        const bool traceDraws = impl.m_drawTraceComposites > 0;
+
+        for (const TileGrid::DrawCommand& command : result.commands) {
+            switch (command.op) {
+            case TileGrid::DrawOp::BeginClip:
+                // R8: one clip per visible primary cell that has no Ready tile.
+                // The backdrop is drawn only through it, so every visible pixel
+                // comes from exactly one source.
+                textureMapper.beginClip(adjusted, FloatRoundedRect(floatFromModel(command.rect)));
+                break;
+            case TileGrid::DrawOp::EndClip:
+                textureMapper.endClip();
+                break;
+            case TileGrid::DrawOp::DrawTile: {
+                BitmapTexture* texture = impl.m_backends.textureFor(command.texture);
+                if (!texture)
+                    break;
+                const FloatRect tileRect = floatFromModel(command.rect);
+                if (tileRect.isEmpty())
+                    break;
+                const bool edgesExposed = allTileEdgesExposed(content, tileRect);
+                const TransformationMatrix tileTransform = snap
+                    ? snapTileTransform(tileRect, scaleX, scaleY, offsetX, offsetY)
+                    : adjusted;
+                textureMapper.drawTexture(*texture, tileRect, tileTransform, opacity,
+                    edgesExposed ? TextureMapper::AllEdgesExposed::Yes : TextureMapper::AllEdgesExposed::No);
+                if ((traceDraws || command.freshTexture) && drawTraceLines < 16) {
+                    ++drawTraceLines;
+                    const FloatRect quad = deviceQuad(tileRect, scaleX, scaleY, offsetX, offsetY, snap);
+                    char line[256];
+                    snprintf(line, sizeof(line),
+                        "tg S%u draw  c=%d,%d pr=%d,%d,%d,%d tex=%dx%d tgt=%.0f,%.0f,%.0f,%.0f src=%s%s",
+                        impl.m_storeId, command.cell.column, command.cell.row,
+                        command.paintedRect.x, command.paintedRect.y, command.paintedRect.width, command.paintedRect.height,
+                        texture->size().width(), texture->size().height(),
+                        quad.x(), quad.y(), quad.width(), quad.height(),
+                        command.backdrop ? "backdrop" : "primary",
+                        command.freshTexture ? " fresh" : "");
+                    wkWinUWPAppendTileGridTrace(line);
+                }
+                break;
+            }
+            }
+        }
+
+        if (overhangs)
+            textureMapper.endClip();
+    }
+
+    // Section 5.3: a `comp` line while there is something to explain - a
+    // backdrop alive or a hole on screen - and once every 30 composites
+    // otherwise, so a settled page costs one line every few seconds.
+    const bool hasBackdrop = impl.m_core.model().backdropGrid().has_value();
+    if (hasBackdrop || result.visibleHoles || !(impl.m_composites % 30)) {
+        TileGrid::DrawList summary;
+        summary.visibleHoles = result.visibleHoles;
+        summary.visibleCells = result.visibleCells;
+        summary.backdrop.resize(result.backdropClips);
+        wkWinUWPAppendTileGridTrace(impl.m_core.model().traceComposite(summary).c_str());
+    }
+
+    // Both of these are supposed to be impossible; each one is a cell that is
+    // white while the model reports no hole, so a device log must say so rather
+    // than leave it to be deduced from a screenshot.
+    if (result.uploadsFailed || result.drawsWithoutTexture) {
+        char line[160];
+        snprintf(line, sizeof(line), "tg S%u fail  up=%u draw=%u refused=%u lost=%u",
+            impl.m_storeId, result.uploadsFailed, result.drawsWithoutTexture,
+            impl.m_core.refusedRequests(), impl.m_core.failedUploads());
+        wkWinUWPAppendTileGridTrace(line);
+    }
+
+    impl.m_backends.pruneLanded(impl.liveBufferKeys());
+
+    // Apotheosis (package 4): the image source is let go once the model owes nothing - see
+    // releaseImageIfPainted(). A no-op for a layer store.
+    releaseImageIfPainted();
+}
+
+void TextureMapperTileGridStore::drawBorder(TextureMapper& textureMapper, const Color& borderColor, float borderWidth,
+    const FloatRect& targetRect, const TransformationMatrix& transform)
+{
+    const FloatRect content = m_impl->contentRect();
+    if (content.isEmpty())
+        return;
+    const TransformationMatrix adjusted = transform * TransformationMatrix::rectToRect(content, targetRect);
+    for (const TileGrid::TileInfo& tile : m_impl->m_core.model().tiles()) {
+        if (tile.gridState != TileGrid::GridState::Primary || tile.state != TileGrid::TileState::Ready)
+            continue;
+        textureMapper.drawBorder(borderColor, borderWidth, floatFromModel(tile.paintedRect), adjusted);
+    }
+}
+
+void TextureMapperTileGridStore::drawRepaintCounter(TextureMapper& textureMapper, int repaintCount,
+    const Color& borderColor, const FloatRect& targetRect, const TransformationMatrix& transform)
+{
+    const FloatRect content = m_impl->contentRect();
+    if (content.isEmpty())
+        return;
+    const TransformationMatrix adjusted = transform * TransformationMatrix::rectToRect(content, targetRect);
+    for (const TileGrid::TileInfo& tile : m_impl->m_core.model().tiles()) {
+        if (tile.gridState != TileGrid::GridState::Primary || tile.state != TileGrid::TileState::Ready)
+            continue;
+        textureMapper.drawNumber(repaintCount, borderColor, fromModel(tile.paintedRect).location(), adjusted);
+    }
+}
+
+size_t TextureMapperTileGridStore::wkAppendDiagnostics(char* buffer, size_t length) const
+{
+    if (!buffer || length < 2)
+        return 0;
+
+    const Impl& impl = *m_impl;
+    unsigned missing = 0, rastering = 0, landed = 0, ready = 0, patches = 0, backdropTiles = 0;
+    for (const TileGrid::TileInfo& tile : impl.m_core.model().tiles()) {
+        if (tile.gridState != TileGrid::GridState::Primary) {
+            ++backdropTiles;
+            continue;
+        }
+        switch (tile.state) {
+        case TileGrid::TileState::Missing:   ++missing; break;
+        case TileGrid::TileState::Rastering: ++rastering; break;
+        case TileGrid::TileState::Landed:    ++landed; break;
+        case TileGrid::TileState::Ready:     ++ready; break;
+        case TileGrid::TileState::Gone:      break;
+        }
+        if (tile.patch != TileGrid::PatchState::None)
+            ++patches;
+    }
+
+    const auto backdrop = impl.m_core.model().backdropGrid();
+    const char backdropKind = !backdrop ? '-'
+        : (backdrop->state == TileGrid::GridState::PersistentBackdrop ? 'p' : 't');
+    const bool hasVisible = !impl.m_visibleRect.isInfinite();
+    const FloatRect visible = hasVisible ? impl.m_visibleRect : FloatRect();
+
+    const int written = snprintf(buffer, length,
+        "S%u tilegrid size=%.0fx%.0f cs=%.3f ps=%.3f vis=%.0f,%.0f,%.0fx%.0f "
+        "miss=%u rast=%u land=%u ready=%u patch=%u bd=%c%u holes=%u/%u clips=%u "
+        "jobs=%u queued=%u buffers=%u tex=%u refused=%u/%u lost=%u skips=%u wants=%u\n",
+        impl.m_storeId, impl.m_size.width(), impl.m_size.height(), impl.m_contentsScale, impl.m_pageScale,
+        visible.x(), visible.y(), visible.width(), visible.height(),
+        missing, rastering, landed, ready, patches,
+        backdropKind, backdrop ? backdrop->age : 0u,
+        impl.m_lastVisibleHoles, impl.m_lastVisibleCells, impl.m_lastBackdropClips,
+        impl.m_backends.inFlight(), impl.m_backends.queuedJobs(), impl.m_backends.landed(),
+        impl.m_backends.liveTextures(),
+        impl.m_backends.refusedUploads(), impl.m_core.refusedRequests(), impl.m_core.failedUploads(),
+        impl.m_backends.uploadSkipsTotal(), impl.m_core.wantsPass() ? 1u : 0u);
+    UNUSED_PARAM(backdropTiles);
+
+    if (written < 0)
+        return 0;
+    return std::min(static_cast<size_t>(written), length - 1);
+}
+
+size_t wkWinUWPAppendTileGridDiagnostics(char* buffer, size_t length)
+{
+    if (!buffer || length < 2)
+        return 0;
+    size_t used = 0;
+    for (auto* store : wkLiveGridStores()) {
+        if (used + 2 >= length)
+            break;
+        used += store->wkAppendDiagnostics(buffer + used, length - used);
+    }
+    buffer[used] = '\0';
+    return used;
+}
+
+} // namespace WebCore
+
+#endif // defined(WK_WINUWP)
