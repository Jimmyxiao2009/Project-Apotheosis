+namespace {
+
+bool nearlyEqual(float a, float b)
+{
+    return std::fabs(a - b) <= 1e-5f * std::max(1.0f, std::max(std::fabs(a), std::fabs(b)));
+}
+
+bool isScaleOne(float s)
+{
+    return nearlyEqual(s, 1.0f);
+}
+
+int floorDiv(int value, int divisor)
+{
+    const int q = value / divisor;
+    return (value % divisor != 0 && ((value < 0) != (divisor < 0))) ? q - 1 : q;
+}
+
+int scaledInt(int value, float factor)
+{
+    return static_cast<int>(std::lround(static_cast<double>(value) * factor));
+}
+
+IntRect scaledRect(const IntRect& r, float factor)
+{
+    const int left = scaledInt(r.x, factor);
+    const int top = scaledInt(r.y, factor);
+    const int right = scaledInt(r.maxX(), factor);
+    const int bottom = scaledInt(r.maxY(), factor);
+    return IntRect(left, top, right - left, bottom - top);
+}
+
+long long squaredDistance(IntPoint a, IntPoint b)
+{
+    const long long dx = static_cast<long long>(a.x) - b.x;
+    const long long dy = static_cast<long long>(a.y) - b.y;
+    return dx * dx + dy * dy;
+}
