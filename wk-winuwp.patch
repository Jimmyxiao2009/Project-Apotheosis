+PassOutput TileGridModel::runPass(const PassInput& in)
+{
+    Impl& impl = *m_impl;
+    PassOutput out;
+
+    // Phase (I17): the store sets scale and visible rect while idle, then opens
+    // a pass. Requests are legal only from here on.
+    // The inbox is drained here, before the pass opens: an Uploaded or a
+    // Requested that reaches the model from outside a composite/pass is
+    // refused by the phase machine and reported (I17).
+    impl.drainInbox(out);
+
+    impl.stepMachine(impl.m_phase, ev::phase::SetScale { });
+    impl.stepMachine(impl.m_phase, ev::phase::SetVisible { });
+    impl.stepMachine(impl.m_phase, ev::phase::BeginPass { });
+
+    ++impl.m_passCount;
+    impl.collectGarbageJobs();
+
+    // Pan direction from the previous visible rect. No time, no velocity: the
+    // sign of the step is all R1 and R5 need.
+    if (impl.m_visible && in.visible) {
+        impl.m_panDirection = IntPoint(
+            (in.visible->x > impl.m_visible->x) - (in.visible->x < impl.m_visible->x),
+            (in.visible->y > impl.m_visible->y) - (in.visible->y < impl.m_visible->y));
+    } else if (!in.visible)
+        impl.m_panDirection = IntPoint();
+    impl.m_previousVisible = impl.m_visible;
+    impl.m_visible = in.visible;
+
+    const IntSize unscaled = impl.unscaledBounds(in.boundsScaled, in.scale);
+    const bool firstPass = !impl.m_primary;
+    const bool scaleChanged = !firstPass && !nearlyEqual(in.scale, impl.m_primary->scale);
+    const bool boundsChanged = !firstPass
+        && (std::abs(unscaled.width - impl.m_unscaledBounds.width) > 1 || std::abs(unscaled.height - impl.m_unscaledBounds.height) > 1);
+
+    impl.m_scaleChangedThisPass = scaleChanged;
+    impl.m_bounds = in.boundsScaled;
+    impl.m_unscaledBounds = unscaled;
+    impl.m_scale = in.scale;
+
+    if (firstPass)
+        impl.m_primary = impl.makeGrid(in.scale, in.boundsScaled, in.tileBudget);
+    else if (scaleChanged)
+        impl.ruleR7ScaleChange(in, out);
+
+    impl.m_primary->budget = in.tileBudget;
+
+    // R6 / R9: a resized layer is a different picture, so it ends a transient
+    // backdrop; the primary and the persistent backdrop follow the new bounds.
+    if (boundsChanged && impl.m_backdrop && impl.m_backdrop->machine.state() == GridState::TransientBackdrop) {
+        impl.stepMachine(impl.m_backdrop->machine, ev::grid::BoundsChanged { }, impl.m_backdrop->id);
+        if (impl.m_backdrop->machine.state() == GridState::Dropped)
+            impl.dropGrid(std::move(impl.m_backdrop), out);
+    }
+    impl.ruleR6BoundsChange(*impl.m_primary, in.boundsScaled, out);
+
+    // R1 / R2
+    const std::vector<CellIndex> desired = impl.ruleR1DesiredCells(*impl.m_primary, in);
+    impl.ruleR2Reconcile(*impl.m_primary, desired, out);
+
+    // R10 (the pass' own dirty rect) then R3.
+    impl.ruleR10DirtyRects(in.dirty, out);
+
+    unsigned priority = 0;
+    impl.ruleR3PaintRequests(*impl.m_primary, in, out, priority);
+    impl.ruleR7MaintainPersistentBackdrop(in, out, priority);
+    impl.ruleR5Reprioritise();
+    impl.ruleR11NoProgressiveCover(out);
+
+    impl.countStates(out);
+    out.refused = impl.m_refusedEvents;
+    impl.m_refusedEvents = 0;
+    out.wantsPass = impl.ruleR12WantsPass();
+    out.visibleHoles = impl.computeVisibleHoles();
+    if (impl.m_backdrop) {
+        out.backdropKind = impl.m_backdrop->machine.state() == GridState::PersistentBackdrop ? 'p' : 't';
+        out.backdropAge = impl.m_backdrop->age;
+    }
+
+    impl.stepMachine(impl.m_phase, ev::phase::EndPass { });
+    return out;
+}
+
+DrawList TileGridModel::composite(const IntRect& visible, unsigned maxUploads)
+{
+    Impl& impl = *m_impl;
+    DrawList draw;
+
+    impl.stepMachine(impl.m_phase, ev::phase::BeginComposite { });
+    ++impl.m_compositeCount;
+
+    PassOutput scratch;
+    impl.drainInbox(scratch);
+    for (TextureId id : scratch.released)
+        draw.released.push_back(id);
+    for (JobId id : scratch.cancels)
+        draw.cancels.push_back(id);
+
+    impl.ruleR4Uploads(visible, maxUploads, draw);
+    impl.ruleR9AgeTransientBackdrop(visible, draw);
+    impl.ruleR8BuildDrawList(visible, draw);
+
+    impl.stepMachine(impl.m_phase, ev::phase::EndComposite { });
+    return draw;
+}
