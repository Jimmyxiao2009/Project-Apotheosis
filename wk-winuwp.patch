+ResourceHandle::~ResourceHandle()
+{
+    // Make sure no in-flight curl callback can touch a destroyed handle.
+    if (d->m_curlDelegate)
+        d->m_curlDelegate->invalidate();
+    if (d->m_curlRequest)
+        d->m_curlRequest->invalidateClient();
