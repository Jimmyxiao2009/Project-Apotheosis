+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// Apotheosis: the five state machines of the TileGrid v2 model
+// (docs/TILEGRID-DESIGN.md sections 2.2 and 2.2b), written as Boost.SML
+// transition tables: tile, dirty patch, grid, replay job and store phase.
+//
+// This header is the ONLY place in the engine that includes <sml.hpp>. It is
+// included by TextureMapperTileGridModel.cpp (and by the host tests in
+// Project-Apotheosis/tests/tilegrid/), never by TextureMapperTileGridModel.h,
+// so the template-heavy library cannot leak into the rest of the build.
+//
+// Every lifecycle in the tiling gets exactly one table here. There is no other
+// place that assigns a state. An event that no row of a table accepts is an
+// illegal arrow: Machine<>::process() reports it through the observer callback
+// installed by the model (invariant I16) and leaves the machine where it was,
+// instead of the silent "combination nobody intended" of the v1 flag bag.
+//
+// Note on SML's unexpected-event handling: SML offers two ways to observe an
+// event that no transition accepts - a catch-all `unexpected_event<_>` row
+// whose action reports it, and the bool returned by process_event(). We use
+// the return value. The catch-all row would have to reach the observer through
+// an SML dependency, i.e. every per-tile machine instance would have to carry a
+// reference to it (there are up to 32 tiles plus a patch machine each), and the
+// generic-lambda action needed to recover the event name is not something SML's
+// function_traits handles portably. The return value carries the same
+// information at zero size cost, and the reporting happens in one place.
+
+#pragma once
+
+#include "TextureMapperTileGridModel.h"
+
+#include <sml.hpp>
+
+namespace WebCore {
+namespace TileGrid {
+
+namespace sml = boost::sml;
+
+// ---------------------------------------------------------------------------
+// Events. Plain structs; every one carries its name for the trace.
+// ---------------------------------------------------------------------------
+
+namespace ev {
+
+// Shared by the tile machine and the patch machine (section 2.2).
+namespace tile {
+struct Requested      { static constexpr const char* name = "Requested"; };
+struct ReplayFinished { static constexpr const char* name = "ReplayFinished"; };
+struct ReplayFailed   { static constexpr const char* name = "ReplayFailed"; };
+struct Uploaded       { static constexpr const char* name = "Uploaded"; };
+struct TextureLost    { static constexpr const char* name = "TextureLost"; };
+struct Cancelled      { static constexpr const char* name = "Cancelled"; };
+struct Dirtied        { static constexpr const char* name = "Dirtied"; };
+struct Removed        { static constexpr const char* name = "Removed"; };
+}
+
+// Grid machine (section 2.2b). The guards carry R7/R9's conditions, so the
+// table stays declarative: K and N are compared inside the guard, and whether
+// a persistent backdrop is alive is a field of the event.
+namespace grid {
+struct ScaleLeaves1    { static constexpr const char* name = "ScaleLeaves1"; };
+struct ScaleReturnsTo1 { static constexpr const char* name = "ScaleReturnsTo1"; };
+struct ScaleChanged    { static constexpr const char* name = "ScaleChanged"; bool persistentAlive { false }; };
+struct Covered         { static constexpr const char* name = "Covered"; unsigned run { 0 }; unsigned k { 0 }; };
+struct Aged            { static constexpr const char* name = "Aged"; unsigned age { 0 }; unsigned n { 0 }; };
+struct BoundsChanged   { static constexpr const char* name = "BoundsChanged"; };
+}
+
+// Replay job machine (section 2.2b). Owned by the raster backend; the model
+// keeps one per outstanding job so that a completion for a job that was
+// already cancelled is an illegal arrow rather than a resurrected tile.
+namespace job {
+struct Started   { static constexpr const char* name = "Started"; };
+struct Finished  { static constexpr const char* name = "Finished"; };
+struct Cancelled { static constexpr const char* name = "Cancelled"; };
+struct Failed    { static constexpr const char* name = "Failed"; };
+struct Watchdog  { static constexpr const char* name = "Watchdog"; };
+}
+
+// Store phase machine (section 2.2b): enforces the call order the model
+// depends on (I17).
+namespace phase {
+struct SetScale       { static constexpr const char* name = "SetScale"; };
+struct SetVisible     { static constexpr const char* name = "SetVisible"; };
+struct BeginPass      { static constexpr const char* name = "BeginPass"; };
+struct EndPass        { static constexpr const char* name = "EndPass"; };
+struct BeginComposite { static constexpr const char* name = "BeginComposite"; };
+struct EndComposite   { static constexpr const char* name = "EndComposite"; };
+struct Upload         { static constexpr const char* name = "Upload"; };
+struct Request        { static constexpr const char* name = "Request"; };
+}
+
+} // namespace ev
+
+// ---------------------------------------------------------------------------
+// Transition tables.
+// ---------------------------------------------------------------------------
+
+namespace machine {
+
+// State tags. Distinct types per machine so a tile state can never be fed to
+// the patch machine by accident.
+namespace tag {
+struct TileMissing {}; struct TileRastering {}; struct TileLanded {}; struct TileReady {};
+struct PatchNone {}; struct PatchPending {}; struct PatchInFlight {}; struct PatchLanded {};
+struct GridPrimary {}; struct GridPersistent {}; struct GridTransient {}; struct GridDropped {};
+struct JobQueued {}; struct JobRunning {}; struct JobFinished {}; struct JobCancelled {}; struct JobFailed {};
+struct PhaseIdle {}; struct PhaseInPass {}; struct PhaseInComposite {};
+}
+
+// Section 2.2, "Transitions". Dirty rects are deliberately absent: they never
+// change a tile's state (R10), they drive the patch machine below.
+struct Tile {
+    auto operator()() const noexcept
+    {
+        using namespace sml;
+        return make_transition_table(
+            *state<tag::TileMissing>   + event<ev::tile::Requested>      = state<tag::TileRastering>,
+             state<tag::TileRastering> + event<ev::tile::ReplayFinished> = state<tag::TileLanded>,
+             state<tag::TileRastering> + event<ev::tile::ReplayFailed>   = state<tag::TileMissing>,
+             state<tag::TileRastering> + event<ev::tile::Cancelled>      = state<tag::TileMissing>,
+             state<tag::TileLanded>    + event<ev::tile::Uploaded>       = state<tag::TileReady>,
+             state<tag::TileLanded>    + event<ev::tile::Cancelled>      = state<tag::TileMissing>,
+             state<tag::TileReady>     + event<ev::tile::TextureLost>    = state<tag::TileMissing>,
+             state<tag::TileMissing>   + event<ev::tile::Removed>        = X,
+             state<tag::TileRastering> + event<ev::tile::Removed>        = X,
+             state<tag::TileLanded>    + event<ev::tile::Removed>        = X,
+             state<tag::TileReady>     + event<ev::tile::Removed>        = X
+        );
+    }
+};
+
+// Section 2.2, "Patch". A Ready tile keeps drawing throughout; at most one
+// patch job is in flight (R10, I12).
+struct Patch {
+    auto operator()() const noexcept
+    {
+        using namespace sml;
+        return make_transition_table(
+            *state<tag::PatchNone>     + event<ev::tile::Dirtied>        = state<tag::PatchPending>,
+             state<tag::PatchPending>  + event<ev::tile::Dirtied>        = state<tag::PatchPending>,
+             state<tag::PatchPending>  + event<ev::tile::Requested>      = state<tag::PatchInFlight>,
+             state<tag::PatchPending>  + event<ev::tile::Cancelled>      = state<tag::PatchNone>,
+             state<tag::PatchInFlight> + event<ev::tile::Dirtied>        = state<tag::PatchInFlight>,
+             state<tag::PatchInFlight> + event<ev::tile::ReplayFinished> = state<tag::PatchLanded>,
+             state<tag::PatchInFlight> + event<ev::tile::ReplayFailed>   = state<tag::PatchPending>,
+             state<tag::PatchInFlight> + event<ev::tile::Cancelled>      = state<tag::PatchNone>,
+             state<tag::PatchLanded>   + event<ev::tile::Dirtied>        = state<tag::PatchLanded>,
+             state<tag::PatchLanded>   + event<ev::tile::Uploaded>       = state<tag::PatchNone>,
+             state<tag::PatchLanded>   + event<ev::tile::Cancelled>      = state<tag::PatchNone>,
+             state<tag::PatchNone>     + event<ev::tile::Cancelled>      = state<tag::PatchNone>,
+             state<tag::PatchNone>     + event<ev::tile::Removed>        = X,
+             state<tag::PatchPending>  + event<ev::tile::Removed>        = X,
+             state<tag::PatchInFlight> + event<ev::tile::Removed>        = X,
+             state<tag::PatchLanded>   + event<ev::tile::Removed>        = X
+        );
+    }
+};
+
+// Section 2.2b, "Grid machine": R7 and R9 as a table. The guards are the K/N
+// bounds of R9 and the "a persistent backdrop is alive" condition of R7.
+struct Grid {
+    auto operator()() const noexcept
+    {
+        using namespace sml;
+        const auto persistentAlive = [](const ev::grid::ScaleChanged& e) { return e.persistentAlive; };
+        const auto noPersistent    = [](const ev::grid::ScaleChanged& e) { return !e.persistentAlive; };
+        const auto coveredForK     = [](const ev::grid::Covered& e) { return e.run >= e.k; };
+        const auto agedOutAtN      = [](const ev::grid::Aged& e) { return e.age >= e.n; };
+
+        return make_transition_table(
+            *state<tag::GridPrimary>    + event<ev::grid::ScaleLeaves1>                       = state<tag::GridPersistent>,
+             state<tag::GridPrimary>    + event<ev::grid::BoundsChanged>                      = state<tag::GridPrimary>,
+             state<tag::GridPrimary>    + event<ev::grid::ScaleChanged> [noPersistent]        = state<tag::GridTransient>,
+             state<tag::GridPrimary>    + event<ev::grid::ScaleChanged> [persistentAlive]     = state<tag::GridDropped>,
+             state<tag::GridPersistent> + event<ev::grid::ScaleReturnsTo1>                    = state<tag::GridPrimary>,
+             state<tag::GridPersistent> + event<ev::grid::BoundsChanged>                      = state<tag::GridPersistent>,
+             state<tag::GridPersistent> + event<ev::grid::ScaleChanged>                       = state<tag::GridPersistent>,
+             state<tag::GridTransient>  + event<ev::grid::Covered> [coveredForK]              = state<tag::GridDropped>,
+             state<tag::GridTransient>  + event<ev::grid::Covered>                            = state<tag::GridTransient>,
+             state<tag::GridTransient>  + event<ev::grid::Aged> [agedOutAtN]                  = state<tag::GridDropped>,
+             state<tag::GridTransient>  + event<ev::grid::Aged>                               = state<tag::GridTransient>,
+             state<tag::GridTransient>  + event<ev::grid::BoundsChanged>                      = state<tag::GridDropped>,
+             state<tag::GridTransient>  + event<ev::grid::ScaleChanged>                       = state<tag::GridDropped>
+        );
+    }
+};
+
+// Section 2.2b, "Replay job machine".
+struct Job {
+    auto operator()() const noexcept
+    {
+        using namespace sml;
+        return make_transition_table(
+            *state<tag::JobQueued>  + event<ev::job::Started>   = state<tag::JobRunning>,
+             state<tag::JobQueued>  + event<ev::job::Cancelled> = state<tag::JobCancelled>,
+             state<tag::JobRunning> + event<ev::job::Finished>  = state<tag::JobFinished>,
+             state<tag::JobRunning> + event<ev::job::Cancelled> = state<tag::JobCancelled>,
+             state<tag::JobRunning> + event<ev::job::Failed>    = state<tag::JobFailed>,
+             state<tag::JobRunning> + event<ev::job::Watchdog>  = state<tag::JobFailed>
+        );
+    }
+};
+
+// Section 2.2b, "Store phase machine". Upload is legal only in a composite,
+// Request only in a pass, SetScale/SetVisible only between the two (I17).
+struct Phase {
+    auto operator()() const noexcept
+    {
+        using namespace sml;
+        return make_transition_table(
+            *state<tag::PhaseIdle>        + event<ev::phase::SetScale>       = state<tag::PhaseIdle>,
+             state<tag::PhaseIdle>        + event<ev::phase::SetVisible>     = state<tag::PhaseIdle>,
+             state<tag::PhaseIdle>        + event<ev::phase::BeginPass>      = state<tag::PhaseInPass>,
+             state<tag::PhaseInPass>      + event<ev::phase::Request>        = state<tag::PhaseInPass>,
+             state<tag::PhaseInPass>      + event<ev::phase::EndPass>        = state<tag::PhaseIdle>,
+             state<tag::PhaseIdle>        + event<ev::phase::BeginComposite> = state<tag::PhaseInComposite>,
+             state<tag::PhaseInComposite> + event<ev::phase::Upload>         = state<tag::PhaseInComposite>,
+             state<tag::PhaseInComposite> + event<ev::phase::EndComposite>   = state<tag::PhaseIdle>
+        );
+    }
+};
