+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR
+ * A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
+ * HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// Apotheosis: the store core of TileGrid v2
+// (docs/TILEGRID-DESIGN.md section 5.1, "TextureMapperTileGridCore").
+//
+// The model (TextureMapperTileGridModel) answers "which tile should exist,
+// what may it draw, when is it dropped". The core is everything between that
+// answer and a backend: it owns the model, keeps the pass/composite protocol of
+// section 2.2b, turns PassOutput::paints into raster jobs in priority order,
+// applies cancels and released textures, maps the model's TextureIds onto the
+// texture backend's handles, and turns the model's DrawList into a flat list of
+// DrawCommands (backdrop clips + tile draws).
+//
+// Like the model it is WebCore-free - C++17 standard library only, and no
+// Boost.SML in this header - so the host tests in
+// Project-Apotheosis/tests/tilegrid build it with MSVC x64 against fake
+// backends and assert on the PC what the device would otherwise have to show.
+//
+// Package 2's WebCore adapter (TextureMapperTileGridStore) is then pure
+// translation and nothing else: implement RasterBackend with the cairo replay /
+// worker pool, TextureBackend with the BitmapTexture pool, and replay the
+// DrawCommands as TextureMapper beginClip / drawTexture / endClip. Every
+// decision about which pixels reach the screen has already been made here.
+//
+// Two properties the tests rely on:
+//   * the backends' events reach the model at exactly two points, the start of
+//     a pass and the start of a composite (I17). Whatever the workers do in
+//     between, the model is deterministic on the engine thread.
+//   * there is exactly one raster path (R3/R5): a Sync request is posted into
+//     the same priority queue as an Async one and then waited for, so the
+//     visible cells of a scale commit replay on every worker in parallel
+//     instead of one after the other.
+
+#pragma once
+
+#include "TextureMapperTileGridModel.h"
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <vector>
+
+namespace WebCore {
+namespace TileGrid {
+
+// ---------------------------------------------------------------------------
+// Backend handles. Opaque to the core: it never dereferences either, it only
+// keeps the mapping from the model's ids to them.
+// ---------------------------------------------------------------------------
+
+using JobHandle = std::uint32_t;
+using TextureHandle = std::uint32_t;
+
+constexpr JobHandle invalidJobHandle = 0;
+constexpr TextureHandle invalidTextureHandle = 0;
+
+// What a replay produced. `data` is whatever the raster backend wants it to be
+// (package 2: the cairo surface the display list was replayed into; the host
+// tests: nothing, with `signature` naming the pixels instead). `rect` and
+// `scale` are what the job was recorded for and travel with the buffer so the
+// texture backend can check them against the texture it uploads into.
+struct PixelBuffer {
+    const void* data { nullptr };
+    IntRect rect;
+    float scale { 1.0f };
+    std::uint64_t signature { 0 };
+    // The job that produced `data`. `data` is owned by the backend, so a backend
+    // that keeps its landed buffers in a map can check that the buffer it is
+    // asked to upload is still the one it holds instead of dereferencing what
+    // the core happens to remember (device round 1).
+    JobHandle job { invalidJobHandle };
+};
+
+enum class RasterEventKind : unsigned char {
+    Started,        // a worker picked the job up
+    Finished,       // pixels are in `pixels`
+    Failed,         // the replay failed; R5: the cell is Missing again
+    Watchdog        // the pool's watchdog fired; reported as ReplayFailed (R5)
+};
+
+struct RasterEvent {
+    RasterEventKind kind { RasterEventKind::Finished };
+    JobHandle job { invalidJobHandle };
+    PixelBuffer pixels;
+};
+
+// The raster side: record a display list for one cell rect and replay it on a
+// worker. The core never blocks on this except for the Sync jobs of R3, and
+// then on all of them at once.
+class RasterBackend {
+public:
+    virtual ~RasterBackend() = default;
+
+    // Records the job and queues it. Returns invalidJobHandle if the backend
+    // refuses it; the core then leaves the tile Missing for the next pass
+    // (R5: no fallback to a synchronous paint).
+    virtual JobHandle record(GridId, CellIndex, const IntRect& rect, float scale, bool sync) = 0;
+
+    // R5: the cell left the desired set or its grid died. A completion that
+    // arrives anyway is discarded by the model.
+    virtual void cancel(JobHandle) = 0;
+
+    // R3: blocks until every named job is Finished, Failed or Cancelled - all
+    // of them together, so n cells on w workers cost ceil(n / w) replay
+    // latencies, not n. A backend that cannot complete them gives up; the core
+    // has no timeout of its own (R5) and the cells stay Missing.
+    virtual void waitFor(const std::vector<JobHandle>&) = 0;
+
+    // Everything that happened since the last call, in job order. Called by the
+    // core at exactly BeginPass and BeginComposite (I17).
+    virtual std::vector<RasterEvent> poll() = 0;
+
+    // clamp(cores - 2, 2, 4) on the device; 0 = replay inline on the engine
+    // thread, which is what an image pass and a build without Cairo do.
+    virtual unsigned workerCount() const = 0;
+};
+
+// The texture side. GL is current only inside a composite, which is why R4's
+// uploads happen there and nowhere else.
+class TextureBackend {
+public:
+    virtual ~TextureBackend() = default;
+
+    virtual TextureHandle acquire(IntSize) = 0;
+    // false = the pixels did not reach the texture. The core reports that as
+    // UploadFailed; a backend must never return without uploading and without
+    // saying so (device round 2).
+    virtual bool upload(TextureHandle, const PixelBuffer&, const IntRect&) = 0;
+    virtual void release(TextureHandle) = 0;
+
+    // Called by the core at the start of every composite: package 2 resets the
+    // per-composite upload budget and its wall clock here.
+    virtual void beginComposite() { }
+
+    // R4: how many *budgeted* uploads are still allowed in this composite. The
+    // wall-clock cut-off (12 ms today) lives behind this number, in the real
+    // backend; the core only passes it to the model, which spends it on the
+    // tiles outside V and lets the visible ones through regardless.
+    virtual unsigned uploadsRemainingThisComposite() const = 0;
+
+    // Textures the pool took back on its own. The core turns each one into the
+    // model's TextureLost for the tile that held it (Ready -> Missing).
+    virtual std::vector<TextureHandle> takeReclaimedTextures() { return { }; }
+};
+
+// ---------------------------------------------------------------------------
+// What one composite draws (R8). A flat list, in order: every visible pixel is
+// covered by at most one DrawTile, and a backdrop tile is only ever drawn
+// inside the BeginClip/EndClip pair of a primary cell that has no Ready tile.
+// ---------------------------------------------------------------------------
+
+enum class DrawOp : unsigned char { BeginClip, DrawTile, EndClip };
+
+struct DrawCommand {
+    DrawOp op { DrawOp::DrawTile };
+    IntRect rect;                              // clip rect, or the tile's target rect
+    TextureHandle texture { invalidTextureHandle };
+    GridId grid { invalidGridId };
+    CellIndex cell;
+    float scale { 1.0f };                      // the scale the pixels were rasterised at
+    bool backdrop { false };
+    // This texture was acquired in this very composite, i.e. the tile is drawing
+    // pixels that arrived a moment ago. The adapter traces those draws (section
+    // 5.3, `draw` line): they are the ones that can be wrong without any counter
+    // noticing, because the model's bookkeeping is complete before the pixels
+    // exist.
+    bool freshTexture { false };
+    IntRect paintedRect;                       // R6/I4: what the pixels were rasterised for
+};
+
+struct CompositeResult {
+    std::vector<DrawCommand> commands;
+    unsigned visibleCells { 0 };
+    unsigned visibleHoles { 0 };               // the only number the driver reacts to
+    unsigned backdropClips { 0 };
+    unsigned uploads { 0 };
+    unsigned uploadsBudgetExempt { 0 };        // R4: cells in V, uploaded whatever the budget
+    unsigned uploadsDeferred { 0 };            // Landed, waiting for a later composite (R4)
+    unsigned texturesAcquired { 0 };
+    unsigned texturesReleased { 0 };
+    // Both must be zero. An upload the model committed to that could not be
+    // performed, and a Ready tile with no texture handle behind it: the two ways
+    // a cell can be white while the model reports no hole (device round 1). Each
+    // one is reported to the model as UploadFailed, so the tile is Missing again
+    // and R3 repaints it - but the counters say it happened.
+    unsigned uploadsFailed { 0 };
+    unsigned drawsWithoutTexture { 0 };
+};
+
+// ---------------------------------------------------------------------------
+// Configuration
+// ---------------------------------------------------------------------------
+
+struct CoreConfig {
+    ModelConfig model;
+
+    // R4: the ceiling the core offers the model for *budgeted* (non-visible)
+    // uploads. The effective number is the smaller of this and what the texture
+    // backend still allows in this composite.
+    unsigned maxUploadsPerComposite { 2 };
+};
+
+// ---------------------------------------------------------------------------
+// The core
+// ---------------------------------------------------------------------------
+
+class TileGridCore {
+public:
+    TileGridCore(unsigned storeId, RasterBackend&, TextureBackend&, const CoreConfig& = CoreConfig());
+    ~TileGridCore();
+
+    TileGridCore(const TileGridCore&) = delete;
+    TileGridCore& operator=(const TileGridCore&) = delete;
+
+    // --- inputs (section 2.2b: legal only between a pass and a composite) ---
+    void setBounds(IntSize);
+    void setScale(float);
+    void setVisibleRect(const std::optional<IntRect>&);
+    void setTileBudget(unsigned);
+    void setImageStore(bool);
+    void setThreadedRaster(bool);
+    void setPanGesture(bool);
+
+    // R10: accumulated until the next pass consumes it. Never cancels a job,
+    // never adds or removes a tile.
+    void invalidate(const IntRect&);
+
+    // --- the protocol ------------------------------------------------------
+
+    // BeginPass: drain the backends into the model's inbox, run the model's
+    // pass, then cancel what it cancelled, release what it released, and post
+    // its paints as jobs in priority order. If the pass marked any of them
+    // Sync, waits for all of those together before returning (R3).
+    PassOutput runPass();
+
+    // BeginComposite: drain the backends again, let the model upload within the
+    // budget (R4) and build its DrawList (R8), and translate that into
+    // DrawCommands with backend handles.
+    CompositeResult composite();
+
+    bool wantsPass() const;                    // R12
+    unsigned visibleHoles() const;
+
+    // --- inspection (tests, package 2's diagnostics) -----------------------
+    const TileGridModel& model() const;
+    TileGridModel& model();
+    void setIllegalArrowObserver(IllegalArrowObserver);
+
+    const PassInput& lastPassInput() const;
+    IntRect compositeVisibleRect() const;      // V, or all of B when V is unknown
+    unsigned outstandingJobs() const;          // posted, not yet terminal
+    unsigned pendingPixelBuffers() const;      // landed, not yet uploaded
+    unsigned liveTextures() const;
+    TextureHandle handleFor(TextureId) const;
+    unsigned lastSyncJobCount() const;
+    // Cumulative, for the store's diagnostics line and the host tests: both are
+    // supposed to stay at zero.
+    unsigned refusedRequests() const;
+    unsigned failedUploads() const;
+
+private:
+    class Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace TileGrid
+} // namespace WebCore
