+
+// Apotheosis: the WebCore adapter of TileGrid v2
+// (docs/TILEGRID-DESIGN.md section 5.1, "TextureMapperTileGridStore").
+//
+// It is translation and nothing else. Every decision about which tile exists,
+// what it may draw and when it is dropped was made in TextureMapperTileGridModel
+// and TextureMapperTileGridCore, which are WebCore-free and asserted on the PC by
+// Project-Apotheosis/tests/tilegrid before an engine is built. What is left here:
+//
+//   * WebCore geometry in, model geometry out (FloatRect/FloatSize <-> the
+//     model's own IntRect/IntSize; the model works in scaled layer coordinates,
+//     which is what GraphicsLayerTextureMapper already hands a store);
+//   * RasterBackend = the Cairo record / WorkerPool replay / CoordinatedTileBuffer
+//     mechanics, and (package 4) the raster counters and the per-frame upload
+//     budget that used to live in TextureMapperTile.cpp, declared in
+//     TextureMapperTiledStore.h and defined at the top of the .cpp, so perf.csv
+//     and the driver's tick wake-up contract keep working unchanged;
+//   * TextureBackend = BitmapTexture from BitmapTexturePool;
+//   * DrawCommands -> TextureMapper beginClip / drawTexture / endClip, with
+//     device-pixel snapped tile edges (seams at a non-integer scale).
+//
+// Package 4: image stores use this class too. Their source is a decoded frame instead of a render
+// tree and is recorded by beginImagePass() / record() in the .cpp; everything else - lattice,
+// budget, upload, draw list - is the same model.
+//
+// WK_WINUWP only - it is compiled from PlatformWinUWP.cmake and nothing else
+// includes it.
+
+#pragma once
+
+#if defined(WK_WINUWP)
+
+#include "TextureMapperTiledStore.h"
+#include <memory>
+#include <wtf/RefPtr.h>
+
+namespace WebCore {
+
+class Image;
+
+class TextureMapperTileGridStore final : public TextureMapperTiledStore {
+public:
+    static Ref<TextureMapperTileGridStore> create() { return adoptRef(*new TextureMapperTileGridStore); }
+    virtual ~TextureMapperTileGridStore();
+
+    // TextureMapperBackingStore
+    void paintToTextureMapper(TextureMapper&, const FloatRect&, const TransformationMatrix&, float) override;
+    void drawBorder(TextureMapper&, const Color&, float borderWidth, const FloatRect&, const TransformationMatrix&) override;
+    void drawRepaintCounter(TextureMapper&, int repaintCount, const Color&, const FloatRect&, const TransformationMatrix&) override;
+
+    // TextureMapperTiledStore
+    void setContentsToImage(Image*) override;
+    void updateContentsScale(float) override;
+    void updateContents(TextureMapper&, Image*, const FloatSize&, const IntRect&) override;
+    void updateContents(TextureMapper&, GraphicsLayer*, const FloatSize&, const IntRect&) override;
+    void wkSetPageScale(float) override;
+    void wkSetVisibleRect(const FloatRect&) override;
+    void wkFinishPendingPaints() override;
+    bool wantsPass() const override;
+    unsigned visibleHoles() const override;
+    size_t wkAppendDiagnostics(char* buffer, size_t length) const override;
+
+    // Apotheosis: the driver's pan level (section 3). Recorded in the trace and
+    // reserved for R11-style idle work; it does not gate the cover margin.
+    void wkSetPanGesture(bool);
+
+private:
+    TextureMapperTileGridStore();
+
+    // Apotheosis (package 4): an image store is never walked by
+    // GraphicsLayerTextureMapper::updateBackingStoreIfNeeded() - the layer that owns it draws no
+    // content of its own - so its pass runs at the start of the composite and its source is
+    // released at the end of it, once the model owes nothing. Both are no-ops for a layer store.
+    void updateContentsFromImageIfNeeded(TextureMapper&);
+    void releaseImageIfPainted();
+
+    class Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace WebCore
+
+#endif // defined(WK_WINUWP)
