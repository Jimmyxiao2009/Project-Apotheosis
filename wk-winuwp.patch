+// Apotheosis: the pure tile grid model of TileGrid v2
+// (docs/TILEGRID-DESIGN.md sections 2.3 - 2.6, rules R1 - R12).
+//
+// One pass in, one pass out: PassInput -> PassOutput. One composite in, one
+// DrawList out. Nothing else enters the model, nothing else leaves it. The
+// store around it (package 2) owns pixels, textures, threads and the clock;
+// the model owns the answer to "which tile should exist, what may it draw, and
+// when is it dropped", which is the question v1 had no single place for.
+//
+// The model is deliberately WebCore-free: only the C++17 standard library.
+// It builds and runs on the PC in Project-Apotheosis/tests/tilegrid/, where
+// every rule and every invariant of section 4 is asserted before an engine is
+// built. It therefore brings its own tiny IntSize/IntRect/CellIndex instead of
+// WebCore's; package 2 converts at the boundary.
+//
+// Two properties the tests depend on, and the reason the model is written this
+// way at all:
+//   * no time. Nothing ages in milliseconds, nothing times out. Lifetimes are
+//     counted in passes and composites (R5, R9).
+//   * no pointers as identity. Tiles are addressed by (column, row) on a
+//     lattice anchored at the layer origin, grids/jobs/textures by increasing
+//     integer ids, and every container iterates in a defined order, so the same
+//     input sequence always produces the same output sequence (I14).
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace WebCore {
+namespace TileGrid {
+
+// ---------------------------------------------------------------------------
+// Geometry (own, so the model builds without WebCore)
+// ---------------------------------------------------------------------------
+
+struct IntSize {
+    int width { 0 };
+    int height { 0 };
+
+    constexpr IntSize() = default;
+    constexpr IntSize(int w, int h) : width(w), height(h) { }
+    constexpr bool isEmpty() const { return width <= 0 || height <= 0; }
+};
+
+inline constexpr bool operator==(IntSize a, IntSize b) { return a.width == b.width && a.height == b.height; }
+inline constexpr bool operator!=(IntSize a, IntSize b) { return !(a == b); }
+
+struct IntPoint {
+    int x { 0 };
+    int y { 0 };
+
+    constexpr IntPoint() = default;
+    constexpr IntPoint(int px, int py) : x(px), y(py) { }
+};
+
+inline constexpr bool operator==(IntPoint a, IntPoint b) { return a.x == b.x && a.y == b.y; }
+inline constexpr bool operator!=(IntPoint a, IntPoint b) { return !(a == b); }
+
+// Note for the review checklist of section 6: rect *equality* is never used to
+// decide which tile is which - that was root cause 1 of the rewrite. IntRect
+// has no operator==; the model compares indices and sizes.
+struct IntRect {
+    int x { 0 };
+    int y { 0 };
+    int width { 0 };
+    int height { 0 };
+
+    constexpr IntRect() = default;
+    constexpr IntRect(int px, int py, int w, int h) : x(px), y(py), width(w), height(h) { }
+
+    constexpr int maxX() const { return x + width; }
+    constexpr int maxY() const { return y + height; }
+    constexpr bool isEmpty() const { return width <= 0 || height <= 0; }
+    constexpr IntSize size() const { return IntSize(width, height); }
+    constexpr IntPoint location() const { return IntPoint(x, y); }
+    constexpr IntPoint center() const { return IntPoint(x + width / 2, y + height / 2); }
+
+    bool intersects(const IntRect&) const;
+    bool contains(const IntRect&) const;
+    bool containsPoint(IntPoint) const;
+    IntRect intersection(const IntRect&) const;
+    IntRect unite(const IntRect&) const;
+    IntRect inflated(int left, int top, int right, int bottom) const;
+    bool isSameGeometry(const IntRect&) const; // tests and diagnostics only
+};
+
+struct CellIndex {
+    int column { 0 };
+    int row { 0 };
+
+    constexpr CellIndex() = default;
+    constexpr CellIndex(int c, int r) : column(c), row(r) { }
+};
+
+inline constexpr bool operator==(CellIndex a, CellIndex b) { return a.column == b.column && a.row == b.row; }
+inline constexpr bool operator!=(CellIndex a, CellIndex b) { return !(a == b); }
+// Row-major: the iteration order of every grid, and with it of every output
+// vector, is fixed by this (I14).
+inline constexpr bool operator<(CellIndex a, CellIndex b)
+{
+    return a.row != b.row ? a.row < b.row : a.column < b.column;
+}
+
+// ---------------------------------------------------------------------------
+// Identities. Increasing integers, never reused, never an address (I14).
+// ---------------------------------------------------------------------------
+
+using GridId = std::uint32_t;
+using JobId = std::uint32_t;
+using TextureId = std::uint32_t;
+
+constexpr GridId invalidGridId = 0;
+constexpr JobId invalidJobId = 0;
+constexpr TextureId invalidTextureId = 0;
+
+// ---------------------------------------------------------------------------
+// States (section 2.2 / 2.2b). The tables live in
+// TextureMapperTileGridMachines.h, which includes this header; the enums live
+// here so that the model's public API needs no Boost.SML.
+// ---------------------------------------------------------------------------
+
+enum class TileState : unsigned char { Missing, Rastering, Landed, Ready, Gone };
+enum class PatchState : unsigned char { None, Pending, InFlight, Landed, Gone };
+enum class GridState : unsigned char { Primary, PersistentBackdrop, TransientBackdrop, Dropped };
+enum class JobState : unsigned char { Queued, Running, Finished, Cancelled, Failed };
+enum class PhaseState : unsigned char { Idle, InPass, InComposite };
+
+enum class MachineKind : unsigned char { Tile, Patch, Grid, Job, Phase };
+
+const char* machineKindName(MachineKind);
+const char* tileStateName(TileState);
+const char* patchStateName(PatchState);
+const char* gridStateName(GridState);
+const char* jobStateName(JobState);
+const char* phaseStateName(PhaseState);
+
+// An event no row of a table accepts. `to` does not exist by construction, so
+// the trace line of section 5.3 prints <machine>:<from>-><event>.
+struct IllegalArrow {
+    MachineKind machine { MachineKind::Tile };
+    const char* from { "" };
+    const char* event { "" };
+    GridId grid { invalidGridId };
+    CellIndex cell {};
+};
+
+using IllegalArrowObserver = std::function<void(const IllegalArrow&)>;
+
+std::string formatIllegalArrow(unsigned storeId, const IllegalArrow&);
+
+// ---------------------------------------------------------------------------
+// Constants (section 2.6)
+// ---------------------------------------------------------------------------
+
+namespace constants {
+constexpr int tileEdge = 1024;                      // T
+constexpr unsigned defaultTileBudget = 24;          // budget
+constexpr unsigned persistentBackdropBudget = 8;    // P
+constexpr bool syncOnScaleCommit = true;
+constexpr unsigned backdropCoverageComposites = 2;  // K
+constexpr unsigned backdropMaxComposites = 60;      // N
+constexpr int smallStoreEdge = 1024;                // "small store": both edges <= this
+constexpr int marginDivisorAtScale1 = 2;            // M = 1/2 V per side at scale 1
+constexpr int marginDivisorZoomed = 4;              // M = 1/4 V per side when zoomed
+constexpr int panSideMarginFactor = 2;              // doubled on the pan side
+constexpr unsigned persistentBackdropMarginCells = 1;
+constexpr unsigned cancelledJobRetentionPasses = 4; // GC bound, counted in passes, not time
+}
+
+// Everything a test may want to vary. The device ships the defaults.
+struct ModelConfig {
+    int tileEdge { constants::tileEdge };
+    unsigned persistentBackdropBudget { constants::persistentBackdropBudget };
+    bool syncOnScaleCommit { constants::syncOnScaleCommit };
+    unsigned backdropCoverageComposites { constants::backdropCoverageComposites };
+    unsigned backdropMaxComposites { constants::backdropMaxComposites };
+    int smallStoreEdge { constants::smallStoreEdge };
+};
+
+// ---------------------------------------------------------------------------
+// Pass input / output (sections 2.3, 2.5)
+// ---------------------------------------------------------------------------
+
+struct PassInput {
+    IntSize boundsScaled;                  // B, origin is always (0, 0)
+    float scale { 1.0f };                  // s
+    std::optional<IntRect> visible;        // V, empty optional = unknown
+    IntRect dirty;                         // may be empty
+    unsigned tileBudget { constants::defaultTileBudget };
+    bool isImage { false };
+    bool threadedRaster { true };
+    // Recorded in the trace and reserved for R11-style idle work. It does NOT
+    // gate the pan-side margin: the model derives the pan direction from
+    // consecutive visible rects itself (section 3, R1).
+    bool panGesture { false };
+};
+
+enum class PaintMode : unsigned char { Sync, Async };
+
+struct PaintRequest {
+    GridId grid { invalidGridId };
+    CellIndex cell {};
+    IntRect rect {};                       // whole cell for a first paint, dirty part for a patch
+    PaintMode mode { PaintMode::Async };
+    unsigned priority { 0 };               // 0 = served first
+    JobId job { invalidJobId };
+    bool isPatch { false };
+};
+
+struct PassOutput {
+    std::vector<PaintRequest> paints;      // already in priority order, primary first
+    std::vector<JobId> cancels;
+    std::vector<TextureId> released;
+    bool wantsPass { false };              // R12
+    unsigned visibleHoles { 0 };           // the only number the driver reacts to
+
+    // Counters for the `out` trace line of section 5.3.
+    unsigned missing { 0 };
+    unsigned rastering { 0 };
+    unsigned landed { 0 };
+    unsigned ready { 0 };
+    unsigned syncJobs { 0 };
+    unsigned asyncJobs { 0 };
+    unsigned removed { 0 };
+    // Refusals and failed uploads applied in this pass' drain (device round 1).
+    // Both are supposed to be zero; the `out` line carries them so a device log
+    // says whether the store is fighting its backend.
+    unsigned refused { 0 };
+    char backdropKind { '-' };             // 'p', 't' or '-'
+    unsigned backdropAge { 0 };
+};
+
+// ---------------------------------------------------------------------------
+// Composite output (R4, R8)
+// ---------------------------------------------------------------------------
+
+struct UploadRecord {
+    GridId grid { invalidGridId };
+    CellIndex cell {};
+    TextureId texture { invalidTextureId };
+    bool isPatch { false };
+    IntRect rect {};
+    bool budgetExempt { false };           // intersects V, uploaded regardless (R4)
+};
+
+struct TileDraw {
+    GridId grid { invalidGridId };
+    CellIndex cell {};
+    // R6/I4: the tile's paintedRect (mapped into the primary grid's coordinates
+    // for a backdrop tile), i.e. exactly the rect the texture was rasterised
+    // for. Never the current cell rect when the two differ.
+    IntRect target {};
+    TextureId texture { invalidTextureId };
+    float scale { 1.0f };                  // the scale the pixels were rasterised at
+};
+
+// One clip per primary cell that has no Ready tile (R8). Every visible pixel
+// comes from exactly one of {primary tile, backdrop clip, nothing}.
+struct BackdropClip {
+    CellIndex cell {};                     // the primary cell being filled
+    IntRect clip {};
+    std::vector<TileDraw> tiles;
+    bool fullyCovered { false };
+};
+
+struct DrawList {
+    std::vector<UploadRecord> uploads;     // performed by the model, drawn in this composite
+    std::vector<TileDraw> tiles;           // primary Ready tiles intersecting V
+    std::vector<BackdropClip> backdrop;
+    std::vector<TextureId> released;
+    std::vector<JobId> cancels;
+    unsigned visibleHoles { 0 };
+    unsigned visibleCells { 0 };
+};
+
+// ---------------------------------------------------------------------------
+// Event intake (section 2.2). Everything the store observes is one of these;
+// the model drains them at the start of a pass and at the start of a composite,
+// never in between (I17).
+// ---------------------------------------------------------------------------
+
+enum class EventKind : unsigned char {
+    Requested,        // issued by the model itself; from outside it is an illegal arrow
+    ReplayStarted,
+    ReplayFinished,
+    ReplayFailed,
+    Uploaded,
+    TextureLost,
+    Cancelled,
+    Dirtied,
+    Removed,
+    Watchdog,         // the pool's watchdog: reported as ReplayFailed (R5)
+    // Apotheosis (device round 1, 0.1.9.29): the two ways the store can fail to
+    // carry out something the model already committed to. Both used to be a
+    // silent `continue` in the core, and both left the model believing a lie -
+    // R5's "a Rastering tile leaves only via ReplayFinished/ReplayFailed/
+    // Cancelled" was violated by the first and I5's "a Ready tile draws its
+    // texture" by the second. They are ordinary events now, so the machines
+    // decide what happens and a test can assert it.
+    RequestRefused,   // the raster backend would not take the job: ReplayFailed (R5)
+    UploadFailed      // the pixels never reached a texture: TextureLost (R4/I4)
+};
+
+struct TileEventRecord {
+    EventKind kind { EventKind::Dirtied };
+    JobId job { invalidJobId };
+    GridId grid { invalidGridId };
+    CellIndex cell {};
+    IntRect rect {};
+};
+
+// ---------------------------------------------------------------------------
+// Inspection (tests, diagnostics). Read-only views, never a way in.
+// ---------------------------------------------------------------------------
+
+struct TileInfo {
+    GridId grid { invalidGridId };
+    GridState gridState { GridState::Primary };
+    float gridScale { 1.0f };
+    CellIndex cell {};
+    IntRect rect {};
+    TileState state { TileState::Missing };
+    PatchState patch { PatchState::None };
+    TextureId texture { invalidTextureId };
+    // R6: the rect the texture's pixels were rasterised for. Same origin as the
+    // cell rect and never larger than one lattice cell, but not necessarily the
+    // *current* cell rect - a partial edge cell that changed size keeps drawing
+    // what it has until the whole-cell patch lands. I4 is
+    // "textureSize == paintedRect.size()"; a texture is never stretched over a
+    // rect it was not rasterised for.
+    IntRect paintedRect {};
+    IntSize textureSize {};
+    float textureScale { 0.0f };
+    JobId job { invalidJobId };
+    JobId patchJob { invalidJobId };
+    IntRect patchPending {};
+    IntRect patchInFlight {};
+    bool desired { false };
+};
+
+struct GridInfo {
+    GridId id { invalidGridId };
+    GridState state { GridState::Primary };
+    float scale { 1.0f };
+    IntSize bounds {};
+    unsigned budget { 0 };
+    unsigned age { 0 };
+    unsigned coveredRun { 0 };
+    unsigned tileCount { 0 };
+    unsigned desiredCount { 0 };
+};
+
+struct JobInfo {
+    JobId id { invalidJobId };
+    JobState state { JobState::Queued };
+    GridId grid { invalidGridId };
+    CellIndex cell {};
+    IntRect rect {};
+    bool isPatch { false };
+    unsigned priority { 0 };
+};
+
+// ---------------------------------------------------------------------------
+// The model
+// ---------------------------------------------------------------------------
+
+class TileGridModel {
+public:
+    explicit TileGridModel(unsigned storeId = 1, const ModelConfig& = ModelConfig());
+    ~TileGridModel();
+
+    TileGridModel(const TileGridModel&) = delete;
+    TileGridModel& operator=(const TileGridModel&) = delete;
+
+    unsigned storeId() const;
+    const ModelConfig& config() const;
+
+    // I16: every refused arrow of every machine reaches this.
+    void setIllegalArrowObserver(IllegalArrowObserver);
+
+    // One pass (R1 - R3, R6, R7, R10, R12).
+    PassOutput runPass(const PassInput&);
+
+    // One composite (R4, R8, R9). Uploads the tiles it returns in
+    // DrawList::uploads, so they can be drawn in the same frame.
+    DrawList composite(const IntRect& visible, unsigned maxUploads);
+
+    bool wantsPass() const;         // R12
+    unsigned visibleHoles() const;  // cells in V drawing nothing at all
+
+    // Intake. Queued; applied at the next BeginPass / BeginComposite.
+    void noteEvent(const TileEventRecord&);
+    void noteReplayStarted(JobId);
+    void noteReplayFinished(JobId);
+    void noteReplayFailed(JobId);
+    void noteWatchdog(JobId);
+    void noteCancelled(JobId);
+    void noteUploaded(JobId);
+    // R5: the backend refused the job the model just handed it. The tile goes
+    // back to Missing (a patch back to Pending, rect intact) and the next pass
+    // asks again - it never stays in Rastering with no job behind it.
+    void noteRequestRefused(JobId);
+    // R4/I4: the model committed the upload (the tile is Ready with a fresh
+    // TextureId) but the store could not perform it - no texture, no buffer, or
+    // no handle at draw time. Ready without pixels is exactly the white cell the
+    // hole count cannot see, so it is undone: TextureLost -> Missing.
+    void noteUploadFailed(GridId, CellIndex);
+    void noteTextureLost(GridId, CellIndex);
+    void noteDirtied(const IntRect&);
+    void noteRemoved(GridId, CellIndex);
+
+    // Trace, section 5.3. Exactly the three line shapes, nothing else.
+    std::string tracePass(const PassInput&) const;
+    std::string traceOut(const PassOutput&) const;
+    std::string traceComposite(const DrawList&) const;
+
+    // Inspection.
+    std::vector<TileInfo> tiles() const;
+    std::vector<JobInfo> jobs() const;
+    std::optional<GridInfo> primaryGrid() const;
+    std::optional<GridInfo> backdropGrid() const;
+    PhaseState phase() const;
+    std::optional<IntRect> lastVisible() const;
+    IntSize bounds() const;
+    float scale() const;
+    unsigned passCount() const;
+    unsigned compositeCount() const;
+    unsigned illegalArrowCount() const;
+
+    // Geometry helpers, shared with the tests so both sides agree on the
+    // lattice (I1).
+    IntRect cellRect(CellIndex, IntSize bounds) const;
+    std::vector<CellIndex> cellsOf(const IntRect&, IntSize bounds) const;
+
+private:
+    class Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace TileGrid
