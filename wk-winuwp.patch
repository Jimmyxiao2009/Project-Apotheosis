diff --git a/Source/JavaScriptCore/PlatformWinUWP.cmake b/Source/JavaScriptCore/PlatformWinUWP.cmake
new file mode 100644
index 0000000000..8916725825
--- /dev/null
+++ b/Source/JavaScriptCore/PlatformWinUWP.cmake
@@ -0,0 +1,19 @@
+# Apotheosis: JavaScriptCore sources for the WinUWP port (ARM32 App Container).
+#
+# Like Source/JavaScriptCore/PlatformWin.cmake but WITHOUT JSStringRefBSTR:
+# BSTR/oleauto (wtypes.h SysAllocString*) is not declared in the App Container
+# partition, and nothing in the port consumes that COM convenience API.
+# ENABLE_REMOTE_INSPECTOR is off for this port, so the socket inspector server
+# is not built and JSGlobalObjectInspectorController drops out.
+
+list(APPEND JavaScriptCore_PUBLIC_FRAMEWORK_HEADERS
+    API/JavaScriptCore.h
+)
+
+if (ENABLE_REMOTE_INSPECTOR)
+    include(inspector/remote/Socket.cmake)
+else ()
+    list(REMOVE_ITEM JavaScriptCore_SOURCES
+        inspector/JSGlobalObjectInspectorController.cpp
+    )
+endif ()
