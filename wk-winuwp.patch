+std::string formatIllegalArrow(unsigned storeId, const IllegalArrow& a)
+{
+    char buffer[160];
+    std::snprintf(buffer, sizeof(buffer), "tg S%u ev    %s:%s->%s", storeId, machineKindName(a.machine), a.from, a.event);
+    return std::string(buffer);
