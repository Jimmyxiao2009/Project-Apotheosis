+// ---------------------------------------------------------------------------
+// Trace, section 5.3. These three lines are the whole diagnostic surface: a
+// `pass` line is a complete PassInput, so a device session replays on the PC.
+// ---------------------------------------------------------------------------
+
+static std::string formatScale(float scale)
+{
+    char buffer[32];
+    std::snprintf(buffer, sizeof(buffer), "%g", static_cast<double>(scale));
+    return std::string(buffer);
+}
+
+static std::string formatRect(const IntRect& rect)
+{
+    char buffer[64];
+    std::snprintf(buffer, sizeof(buffer), "%d,%d,%d,%d", rect.x, rect.y, rect.width, rect.height);
+    return std::string(buffer);
+}
+
+std::string TileGridModel::tracePass(const PassInput& in) const
+{
+    char buffer[256];
+    // Apotheosis (0.1.9.34): `img` is last, so a parser written for the older line shape still
+    // reads the fields before it. It was missing, and the trace of an image store (V unknown,
+    // printed "-") was then indistinguishable from that of a layer store nobody handed a
+    // visible rect to - which cost a whole analysis round on the 0.1.9.34 session, where the
+    // stores that never came to rest turned out to be off-screen *layer* stores.
+    std::snprintf(buffer, sizeof(buffer), "tg S%u pass  s=%s B=%dx%d V=%s d=%s pan=%d budget=%u img=%d",
+        m_impl->m_storeId, formatScale(in.scale).c_str(), in.boundsScaled.width, in.boundsScaled.height,
+        in.visible ? formatRect(*in.visible).c_str() : "-", formatRect(in.dirty).c_str(),
+        in.panGesture ? 1 : 0, in.tileBudget, in.isImage ? 1 : 0);
+    return std::string(buffer);
+}
+
+std::string TileGridModel::traceOut(const PassOutput& out) const
+{
+    char backdrop[16];
+    if (out.backdropKind == '-')
+        std::snprintf(backdrop, sizeof(backdrop), "-");
+    else
+        std::snprintf(backdrop, sizeof(backdrop), "%c%u", out.backdropKind, out.backdropAge);
+
+    char buffer[256];
+    std::snprintf(buffer, sizeof(buffer),
+        "tg S%u out   miss=%u rast=%u land=%u ready=%u jobs=%u/%u cancel=%u rm=%u holes=%u bd=%s ref=%u",
+        m_impl->m_storeId, out.missing, out.rastering, out.landed, out.ready,
+        out.syncJobs, out.asyncJobs, static_cast<unsigned>(out.cancels.size()), out.removed,
+        out.visibleHoles, backdrop, out.refused);
+    return std::string(buffer);
+}
+
+std::string TileGridModel::traceComposite(const DrawList& draw) const
+{
+    char buffer[256];
+    std::snprintf(buffer, sizeof(buffer), "tg S%u comp  V=%s holes=%u bdclips=%u",
+        m_impl->m_storeId, m_impl->m_visible ? formatRect(*m_impl->m_visible).c_str() : "-",
+        draw.visibleHoles, static_cast<unsigned>(draw.backdrop.size()));
+    return std::string(buffer);
+}
+
+// ---------------------------------------------------------------------------
+// Inspection
+// ---------------------------------------------------------------------------
+
+std::vector<TileInfo> TileGridModel::tiles() const
+{
+    std::vector<TileInfo> result;
+    auto append = [&](const Impl::Grid* grid) {
+        if (!grid)
+            return;
+        std::map<CellIndex, bool> desired;
+        for (CellIndex cell : grid->desired)
+            desired[cell] = true;
+        for (const auto& entry : grid->tiles) {
+            TileInfo info;
+            info.grid = grid->id;
+            info.gridState = grid->machine.state();
+            info.gridScale = grid->scale;
+            info.cell = entry.first;
+            info.rect = m_impl->cellRect(entry.first, grid->bounds);
+            info.state = entry.second.machine.state();
+            info.patch = entry.second.patch.state();
+            info.texture = entry.second.texture;
+            info.paintedRect = entry.second.paintedRect;
+            info.textureSize = entry.second.textureSize;
+            info.textureScale = entry.second.textureScale;
+            info.job = entry.second.job;
+            info.patchJob = entry.second.patchJob;
+            info.patchPending = entry.second.patchPending;
+            info.patchInFlight = entry.second.patchInFlight;
+            info.desired = desired.count(entry.first) > 0;
+            result.push_back(info);
+        }
+    };
+    append(m_impl->m_primary.get());
+    append(m_impl->m_backdrop.get());
+    return result;
+}
+
+std::vector<JobInfo> TileGridModel::jobs() const
+{
+    std::vector<JobInfo> result;
+    for (const auto& entry : m_impl->m_jobs) {
+        JobInfo info;
+        info.id = entry.first;
+        info.state = entry.second.machine.state();
+        info.grid = entry.second.grid;
+        info.cell = entry.second.cell;
+        info.rect = entry.second.rect;
+        info.isPatch = entry.second.isPatch;
+        info.priority = entry.second.priority;
+        result.push_back(info);
+    }
+    return result;
+}
+
+std::optional<GridInfo> TileGridModel::primaryGrid() const
+{
+    if (!m_impl->m_primary)
+        return std::nullopt;
+    const Impl::Grid& grid = *m_impl->m_primary;
+    GridInfo info;
+    info.id = grid.id;
+    info.state = grid.machine.state();
+    info.scale = grid.scale;
+    info.bounds = grid.bounds;
+    info.budget = grid.budget;
+    info.age = grid.age;
+    info.coveredRun = grid.coveredRun;
+    info.tileCount = static_cast<unsigned>(grid.tiles.size());
+    info.desiredCount = static_cast<unsigned>(grid.desired.size());
+    return info;
+}
+
+std::optional<GridInfo> TileGridModel::backdropGrid() const
+{
+    if (!m_impl->m_backdrop)
+        return std::nullopt;
+    const Impl::Grid& grid = *m_impl->m_backdrop;
+    GridInfo info;
+    info.id = grid.id;
+    info.state = grid.machine.state();
+    info.scale = grid.scale;
+    info.bounds = grid.bounds;
+    info.budget = grid.budget;
+    info.age = grid.age;
+    info.coveredRun = grid.coveredRun;
+    info.tileCount = static_cast<unsigned>(grid.tiles.size());
+    info.desiredCount = static_cast<unsigned>(grid.desired.size());
+    return info;
+}
+
+PhaseState TileGridModel::phase() const { return m_impl->m_phase.state(); }
+std::optional<IntRect> TileGridModel::lastVisible() const { return m_impl->m_visible; }
+IntSize TileGridModel::bounds() const { return m_impl->m_bounds; }
+float TileGridModel::scale() const { return m_impl->m_scale; }
+unsigned TileGridModel::passCount() const { return m_impl->m_passCount; }
+unsigned TileGridModel::compositeCount() const { return m_impl->m_compositeCount; }
+unsigned TileGridModel::illegalArrowCount() const { return m_impl->m_illegalArrows; }
+
+IntRect TileGridModel::cellRect(CellIndex cell, IntSize bounds) const { return m_impl->cellRect(cell, bounds); }
+std::vector<CellIndex> TileGridModel::cellsOf(const IntRect& rect, IntSize bounds) const { return m_impl->cellsOf(rect, bounds); }
+
+} // namespace TileGrid
+} // namespace WebCore
