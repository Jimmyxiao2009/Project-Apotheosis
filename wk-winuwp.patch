+// ---------------------------------------------------------------------------
+// Impl
+// ---------------------------------------------------------------------------
+
+class TileGridModel::Impl {
+public:
+    struct Tile {
+        explicit Tile(CellIndex i) : index(i) { }
+
+        CellIndex index;
+        TileMachine machine;
+        PatchMachine patch;
+        JobId job { invalidJobId };
+        JobId patchJob { invalidJobId };
+        IntRect patchPending;     // accumulated, not requested yet
+        IntRect patchInFlight;    // the rect of the patch job in flight / landed
+        IntRect rasterRect;       // the rect the first-paint job in flight covers
+        TextureId texture { invalidTextureId };
+        IntRect paintedRect;      // R6: the rect the texture's pixels were rasterised for
+        IntSize textureSize;
+        float textureScale { 0.0f };
+    };
+
+    struct Grid {
+        explicit Grid(GridId i) : id(i) { }
+
+        GridId id;
+        GridMachine machine;
+        float scale { 1.0f };
+        IntSize bounds;
+        unsigned budget { 0 };
+        unsigned age { 0 };         // composites since it became a backdrop
+        unsigned coveredRun { 0 };  // consecutive composites with full visible coverage
+        std::map<CellIndex, Tile> tiles;
+        std::vector<CellIndex> desired; // last desired set, in priority order
+    };
+
+    struct JobRecord {
+        JobId id { invalidJobId };
+        JobMachine machine;
+        GridId grid { invalidGridId };
+        CellIndex cell;
+        IntRect rect;
+        bool isPatch { false };
+        unsigned priority { 0 };
+        unsigned cancelledAtPass { 0 };
+    };
+
+    Impl(unsigned storeId, const ModelConfig& config)
+        : m_storeId(storeId)
+        , m_config(config)
+    {
+    }
+
+    // --- machinery -------------------------------------------------------
+
+    template<typename Machine, typename Event>
+    bool stepMachine(Machine& machine, const Event& event, GridId grid = invalidGridId, CellIndex cell = CellIndex())
+    {
+        return TileGrid::step(machine, event, [&](IllegalArrow arrow) {
+            arrow.grid = grid;
+            arrow.cell = cell;
+            ++m_illegalArrows;
+            if (m_observer)
+                m_observer(arrow);
+        });
+    }
+
+    IntRect cellRect(CellIndex index, IntSize bounds) const
+    {
+        const int edge = m_config.tileEdge;
+        return IntRect(index.column * edge, index.row * edge, edge, edge)
+            .intersection(IntRect(0, 0, bounds.width, bounds.height));
+    }
+
+    std::vector<CellIndex> cellsOf(const IntRect& rect, IntSize bounds) const
+    {
+        std::vector<CellIndex> cells;
+        const IntRect clipped = rect.intersection(IntRect(0, 0, bounds.width, bounds.height));
+        if (clipped.isEmpty())
+            return cells;
+        const int edge = m_config.tileEdge;
+        const int firstColumn = floorDiv(clipped.x, edge);
+        const int lastColumn = floorDiv(clipped.maxX() - 1, edge);
+        const int firstRow = floorDiv(clipped.y, edge);
+        const int lastRow = floorDiv(clipped.maxY() - 1, edge);
+        for (int row = firstRow; row <= lastRow; ++row) {
+            for (int column = firstColumn; column <= lastColumn; ++column)
+                cells.push_back(CellIndex(column, row));
+        }
+        return cells;
+    }
+
+    IntRect snappedToLattice(const IntRect& rect) const
+    {
+        if (rect.isEmpty())
+            return IntRect();
+        const int edge = m_config.tileEdge;
+        const int left = floorDiv(rect.x, edge) * edge;
+        const int top = floorDiv(rect.y, edge) * edge;
+        const int right = (floorDiv(rect.maxX() - 1, edge) + 1) * edge;
+        const int bottom = (floorDiv(rect.maxY() - 1, edge) + 1) * edge;
+        return IntRect(left, top, right - left, bottom - top);
+    }
+
+    bool isSmallStore() const
+    {
+        return m_bounds.width <= m_config.smallStoreEdge && m_bounds.height <= m_config.smallStoreEdge;
+    }
+
+    std::unique_ptr<Grid> makeGrid(float scale, IntSize bounds, unsigned budget)
+    {
+        auto grid = std::make_unique<Grid>(m_nextGridId++);
+        grid->scale = scale;
+        grid->bounds = bounds;
+        grid->budget = budget;
+        return grid;
+    }
+
+    // --- events ----------------------------------------------------------
+
+    void queueEvent(const TileEventRecord& record) { m_inbox.push_back(record); }
+
+    void drainInbox(PassOutput& out)
+    {
+        // I17: the only two places the inbox is drained are BeginPass and
+        // BeginComposite. Order is the order the store reported them.
+        std::vector<TileEventRecord> events;
+        events.swap(m_inbox);
+        for (const auto& e : events)
+            applyEvent(e, out);
+    }
+
+    void applyEvent(const TileEventRecord& e, PassOutput& out)
+    {
+        switch (e.kind) {
+        case EventKind::Requested:
+            // Only the model issues Requested, and only inside a pass. From
+            // outside it reaches the phase machine while the store is Idle and
+            // is refused there (I17).
+            stepMachine(m_phase, ev::phase::Request { });
+            return;
+        case EventKind::Dirtied:
+            ruleR10DirtyRects(e.rect, out);
+            return;
+        case EventKind::TextureLost:
+            applyTextureLost(e.grid, e.cell, out);
+            return;
+        case EventKind::UploadFailed:
+            // R4/I4: the tile is Ready with a TextureId the store could not fill.
+            // Ready without pixels draws nothing and is not counted as a hole,
+            // which is precisely the white-while-holes=0 the device showed. The
+            // same arrow a reclaimed texture takes puts it back to Missing, and
+            // R3 asks for the whole cell again on the next pass.
+            ++m_refusedEvents;
+            applyTextureLost(e.grid, e.cell, out);
+            return;
+        case EventKind::Removed:
+            applyRemoved(e.grid, e.cell, out);
+            return;
+        case EventKind::ReplayStarted:
+        case EventKind::ReplayFinished:
+        case EventKind::ReplayFailed:
+        case EventKind::Watchdog:
+        case EventKind::Cancelled:
+        case EventKind::Uploaded:
+            applyJobEvent(e, out);
+            return;
+        case EventKind::RequestRefused:
+            ++m_refusedEvents;
+            applyJobEvent(e, out);
+            return;
+        }
+    }
+
+    Grid* gridById(GridId id)
+    {
+        if (m_primary && m_primary->id == id)
+            return m_primary.get();
+        if (m_backdrop && m_backdrop->id == id)
+            return m_backdrop.get();
+        return nullptr;
+    }
+
+    Tile* tileAt(GridId gridId, CellIndex cell)
+    {
+        Grid* grid = gridById(gridId);
+        if (!grid)
+            return nullptr;
+        auto it = grid->tiles.find(cell);
+        return it == grid->tiles.end() ? nullptr : &it->second;
+    }
+
+    void applyTextureLost(GridId gridId, CellIndex cell, PassOutput& out)
+    {
+        Tile* tile = tileAt(gridId, cell);
+        if (!tile)
+            return;
+        // Nothing to lose: the tile has no texture, so it is not Ready and this
+        // is a second report of a loss that has already been applied. The store
+        // does report a failed upload twice by design (once where the upload
+        // could not happen and once where the draw found no handle), and a
+        // reclaim can race a removal, so this is a no-op rather than an illegal
+        // arrow - Missing --TextureLost--> is not in the table because it has no
+        // meaning, not because it must never be attempted.
+        if (tile->texture == invalidTextureId)
+            return;
+        out.released.push_back(tile->texture);
+        tile->texture = invalidTextureId;
+        tile->paintedRect = IntRect();
+        tile->textureSize = IntSize();
+        tile->textureScale = 0.0f;
+        stepMachine(tile->machine, ev::tile::TextureLost { }, gridId, cell);
+        // A lost texture invalidates whatever the patch machine was tracking:
+        // the tile has to be painted whole again (R3).
+        cancelPatch(*tile, gridId, out);
+    }
+
+    void applyRemoved(GridId gridId, CellIndex cell, PassOutput& out)
+    {
+        Grid* grid = gridById(gridId);
+        if (!grid)
+            return;
+        auto it = grid->tiles.find(cell);
+        if (it == grid->tiles.end())
+            return;
+        removeTile(*grid, it, out.cancels, out.released);
+        ++out.removed;
+    }
+
+    void applyJobEvent(const TileEventRecord& e, PassOutput& out)
+    {
+        auto it = m_jobs.find(e.job);
+        if (it == m_jobs.end())
+            return; // completion of a job that is long gone: discarded (R5)
+        JobRecord& job = it->second;
+        const bool cancelled = job.machine.state() == JobState::Cancelled;
+        const GridId grid = job.grid;
+        const CellIndex cell = job.cell;
+        const bool isPatch = job.isPatch;
+
+        // R5: a worker that finishes a cancelled job has its result discarded.
+        // Cancelled is terminal for the job machine, so nothing is stepped -
+        // reporting it as an illegal arrow would flag a normal race.
+        if (cancelled) {
+            if (e.kind != EventKind::ReplayStarted)
+                m_jobs.erase(it);
+            return;
+        }
+
+        switch (e.kind) {
+        case EventKind::ReplayStarted:
+            stepMachine(job.machine, ev::job::Started { }, grid, cell);
+            return;
+        case EventKind::Cancelled:
+            stepMachine(job.machine, ev::job::Cancelled { }, grid, cell);
+            m_jobs.erase(it);
+            forwardToTile(grid, cell, isPatch, ev::tile::Cancelled { });
+            return;
+        case EventKind::ReplayFinished:
+            // The store does not have to report the worker pickup; a completion
+            // implies it (the job machine's Queued -> Running arrow).
+            if (job.machine.state() == JobState::Queued)
+                stepMachine(job.machine, ev::job::Started { }, grid, cell);
+            stepMachine(job.machine, ev::job::Finished { }, grid, cell);
+            m_jobs.erase(it);
+            forwardToTile(grid, cell, isPatch, ev::tile::ReplayFinished { });
+            return;
+        case EventKind::ReplayFailed:
+        case EventKind::Watchdog:
+        // R5: a request the backend would not take is a failed replay, no more
+        // and no less. It is reported inside the same pass that issued it, so
+        // the job is still Queued; the arrows below take it to Failed and the
+        // tile back to Missing (a patch back to Pending with its rect intact),
+        // which R3 turns into a new request on the very next pass.
+        case EventKind::RequestRefused:
+            if (job.machine.state() == JobState::Queued)
+                stepMachine(job.machine, ev::job::Started { }, grid, cell);
+            if (e.kind == EventKind::Watchdog)
+                stepMachine(job.machine, ev::job::Watchdog { }, grid, cell);
+            else
+                stepMachine(job.machine, ev::job::Failed { }, grid, cell);
+            m_jobs.erase(it);
+            forwardToTile(grid, cell, isPatch, ev::tile::ReplayFailed { });
+            return;
+        case EventKind::Uploaded:
+            m_jobs.erase(it);
+            stepMachine(m_phase, ev::phase::Upload { });
+            applyUpload(grid, cell, isPatch, out.released);
+            return;
+        default:
+            return;
+        }
+    }
+
+    template<typename Event>
+    void forwardToTile(GridId gridId, CellIndex cell, bool isPatch, const Event& event)
+    {
+        Tile* tile = tileAt(gridId, cell);
+        if (!tile)
+            return;
+        if (isPatch) {
+            stepMachine(tile->patch, event, gridId, cell);
+            const PatchState state = tile->patch.state();
+            if (state == PatchState::Pending) {
+                // A failed patch goes back to Pending with its rect intact.
+                tile->patchPending = tile->patchPending.unite(tile->patchInFlight);
+                tile->patchInFlight = IntRect();
+                tile->patchJob = invalidJobId;
+            } else if (state == PatchState::None) {
+                tile->patchPending = IntRect();
+                tile->patchInFlight = IntRect();
+                tile->patchJob = invalidJobId;
+            }
+        } else {
+            stepMachine(tile->machine, event, gridId, cell);
+            if (tile->machine.state() == TileState::Missing)
+                tile->job = invalidJobId;
+        }
+    }
+
+    // The one place a tile's texture and paintedRect are assigned (R6, I4).
+    // Returns the rect that is actually written into the texture; empty means
+    // "nothing to upload" (a patch that lies entirely outside the pixels the
+    // tile currently holds - the whole-cell patch behind it repairs that).
+    //
+    // paintedRect is always the rect the pixels were rasterised for, never the
+    // current cell rect: a partial edge cell whose size changed keeps drawing
+    // what it has, and only a patch that covers the whole cell replaces both
+    // the texture and the paintedRect.
+    IntRect commitUpload(Grid& grid, Tile& tile, bool isPatch, std::vector<TextureId>& released)
+    {
+        if (!isPatch) {
+            const IntRect rasterised = tile.rasterRect.isEmpty() ? cellRect(tile.index, grid.bounds) : tile.rasterRect;
+            stepMachine(tile.machine, ev::tile::Uploaded { }, grid.id, tile.index);
+            tile.job = invalidJobId;
+            tile.rasterRect = IntRect();
+            if (tile.texture != invalidTextureId)
+                released.push_back(tile.texture);
+            tile.texture = m_nextTextureId++;
+            tile.paintedRect = rasterised;
+            tile.textureSize = rasterised.size();
+            tile.textureScale = grid.scale;
+            return rasterised;
+        }
+
+        const IntRect inFlight = tile.patchInFlight;
+        const IntRect cell = cellRect(tile.index, grid.bounds);
+        const bool coversCell = !cell.isEmpty() && inFlight.contains(cell);
+
+        stepMachine(tile.patch, ev::tile::Uploaded { }, grid.id, tile.index);
+        tile.patchInFlight = IntRect();
+        tile.patchJob = invalidJobId;
+        // R10: a rect that arrived while the patch was in flight becomes the
+        // next patch right away.
+        if (!tile.patchPending.isEmpty())
+            stepMachine(tile.patch, ev::tile::Dirtied { }, grid.id, tile.index);
+
+        if (coversCell) {
+            // A whole-cell patch: the texture and the paintedRect are replaced.
+            // A new texture is only needed when the size changed - a repaint of
+            // an unchanged cell reuses the one it has.
+            if (tile.paintedRect.size() != inFlight.size()) {
+                if (tile.texture != invalidTextureId)
+                    released.push_back(tile.texture);
+                tile.texture = m_nextTextureId++;
+            }
+            tile.paintedRect = inFlight;
+            tile.textureSize = inFlight.size();
+            tile.textureScale = grid.scale;
+            return inFlight;
+        }
+        return inFlight.intersection(tile.paintedRect);
+    }
+
+    void applyUpload(GridId gridId, CellIndex cell, bool isPatch, std::vector<TextureId>& released)
+    {
+        Tile* tile = tileAt(gridId, cell);
+        Grid* grid = gridById(gridId);
+        if (!tile || !grid)
+            return;
+        commitUpload(*grid, *tile, isPatch, released);
+    }
+
+    void cancelPatch(Tile& tile, GridId gridId, PassOutput& out)
+    {
+        if (tile.patchJob != invalidJobId) {
+            cancelJob(tile.patchJob, out.cancels);
+            tile.patchJob = invalidJobId;
+        }
+        if (tile.patch.state() != PatchState::None)
+            stepMachine(tile.patch, ev::tile::Cancelled { }, gridId, tile.index);
+        tile.patchPending = IntRect();
+        tile.patchInFlight = IntRect();
+    }
+
+    void cancelJob(JobId id, std::vector<JobId>& cancels)
+    {
+        auto it = m_jobs.find(id);
+        if (it == m_jobs.end())
+            return;
+        stepMachine(it->second.machine, ev::job::Cancelled { }, it->second.grid, it->second.cell);
+        it->second.cancelledAtPass = m_passCount;
+        cancels.push_back(id);
+    }
+
+    // I13: a removed tile's job is cancelled and its texture returned exactly once.
+    void removeTile(Grid& grid, std::map<CellIndex, Tile>::iterator it, std::vector<JobId>& cancels, std::vector<TextureId>& released)
+    {
+        Tile& tile = it->second;
+        if (tile.job != invalidJobId)
+            cancelJob(tile.job, cancels);
+        if (tile.patchJob != invalidJobId)
+            cancelJob(tile.patchJob, cancels);
+        if (tile.texture != invalidTextureId)
+            released.push_back(tile.texture);
+        stepMachine(tile.machine, ev::tile::Removed { }, grid.id, tile.index);
+        stepMachine(tile.patch, ev::tile::Removed { }, grid.id, tile.index);
+        grid.tiles.erase(it);
+    }
+
+    void dropGrid(std::unique_ptr<Grid> grid, PassOutput& out)
+    {
+        if (!grid)
+            return;
+        while (!grid->tiles.empty())
+            removeTile(*grid, grid->tiles.begin(), out.cancels, out.released);
+    }
+
+    // ---------------------------------------------------------------------
+    // R1 - desired set
+    // ---------------------------------------------------------------------
+
+    IntRect ruleR1CoverRect(const PassInput& in) const
+    {
+        const IntRect boundsRect(0, 0, in.boundsScaled.width, in.boundsScaled.height);
+        if (!in.visible)
+            return boundsRect;
+
+        const IntRect& visible = *in.visible;
+        // Apotheosis (0.1.9.34): the cover is grown from the part of the layer that is
+        // actually on screen, V n B - not from V. Nothing of this layer visible, nothing to
+        // cover; and the margin below is still a fraction of V's own size, so a layer that
+        // shows a sliver of itself gets the same pre-render as one that fills the viewport.
+        //
+        // Both ways of missing B mattered on the device (one session,
+        // where wkVisibleRectForChild hands an off-screen post card its intersected-away rect):
+        // an EMPTY V (0,1,0,0) - where the margin happens to be zero, so only
+        // IntRect::inflated() growing an empty rect into a real one could hurt, which is
+        // exactly what R7 did - and a 1x1 V *outside* B (1603,2,1,1 against B 1542x167), where
+        // snappedToLattice() expands the cover outwards onto the lattice and pulls it back into
+        // B, so the primary grid of a layer nobody can see desired a cell and rastered it.
+        // No composite followed (an off-screen layer is never painted), the tile stayed Landed
+        // holding its raster buffer, and R12 asked for a pass on every tick for ever.
+        const IntRect visibleInBounds = visible.intersection(boundsRect);
+        if (visibleInBounds.isEmpty())
+            return IntRect();
+        const int divisor = isScaleOne(in.scale) ? constants::marginDivisorAtScale1 : constants::marginDivisorZoomed;
+        const int marginX = visible.width / divisor;
+        const int marginY = visible.height / divisor;
+
+        int left = marginX;
+        int right = marginX;
+        int top = marginY;
+        int bottom = marginY;
+
+        // The pan side gets the doubled margin: the harness translates the last
+        // frame by up to a third of the screen before the engine catches up
+        // (section 3), so the model tiles what the finger is about to reveal.
+        //
+        // The side is the model's own pan direction - the sign of the last
+        // movement of V - and is *not* gated on PassInput::panGesture: a fling
+        // after the finger has left the glass moves fastest of all, and that is
+        // exactly when the gesture flag is false (package 1 review, R1). The
+        // direction is zero whenever V did not move in a pass, so a still
+        // viewport gets the symmetric margin back.
+        if (m_panDirection.x > 0)
+            right *= constants::panSideMarginFactor;
+        else if (m_panDirection.x < 0)
+            left *= constants::panSideMarginFactor;
+        if (m_panDirection.y > 0)
+            bottom *= constants::panSideMarginFactor;
+        else if (m_panDirection.y < 0)
+            top *= constants::panSideMarginFactor;
+
+        return snappedToLattice(visibleInBounds.inflated(left, top, right, bottom)).intersection(boundsRect);
+    }
+
+    std::vector<CellIndex> ruleR1DesiredCells(const Grid& grid, const PassInput& in) const
+    {
+        std::vector<CellIndex> cells = cellsOf(ruleR1CoverRect(in), grid.bounds);
+        if (!in.visible) {
+            // V unknown: cells(B) truncated from the top left (row-major, which
+            // is the order cellsOf produces).
+            if (cells.size() > grid.budget)
+                cells.resize(grid.budget);
+            return cells;
+        }
+        orderCells(cells, *in.visible, grid.bounds);
+        if (cells.size() > grid.budget)
+            cells.resize(grid.budget);
+        return cells;
+    }
+
+    // R1/R5 ordering: cells of V first, then by distance from V's centre, then
+    // the pan side, then row-major so the order is total and reproducible (I14).
+    void orderCells(std::vector<CellIndex>& cells, const IntRect& visible, IntSize bounds) const
+    {
+        const IntPoint centre = visible.center();
+        const IntPoint pan = m_panDirection;
+        std::stable_sort(cells.begin(), cells.end(), [&](CellIndex a, CellIndex b) {
+            const IntRect ra = cellRect(a, bounds);
+            const IntRect rb = cellRect(b, bounds);
+            const bool va = ra.intersects(visible);
+            const bool vb = rb.intersects(visible);
+            if (va != vb)
+                return va;
+            const long long da = squaredDistance(ra.center(), centre);
+            const long long db = squaredDistance(rb.center(), centre);
+            if (da != db)
+                return da < db;
+            const long long pa = static_cast<long long>(ra.center().x - centre.x) * pan.x
+                + static_cast<long long>(ra.center().y - centre.y) * pan.y;
+            const long long pb = static_cast<long long>(rb.center().x - centre.x) * pan.x
+                + static_cast<long long>(rb.center().y - centre.y) * pan.y;
+            if (pa != pb)
+                return pa > pb;
+            return a < b;
+        });
+    }
+
+    // ---------------------------------------------------------------------
+    // R2 - reconcile
+    // ---------------------------------------------------------------------
+
+    void ruleR2Reconcile(Grid& grid, const std::vector<CellIndex>& desired, PassOutput& out)
+    {
+        std::map<CellIndex, bool> wanted;
+        for (CellIndex cell : desired)
+            wanted[cell] = true;
+
+        for (auto it = grid.tiles.begin(); it != grid.tiles.end();) {
+            if (wanted.count(it->first)) {
+                ++it;
+                continue;
+            }
+            auto victim = it++;
+            removeTile(grid, victim, out.cancels, out.released);
+            ++out.removed;
+        }
+
+        for (CellIndex cell : desired) {
+            if (grid.tiles.find(cell) == grid.tiles.end())
+                grid.tiles.emplace(cell, Tile(cell));
+        }
+        grid.desired = desired;
+    }
+
+    // ---------------------------------------------------------------------
+    // R3 - paint requests
+    // ---------------------------------------------------------------------
+
+    bool wantsSyncPaint(const PassInput& in, const Grid& grid, const IntRect& cellRectangle, bool isPatch) const
+    {
+        if (!in.threadedRaster)
+            return true;
+        if (isSmallStore())
+            return true;
+        if (isPatch)
+            return false;
+        if (grid.machine.state() != GridState::Primary)
+            return false; // the persistent backdrop is always Async, lowest priority
+        if (m_config.syncOnScaleCommit && m_scaleChangedThisPass && in.visible && cellRectangle.intersects(*in.visible))
+            return true;
+        return false;
+    }
+
+    void ruleR3PaintRequests(Grid& grid, const PassInput& in, PassOutput& out, unsigned& priority)
+    {
+        for (CellIndex cell : grid.desired) {
+            auto it = grid.tiles.find(cell);
+            if (it == grid.tiles.end())
+                continue;
+            Tile& tile = it->second;
+            const IntRect rect = cellRect(cell, grid.bounds);
+            if (rect.isEmpty())
+                continue;
+
+            if (tile.machine.state() == TileState::Missing) {
+                // A whole-cell paint subsumes any accumulated dirty rect.
+                if (tile.patch.state() != PatchState::None || !tile.patchPending.isEmpty())
+                    cancelPatch(tile, grid.id, out);
+                emitRequest(grid, tile, rect, false, in, out, priority);
+                continue;
+            }
+
+            // R10/I12: exactly one job per tile. A tile that is Rastering or
+            // Landed, or whose patch is already in flight, asks for nothing.
+            if (tile.machine.state() != TileState::Ready)
+                continue;
+            if (tile.patch.state() != PatchState::Pending)
+                continue;
+            const IntRect patchRect = tile.patchPending.intersection(rect);
+            if (patchRect.isEmpty()) {
+                cancelPatch(tile, grid.id, out);
+                continue;
+            }
+            emitRequest(grid, tile, patchRect, true, in, out, priority);
+        }
+    }
+
+    void emitRequest(Grid& grid, Tile& tile, const IntRect& rect, bool isPatch, const PassInput& in, PassOutput& out, unsigned& priority)
+    {
+        stepMachine(m_phase, ev::phase::Request { });
+
+        const JobId jobId = m_nextJobId++;
+        JobRecord& job = m_jobs[jobId];
+        job.id = jobId;
+        job.grid = grid.id;
+        job.cell = tile.index;
+        job.rect = rect;
+        job.isPatch = isPatch;
+        job.priority = priority;
+
+        PaintRequest request;
+        request.grid = grid.id;
+        request.cell = tile.index;
+        request.rect = rect;
+        request.mode = wantsSyncPaint(in, grid, cellRect(tile.index, grid.bounds), isPatch) ? PaintMode::Sync : PaintMode::Async;
+        request.priority = priority;
+        request.job = jobId;
+        request.isPatch = isPatch;
+
+        if (isPatch) {
+            stepMachine(tile.patch, ev::tile::Requested { }, grid.id, tile.index);
+            tile.patchInFlight = rect;
+            tile.patchPending = IntRect();
+            tile.patchJob = jobId;
+        } else {
+            stepMachine(tile.machine, ev::tile::Requested { }, grid.id, tile.index);
+            tile.job = jobId;
+            // I4/R6: remember what this replay covers. The cell may resize
+            // before it lands; the pixels then belong to the old rect and
+            // paintedRect says so.
+            tile.rasterRect = rect;
+        }
+
+        out.paints.push_back(request);
+        if (request.mode == PaintMode::Sync)
+            ++out.syncJobs;
+        else
+            ++out.asyncJobs;
+        ++priority;
+    }
+
+    // ---------------------------------------------------------------------
+    // R6 - bounds change without scale change
+    // ---------------------------------------------------------------------
+
+    void ruleR6BoundsChange(Grid& grid, IntSize newBounds, PassOutput& out)
+    {
+        if (grid.bounds == newBounds)
+            return;
+        const IntSize oldBounds = grid.bounds;
+        grid.bounds = newBounds;
+
+        for (auto it = grid.tiles.begin(); it != grid.tiles.end();) {
+            const IntRect nowRect = cellRect(it->first, newBounds);
+            if (nowRect.isEmpty()) {
+                auto victim = it++;
+                removeTile(grid, victim, out.cancels, out.released);
+                ++out.removed;
+                continue;
+            }
+            const IntRect thenRect = cellRect(it->first, oldBounds);
+            if (nowRect.size() != thenRect.size()) {
+                // A partial edge cell that changed size keeps its tile, its
+                // state and its pixels, and keeps drawing them at the rect they
+                // were rasterised for (paintedRect). It receives a whole-cell
+                // patch; when that lands, commitUpload() replaces both the
+                // texture and the paintedRect. Nothing is ever stretched.
+                // This is what makes a header that resizes every frame stable
+                // (scenario 8): its one cell keeps drawing throughout.
+                Tile& tile = it->second;
+                if (tile.machine.state() != TileState::Missing)
+                    dirtyTile(grid, tile, nowRect);
+            }
+            ++it;
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // R7 - scale change
+    // ---------------------------------------------------------------------
+
+    IntSize unscaledBounds(IntSize bounds, float scale) const
+    {
+        if (scale <= 0.0f)
+            return bounds;
+        return IntSize(scaledInt(bounds.width, 1.0f / scale), scaledInt(bounds.height, 1.0f / scale));
+    }
+
+    // Rastering/Landed tiles are cancelled and dropped, Ready tiles are kept.
+    void freezeGrid(Grid& grid, PassOutput& out)
+    {
+        for (auto it = grid.tiles.begin(); it != grid.tiles.end();) {
+            Tile& tile = it->second;
+            if (tile.patchJob != invalidJobId || tile.patch.state() != PatchState::None)
+                cancelPatch(tile, grid.id, out);
+            if (tile.machine.state() == TileState::Ready) {
+                ++it;
+                continue;
+            }
+            auto victim = it++;
+            removeTile(grid, victim, out.cancels, out.released);
+            ++out.removed;
+        }
+    }
+
+    void ruleR7ScaleChange(const PassInput& in, PassOutput& out)
+    {
+        const bool newIsOne = isScaleOne(in.scale);
+        const bool oldIsOne = isScaleOne(m_primary->scale);
+        const bool persistentAlive = m_backdrop && m_backdrop->machine.state() == GridState::PersistentBackdrop;
+
+        if (in.isImage) {
+            // Image stores have no backdrop at all (section 2.3).
+            dropGrid(std::move(m_backdrop), out);
+            dropGrid(std::move(m_primary), out);
+            m_primary = makeGrid(in.scale, in.boundsScaled, in.tileBudget);
+            return;
+        }
+
+        if (newIsOne && persistentAlive) {
+            // The zoomed-out grid goes back to being the primary; the grid we
+            // were zoomed at becomes the transient backdrop.
+            std::unique_ptr<Grid> persistent = std::move(m_backdrop);
+            std::unique_ptr<Grid> oldPrimary = std::move(m_primary);
+            stepMachine(persistent->machine, ev::grid::ScaleReturnsTo1 { }, persistent->id);
+            stepMachine(oldPrimary->machine, ev::grid::ScaleChanged { false }, oldPrimary->id);
+            if (oldPrimary->machine.state() == GridState::TransientBackdrop) {
+                oldPrimary->age = 0;
+                oldPrimary->coveredRun = 0;
+                freezeGrid(*oldPrimary, out);
+                m_backdrop = std::move(oldPrimary);
+            } else
+                dropGrid(std::move(oldPrimary), out);
+            persistent->budget = in.tileBudget;
+            persistent->scale = in.scale;
+            m_primary = std::move(persistent);
+            ruleR6BoundsChange(*m_primary, in.boundsScaled, out);
+            return;
+        }
+
+        if (oldIsOne) {
+            // Leaving 1: the scale-1 grid becomes the persistent backdrop and
+            // stays for as long as the page is zoomed. At most one backdrop (I8).
+            dropGrid(std::move(m_backdrop), out);
+            std::unique_ptr<Grid> oldPrimary = std::move(m_primary);
+            stepMachine(oldPrimary->machine, ev::grid::ScaleLeaves1 { }, oldPrimary->id);
+            oldPrimary->age = 0;
+            oldPrimary->coveredRun = 0;
+            oldPrimary->budget = m_config.persistentBackdropBudget;
+            freezeGrid(*oldPrimary, out);
+            m_backdrop = std::move(oldPrimary);
+        } else {
+            std::unique_ptr<Grid> oldPrimary = std::move(m_primary);
+            stepMachine(oldPrimary->machine, ev::grid::ScaleChanged { persistentAlive }, oldPrimary->id);
+            if (oldPrimary->machine.state() == GridState::TransientBackdrop) {
+                dropGrid(std::move(m_backdrop), out);
+                oldPrimary->age = 0;
+                oldPrimary->coveredRun = 0;
+                freezeGrid(*oldPrimary, out);
+                m_backdrop = std::move(oldPrimary);
+            } else {
+                // A persistent backdrop takes precedence: 2.85 -> 6 keeps the
+                // scale-1 grid and drops the 2.85 one.
+                dropGrid(std::move(oldPrimary), out);
+            }
+        }
+        m_primary = makeGrid(in.scale, in.boundsScaled, in.tileBudget);
+    }
+
+    // R7, second half: the persistent backdrop is maintained, never patched,
+    // never larger than P tiles.
+    void ruleR7MaintainPersistentBackdrop(const PassInput& in, PassOutput& out, unsigned& priority)
+    {
+        if (!m_backdrop || m_backdrop->machine.state() != GridState::PersistentBackdrop)
+            return;
+
+        const float ratio = m_primary->scale > 0.0f ? 1.0f / m_primary->scale : 1.0f;
+        ruleR6BoundsChange(*m_backdrop, unscaledBounds(in.boundsScaled, in.scale), out);
+
+        std::vector<CellIndex> desired;
+        if (in.visible) {
+            // Apotheosis: an off-screen store used to raster for ever - the backdrop is
+            // maintained for the part of the primary grid a composite
+            // can actually show, which is V *intersected with B* - not for V itself.
+            //
+            // R8 draws the backdrop only underneath a primary cell that intersects V, and
+            // cellsOf() never yields a cell outside B, so a backdrop cell that no cell of
+            // V n B maps to can never reach the screen. Deriving the cover from V alone got
+            // that wrong in both directions of "empty":
+            //
+            //   * an off-screen layer has an EMPTY V (wkVisibleRectForChild intersects it away:
+            //     V = 0,1,0,0 on the device). R1 answers that with an empty cover and an empty
+            //     primary grid - correct - but IntRect::inflated() grows an empty rect into a
+            //     real one (width + left + right), so the one-cell margin below turned the same
+            //     input into a cover over all of B here;
+            //   * a layer scrolled just off the side has a 1x1 V *outside* B (V = -1587,2,1,1),
+            //     and one cell of margin - 1024 unscaled px, 2700 scaled px at 2.64x - reaches
+            //     back into B from there.
+            //
+            // Either way the backdrop of a layer that shows nothing rastered a tile. Nothing
+            // ever uploaded it: an upload happens only in a composite (R4) and an off-screen
+            // layer is never composited, so the tile stayed Landed holding its raster buffer,
+            // and R12 kept wantsPass() true, which ran a pass for that store on every tick for
+            // the rest of the session. 23 stores in one device session,
+            // ~14 000 passes (45 % of the whole trace) and ~25 MB of tile buffers.
+            const IntRect visibleInBounds = in.visible->intersection(
+                IntRect(0, 0, in.boundsScaled.width, in.boundsScaled.height));
+            if (!visibleInBounds.isEmpty()) {
+                const IntRect mapped = scaledRect(visibleInBounds, ratio);
+                const int edge = m_config.tileEdge * static_cast<int>(constants::persistentBackdropMarginCells);
+                const IntRect cover = snappedToLattice(mapped.inflated(edge, edge, edge, edge))
+                    .intersection(IntRect(0, 0, m_backdrop->bounds.width, m_backdrop->bounds.height));
+                desired = cellsOf(cover, m_backdrop->bounds);
+                orderCells(desired, mapped, m_backdrop->bounds);
+            }
+        } else
+            desired = cellsOf(IntRect(0, 0, m_backdrop->bounds.width, m_backdrop->bounds.height), m_backdrop->bounds);
+
+        if (desired.size() > m_backdrop->budget)
+            desired.resize(m_backdrop->budget);
+
+        ruleR2Reconcile(*m_backdrop, desired, out);
+        ruleR3PaintRequests(*m_backdrop, in, out, priority);
+    }
+
+    // ---------------------------------------------------------------------
+    // R9 - transient backdrop lifetime (composite side)
+    // ---------------------------------------------------------------------
+
+    void ruleR9AgeTransientBackdrop(const IntRect& visible, DrawList& draw)
+    {
+        if (!m_backdrop || m_backdrop->machine.state() != GridState::TransientBackdrop)
+            return;
+
+        ++m_backdrop->age;
+        // The commit frame itself does not count towards K.
+        if (m_backdrop->age > 1 && visibleCellsAllReady(visible))
+            ++m_backdrop->coveredRun;
+        else
+            m_backdrop->coveredRun = 0;
+
+        stepMachine(m_backdrop->machine, ev::grid::Covered { m_backdrop->coveredRun, m_config.backdropCoverageComposites }, m_backdrop->id);
+        if (m_backdrop->machine.state() == GridState::TransientBackdrop)
+            stepMachine(m_backdrop->machine, ev::grid::Aged { m_backdrop->age, m_config.backdropMaxComposites }, m_backdrop->id);
+
+        if (m_backdrop->machine.state() == GridState::Dropped) {
+            PassOutput scratch;
+            dropGrid(std::move(m_backdrop), scratch);
+            for (TextureId id : scratch.released)
+                draw.released.push_back(id);
+            for (JobId id : scratch.cancels)
+                draw.cancels.push_back(id);
+        }
+    }
+
+    bool visibleCellsAllReady(const IntRect& visible) const
+    {
+        if (!m_primary)
+            return true;
+        for (CellIndex cell : cellsOf(visible, m_primary->bounds)) {
+            auto it = m_primary->tiles.find(cell);
+            if (it == m_primary->tiles.end() || it->second.machine.state() != TileState::Ready)
+                return false;
+        }
+        return true;
+    }
+
+    // ---------------------------------------------------------------------
+    // R10 - dirty rects
+    // ---------------------------------------------------------------------
+
+    void dirtyTile(Grid& grid, Tile& tile, const IntRect& rect)
+    {
+        const IntRect clipped = rect.intersection(cellRect(tile.index, grid.bounds));
+        if (clipped.isEmpty())
+            return;
+        tile.patchPending = tile.patchPending.unite(clipped);
+        stepMachine(tile.patch, ev::tile::Dirtied { }, grid.id, tile.index);
+    }
+
+    void ruleR10DirtyRects(const IntRect& dirty, PassOutput& out)
+    {
+        if (dirty.isEmpty() || !m_primary)
+            return;
+
+        // A dirty rect never adds, removes, hides or cancels a tile and never
+        // cancels a job (I10). It only feeds the patch machine.
+        for (CellIndex cell : cellsOf(dirty, m_primary->bounds)) {
+            auto it = m_primary->tiles.find(cell);
+            if (it == m_primary->tiles.end())
+                continue;
+            dirtyTile(*m_primary, it->second, dirty);
+        }
+
+        // The persistent backdrop is never patched: the intersecting tiles are
+        // dropped and re-requested lazily by the next pass (R7).
+        if (m_backdrop && m_backdrop->machine.state() == GridState::PersistentBackdrop && m_primary->scale > 0.0f) {
+            const IntRect mapped = scaledRect(dirty, 1.0f / m_primary->scale);
+            for (CellIndex cell : cellsOf(mapped, m_backdrop->bounds)) {
+                auto it = m_backdrop->tiles.find(cell);
+                if (it == m_backdrop->tiles.end())
+                    continue;
+                removeTile(*m_backdrop, it, out.cancels, out.released);
+                ++out.removed;
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // R11 - progressive cover: deliberately absent.
+    // ---------------------------------------------------------------------
+    //
+    // v1 had a second mechanism that grew the tile set beyond the cover rect
+    // over idle frames, and it was one of the two authorities that fought over
+    // "should this tile exist". In v2 the margin M of R1 *is* the pre-render;
+    // a pass whose inputs did not change asks for nothing new. The function
+    // exists so that the rule has a name, a place in the review and a test
+    // (scenarios::progressiveCoverIsGone).
+    void ruleR11NoProgressiveCover(const PassOutput& out) const
+    {
+        (void)out;
+    }
+
+    // ---------------------------------------------------------------------
+    // R12 - convergence
+    // ---------------------------------------------------------------------
+
+    bool ruleR12WantsPass() const
+    {
+        if (!m_primary)
+            return true;
+        for (CellIndex cell : m_primary->desired) {
+            auto it = m_primary->tiles.find(cell);
+            if (it == m_primary->tiles.end())
+                return true;
+            if (it->second.machine.state() != TileState::Ready)
+                return true;
+            if (it->second.patch.state() != PatchState::None)
+                return true;
+        }
+        if (m_backdrop) {
+            if (m_backdrop->machine.state() == GridState::TransientBackdrop)
+                return true; // it needs composites to end (R9)
+            for (CellIndex cell : m_backdrop->desired) {
+                auto it = m_backdrop->tiles.find(cell);
+                if (it == m_backdrop->tiles.end() || it->second.machine.state() != TileState::Ready)
+                    return true;
+            }
+        }
+        return false;
+    }
+
+    // ---------------------------------------------------------------------
+    // R4 / R8 - uploads and drawing
+    // ---------------------------------------------------------------------
+
+    struct UploadCandidate {
+        Grid* grid { nullptr };
+        CellIndex cell {};
+        bool isPatch { false };
+        bool visible { false };
+        long long distance { 0 };
+        unsigned gridRank { 0 };
+    };
+
+    void collectUploadCandidates(Grid* grid, unsigned gridRank, const IntRect& visible, std::vector<UploadCandidate>& into)
+    {
+        if (!grid)
+            return;
+        const float ratio = (grid->scale > 0.0f && m_primary) ? m_primary->scale / grid->scale : 1.0f;
+        for (auto& entry : grid->tiles) {
+            const Tile& tile = entry.second;
+            const bool firstPaint = tile.machine.state() == TileState::Landed;
+            const bool patch = tile.machine.state() == TileState::Ready && tile.patch.state() == PatchState::Landed;
+            if (!firstPaint && !patch)
+                continue;
+            UploadCandidate candidate;
+            candidate.grid = grid;
+            candidate.cell = entry.first;
+            candidate.isPatch = patch;
+            const IntRect target = scaledRect(cellRect(entry.first, grid->bounds), ratio);
+            candidate.visible = target.intersects(visible);
+            candidate.distance = squaredDistance(target.center(), visible.center());
+            candidate.gridRank = gridRank;
+            into.push_back(candidate);
+        }
+    }
+
+    void ruleR4Uploads(const IntRect& visible, unsigned maxUploads, DrawList& draw)
+    {
+        std::vector<UploadCandidate> candidates;
+        collectUploadCandidates(m_primary.get(), 0, visible, candidates);
+        collectUploadCandidates(m_backdrop.get(), 1, visible, candidates);
+
+        std::stable_sort(candidates.begin(), candidates.end(), [](const UploadCandidate& a, const UploadCandidate& b) {
+            if (a.visible != b.visible)
+                return a.visible;
+            if (a.gridRank != b.gridRank)
+                return a.gridRank < b.gridRank;
+            if (a.distance != b.distance)
+                return a.distance < b.distance;
+            return a.cell < b.cell;
+        });
+
+        unsigned budgeted = 0;
+        for (const UploadCandidate& candidate : candidates) {
+            // R4: a tile whose cell intersects V is exempt from the budget - a
+            // visible hole is never traded for frame time.
+            if (!candidate.visible) {
+                if (budgeted >= maxUploads)
+                    continue;
+                ++budgeted;
+            }
+            auto it = candidate.grid->tiles.find(candidate.cell);
+            if (it == candidate.grid->tiles.end())
+                continue;
+            Tile& tile = it->second;
+
+            stepMachine(m_phase, ev::phase::Upload { });
+
+            UploadRecord record;
+            record.grid = candidate.grid->id;
+            record.cell = candidate.cell;
+            record.isPatch = candidate.isPatch;
+            record.budgetExempt = candidate.visible;
+
+            if (candidate.isPatch) {
+                if (tile.patchJob != invalidJobId)
+                    m_jobs.erase(tile.patchJob);
+            } else if (tile.job != invalidJobId)
+                m_jobs.erase(tile.job);
+
+            record.rect = commitUpload(*candidate.grid, tile, candidate.isPatch, draw.released);
+            record.texture = tile.texture;
+            if (record.rect.isEmpty())
+                continue;
+            draw.uploads.push_back(record);
+        }
+    }
+
+    // R8: every visible pixel comes from exactly one of {primary Ready tile,
+    // backdrop clip, nothing}; nothing only when there is no backdrop.
+    void ruleR8BuildDrawList(const IntRect& visible, DrawList& draw) const
+    {
+        if (!m_primary)
+            return;
+        const bool hasBackdrop = m_backdrop && m_backdrop->machine.state() != GridState::Dropped;
+        const float backdropRatio = (hasBackdrop && m_backdrop->scale > 0.0f) ? m_primary->scale / m_backdrop->scale : 1.0f;
+
+        // Apotheosis (device round 1, 0.1.9.29): over the *desired* cells, not
+        // over cells(B). R2 gives a tile only to a desired cell, so a cell
+        // outside the desired set can never become Ready and counting it as a
+        // hole is counting something the model has decided not to have. On the
+        // device that was permanent: a store whose visible rect is unknown
+        // (a mask, a replica, S100/S2000 in the 0.1.9.29 log) composites against
+        // all of B, so every cell of B beyond the budget was reported as a hole
+        // for ever and the driver's "holes > 0 => one more composite" rule
+        // turned into a busy loop on a page at rest (2749 rows with tg_holes=3).
+        // I3 keeps this honest where it matters: while the budget covers V,
+        // every cell of V is desired, so no visible hole is hidden by this.
+        std::set<CellIndex> desired(m_primary->desired.begin(), m_primary->desired.end());
+
+        for (CellIndex cell : cellsOf(visible, m_primary->bounds)) {
+            if (!desired.count(cell))
+                continue;
+            ++draw.visibleCells;
+            const IntRect rect = cellRect(cell, m_primary->bounds);
+            auto it = m_primary->tiles.find(cell);
+            if (it != m_primary->tiles.end() && it->second.machine.state() == TileState::Ready) {
+                TileDraw entry;
+                entry.grid = m_primary->id;
+                entry.cell = cell;
+                // R6/I4: draw the texture at the rect it was rasterised for.
+                entry.target = it->second.paintedRect;
+                entry.texture = it->second.texture;
+                entry.scale = m_primary->scale;
+                draw.tiles.push_back(entry);
+                continue;
+            }
+            if (!hasBackdrop) {
+                ++draw.visibleHoles;
+                continue;
+            }
+
+            BackdropClip clip;
+            clip.cell = cell;
+            clip.clip = rect.intersection(visible);
+            clip.fullyCovered = true;
+            const IntRect mapped = scaledRect(clip.clip, 1.0f / backdropRatio);
+            for (CellIndex backdropCell : cellsOf(mapped, m_backdrop->bounds)) {
+                auto backdropTile = m_backdrop->tiles.find(backdropCell);
+                if (backdropTile == m_backdrop->tiles.end() || backdropTile->second.machine.state() != TileState::Ready) {
+                    clip.fullyCovered = false;
+                    continue;
+                }
+                TileDraw entry;
+                entry.grid = m_backdrop->id;
+                entry.cell = backdropCell;
+                entry.target = scaledRect(backdropTile->second.paintedRect, backdropRatio);
+                entry.texture = backdropTile->second.texture;
+                entry.scale = m_backdrop->scale;
+                clip.tiles.push_back(entry);
+            }
+            if (mapped.isEmpty() || clip.tiles.empty())
+                clip.fullyCovered = false;
+            if (!clip.fullyCovered)
+                ++draw.visibleHoles;
+            draw.backdrop.push_back(clip);
+        }
+    }
+
+    // The rect a composite of this store covers: V, or all of B when V is
+    // unknown - the same fallback the core uses, so the `out` line, the `comp`
+    // line and the number the driver reads are one number and not three.
+    IntRect effectiveVisibleRect() const
+    {
+        if (m_visible)
+            return *m_visible;
+        return IntRect(0, 0, m_bounds.width, m_bounds.height);
+    }
+
+    unsigned computeVisibleHoles() const
+    {
+        if (!m_primary)
+            return 0;
+        DrawList scratch;
+        ruleR8BuildDrawList(effectiveVisibleRect(), scratch);
+        return scratch.visibleHoles;
+    }
+
+    // ---------------------------------------------------------------------
+    // R5 - priority: jobs still queued are re-prioritised every pass, so a
+    // visible cell's replay is never served behind a non-visible one (I9).
+    // ---------------------------------------------------------------------
+
+    void ruleR5Reprioritise()
+    {
+        std::map<GridId, std::map<CellIndex, unsigned>> ranks;
+        unsigned rank = 0;
+        if (m_primary) {
+            for (CellIndex cell : m_primary->desired)
+                ranks[m_primary->id][cell] = rank++;
+        }
+        if (m_backdrop) {
+            for (CellIndex cell : m_backdrop->desired)
+                ranks[m_backdrop->id][cell] = rank++;
+        }
+        for (auto& entry : m_jobs) {
+            JobRecord& job = entry.second;
+            if (job.machine.state() != JobState::Queued)
+                continue;
+            auto grid = ranks.find(job.grid);
+            if (grid == ranks.end())
+                continue;
+            auto cell = grid->second.find(job.cell);
+            if (cell == grid->second.end())
+                continue;
+            job.priority = cell->second;
+        }
+    }
+
+    void collectGarbageJobs()
+    {
+        for (auto it = m_jobs.begin(); it != m_jobs.end();) {
+            const JobRecord& job = it->second;
+            const bool stale = job.machine.state() == JobState::Cancelled
+                && m_passCount > job.cancelledAtPass + constants::cancelledJobRetentionPasses;
+            if (stale)
+                it = m_jobs.erase(it);
+            else
+                ++it;
+        }
+    }
+
+    void countStates(PassOutput& out) const
+    {
+        auto count = [&out](const Grid* grid) {
+            if (!grid)
+                return;
+            for (const auto& entry : grid->tiles) {
+                switch (entry.second.machine.state()) {
+                case TileState::Missing:   ++out.missing; break;
+                case TileState::Rastering: ++out.rastering; break;
+                case TileState::Landed:    ++out.landed; break;
+                case TileState::Ready:     ++out.ready; break;
+                case TileState::Gone:      break;
+                }
+            }
+        };
+        count(m_primary.get());
+        count(m_backdrop.get());
+    }
+
+    // ---------------------------------------------------------------------
+
+    unsigned m_storeId;
+    ModelConfig m_config;
+    IllegalArrowObserver m_observer;
+    unsigned m_illegalArrows { 0 };
+    // Refusals and failed uploads applied since the last pass reported them.
+    // Counted here rather than into the PassOutput of the drain that applied
+    // them, because half of them are applied at the start of a composite, whose
+    // output is a DrawList and has nowhere to put the number.
+    unsigned m_refusedEvents { 0 };
+
+    PhaseMachine m_phase;
+    std::unique_ptr<Grid> m_primary;
+    std::unique_ptr<Grid> m_backdrop;
+    std::map<JobId, JobRecord> m_jobs;
+
+    GridId m_nextGridId { 1 };
+    JobId m_nextJobId { 1 };
+    TextureId m_nextTextureId { 1 };
+
+    IntSize m_bounds;
+    IntSize m_unscaledBounds;
+    float m_scale { 1.0f };
+    std::optional<IntRect> m_visible;
+    std::optional<IntRect> m_previousVisible;
+    IntPoint m_panDirection;
+    bool m_scaleChangedThisPass { false };
+    unsigned m_passCount { 0 };
+    unsigned m_compositeCount { 0 };
+    std::vector<TileEventRecord> m_inbox;
+};
