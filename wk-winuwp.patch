+
+class TileMachine {
+public:
+    TileState state() const
+    {
+        if (m_sm.is(sml::state<machine::tag::TileMissing>))   return TileState::Missing;
+        if (m_sm.is(sml::state<machine::tag::TileRastering>)) return TileState::Rastering;
+        if (m_sm.is(sml::state<machine::tag::TileLanded>))    return TileState::Landed;
+        if (m_sm.is(sml::state<machine::tag::TileReady>))     return TileState::Ready;
+        return TileState::Gone;
+    }
+    const char* stateName() const { return tileStateName(state()); }
+    static MachineKind kind() { return MachineKind::Tile; }
+
+    template<typename Event> bool process(const Event& e) { return m_sm.process_event(e); }
+
+private:
+    sml::sm<machine::Tile> m_sm;
+};
+
+class PatchMachine {
+public:
+    PatchState state() const
+    {
+        if (m_sm.is(sml::state<machine::tag::PatchNone>))     return PatchState::None;
+        if (m_sm.is(sml::state<machine::tag::PatchPending>))  return PatchState::Pending;
+        if (m_sm.is(sml::state<machine::tag::PatchInFlight>)) return PatchState::InFlight;
+        if (m_sm.is(sml::state<machine::tag::PatchLanded>))   return PatchState::Landed;
+        return PatchState::Gone;
+    }
+    const char* stateName() const { return patchStateName(state()); }
+    static MachineKind kind() { return MachineKind::Patch; }
+
+    template<typename Event> bool process(const Event& e) { return m_sm.process_event(e); }
+
+private:
+    sml::sm<machine::Patch> m_sm;
+};
+
+class GridMachine {
+public:
+    GridState state() const
+    {
+        if (m_sm.is(sml::state<machine::tag::GridPrimary>))    return GridState::Primary;
+        if (m_sm.is(sml::state<machine::tag::GridPersistent>)) return GridState::PersistentBackdrop;
+        if (m_sm.is(sml::state<machine::tag::GridTransient>))  return GridState::TransientBackdrop;
+        return GridState::Dropped;
+    }
+    const char* stateName() const { return gridStateName(state()); }
+    static MachineKind kind() { return MachineKind::Grid; }
+
+    template<typename Event> bool process(const Event& e) { return m_sm.process_event(e); }
+
+private:
+    sml::sm<machine::Grid> m_sm;
+};
+
+class JobMachine {
+public:
+    JobState state() const
+    {
+        if (m_sm.is(sml::state<machine::tag::JobQueued>))    return JobState::Queued;
+        if (m_sm.is(sml::state<machine::tag::JobRunning>))   return JobState::Running;
+        if (m_sm.is(sml::state<machine::tag::JobFinished>))  return JobState::Finished;
+        if (m_sm.is(sml::state<machine::tag::JobCancelled>)) return JobState::Cancelled;
+        return JobState::Failed;
+    }
+    const char* stateName() const { return jobStateName(state()); }
+    static MachineKind kind() { return MachineKind::Job; }
+
+    template<typename Event> bool process(const Event& e) { return m_sm.process_event(e); }
+
+private:
+    sml::sm<machine::Job> m_sm;
+};
+
+class PhaseMachine {
+public:
+    PhaseState state() const
+    {
+        if (m_sm.is(sml::state<machine::tag::PhaseIdle>))   return PhaseState::Idle;
+        if (m_sm.is(sml::state<machine::tag::PhaseInPass>)) return PhaseState::InPass;
+        return PhaseState::InComposite;
+    }
+    const char* stateName() const { return phaseStateName(state()); }
+    static MachineKind kind() { return MachineKind::Phase; }
+
+    template<typename Event> bool process(const Event& e) { return m_sm.process_event(e); }
+
+private:
+    sml::sm<machine::Phase> m_sm;
+};
+
+// The one place a machine is stepped. `report` is called with the arrow that
+// was refused; the machine stays where it was.
+template<typename Machine, typename Event, typename Reporter>
+inline bool step(Machine& m, const Event& e, const Reporter& report)
+{
+    const char* from = m.stateName();
+    if (m.process(e))
+        return true;
+    report(IllegalArrow { Machine::kind(), from, Event::name });
+    return false;
+}
