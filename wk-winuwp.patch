+   ...);
+#else
+  (void)aux::swallow{0, (sm.current_state_[aux::get_id<state_t, THs>((typename T::initial_states_ids_t *)0)] =
+                             aux::get_id<state_t, THs>((typename T::states_ids_t *)0),
+                         0)...};
+#endif
