+// ---------------------------------------------------------------------------
+// Globals: the pan level, the hole accumulator, the live store list. Engine
+// thread only - stores are created, walked and destroyed there - so plain
+// variables.
+// ---------------------------------------------------------------------------
+
+static bool s_wkTileGridPanGesture = false;
+static unsigned s_wkTileGridVisibleHoles = 0;
+
+static Vector<TextureMapperTileGridStore*>& wkLiveGridStores()
+{
+    static NeverDestroyed<Vector<TextureMapperTileGridStore*>> stores;
+    return stores.get();
+}
+
+unsigned wkWinUWPTexmapVisibleHoles()
+{
+    const unsigned holes = s_wkTileGridVisibleHoles;
+    s_wkTileGridVisibleHoles = 0;
