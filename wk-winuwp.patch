+
+#pragma once
+
+// Apotheosis (M4 load): align DOM timers onto a coarse grid while the WinUWP driver's load
+// pump owns the engine thread.
+//
+// Measured on the Lumia (the ApoLoadPhase buckets of a device session): a warm
+// news-site load spends 1030 ms of its 2508 ms of off-pump main-thread time in `timers` and 867 ms
+// in `js`, i.e. the consent/analytics stack's setTimeout chains, and a further 911 ms in
+// `style`. A tech-news site: 1428 ms of style behind 683 ms of js. On a 2-core Snapdragon 808 that work
+// competes with the parser, the first style resolution and the first paint - the things the user
+// is actually waiting for.
+//
+// WebCore already has the machinery: ScriptExecutionContext::alignedFireTime() rounds a DOM
+// timer's fire time up to Document::domTimerAlignmentInterval(). What it does not have is a
+// reason to use it here - every Page-level alignment source (hiddenPageDOMTimerThrottling,
+// low-power mode, non-interacted cross-origin frames) is gated on the page being hidden, idle or
+// third-party, and this page is visible, busy and first-party. So add one source that the port
+// controls, and let it apply for the length of the load window only.
+//
+// Two levels, both in milliseconds, both 0 = off:
+//   g_apoLoadTimerAlignMs        every DOM timer of every document (250 ms in the driver)
+//   g_apoLoadTimerNestedAlignMs  timers that reached WebCore's maximum nesting level, i.e. the
+//                                setTimeout(f, 0) chains a poller degenerates into (1 s)
+//
+// Alignment, not a minimum interval, on purpose. A timer is never dropped and never delayed by
+// more than one grid step; what changes is that a burst of unrelated timers lands in *one*
+// run-loop wake-up, so the page pays one script entry and one style resolution for the lot
+// instead of one each. Restoring the value re-aligns the timers already scheduled, because the
+// driver calls Document::didChangeTimerAlignmentInterval() on both edges.
+//
+// Scope and safety. The driver arms this from inside pumpLoop and disarms it when the pump
+// returns (t_settle), so the window is exactly "the navigation the user is waiting for" and the
+// flag cannot survive it. User input cannot be starved by it either: while the pump holds the
+// engine thread no C ABI call is serviced at all, so by the time input is processed the window
+// is already closed.
+//
+// requestAnimationFrame is deliberately left alone. On this port rAF only runs from
+// Page::isolatedUpdateRendering(), which the pump calls once per 50 ms tick, so it is already
+// paced by the pump and a second throttle would only add jitter.
+
+#include <wtf/Seconds.h>
+
+#if defined(WK_WINUWP)
+
+#include <atomic>
+
+namespace WTF {
+
+inline std::atomic<unsigned> g_apoLoadTimerAlignMs { 0 };
+inline std::atomic<unsigned> g_apoLoadTimerNestedAlignMs { 0 };
+
+// The alignment the load window asks for, 0_s when it is not armed. Two relaxed loads of a
+// non-contended cache line per timer reschedule; nothing else in the hot path.
+inline Seconds apoLoadTimerAlignment(bool hasReachedMaxNestingLevel)
+{
+    unsigned ms = g_apoLoadTimerAlignMs.load(std::memory_order_relaxed);
+    if (hasReachedMaxNestingLevel) {
+        const unsigned nested = g_apoLoadTimerNestedAlignMs.load(std::memory_order_relaxed);
+        if (nested > ms)
+            ms = nested;
+    }
+    return ms ? Seconds::fromMilliseconds(ms) : 0_s;
+}
+
+inline bool apoLoadTimerThrottleActive()
+{
+    return g_apoLoadTimerAlignMs.load(std::memory_order_relaxed)
+        || g_apoLoadTimerNestedAlignMs.load(std::memory_order_relaxed);
+}
+
+} // namespace WTF
+
+#endif // defined(WK_WINUWP)
diff --git a/Source/WTF/wtf/Assertions.cpp b/Source/WTF/wtf/Assertions.cpp
index 7c39f58f40..9102cdf8be 100644
--- a/Source/WTF/wtf/Assertions.cpp
+++ b/Source/WTF/wtf/Assertions.cpp
@@ -130,6 +130,132 @@ void disableForwardingVPrintfStdErrToOSLog()
 
 } // namespace WTF
 
+#if defined(WK_WINUWP)
+// Apotheosis: Windows 10 Mobile's WER writes no dump for the terminations this
+// port ends up in (CRASH() is std::abort(), whose UWP CRT tail is __fastfail,
+// and WTFCrash()/WTFBreakpointTrap() is a bkpt trap) — on device a fatal
+// RELEASE_ASSERT is indistinguishable from a silent exit. So WTF offers a
+// process-wide hook that the port driver (port/WebCoreDriver.cpp) installs at
+// startup; it writes the reason plus a captured stack into LocalState\crash.txt
+// before the process goes down. No header change on purpose: the driver
+// declares WTFWinUWPSetCrashHook() itself, so this stays a one-file rebuild.
+// The hook is called at the top of every fatal path below, i.e. *before* the
+// trap executes, so the stack it captures is the crashing stack.
+static void (*g_wkWinUWPCrashHook)(const char* reason) = nullptr;
+static bool g_wkWinUWPCrashHookFired = false;
+static char g_wkWinUWPStagedReason[512] = { 0 };
+
+WTF_EXPORT_PRIVATE void WTFWinUWPSetCrashHook(void (*hook)(const char* reason))
+{
+    g_wkWinUWPCrashHook = hook;
+    g_wkWinUWPCrashHookFired = false;
+    g_wkWinUWPStagedReason[0] = 0;
+}
+
+// Apotheosis: the WTFReport* functions run immediately before the CRASH() that
+// follows them and are the only place that carries file/line/assertion text.
+// They do not fire the hook themselves (that would burn the one-shot on a
+// report that does not crash); they park the text so the crash function below
+// can emit it as part of the single crash.txt entry.
+static void wkWinUWPStageCrashReason(const char* tag, const char* file, int line, const char* function, const char* detail)
+{
+    if (!g_wkWinUWPCrashHook || g_wkWinUWPCrashHookFired)
+        return;
+    snprintf(g_wkWinUWPStagedReason, sizeof(g_wkWinUWPStagedReason), "%s: %s at %s:%d in %s",
+        tag, detail ? detail : "(none)", file ? file : "?", line, function ? function : "?");
+}
+
+// Apotheosis: fires the hook at most once per process (a crash while logging a
+// crash must not recurse).
+static void wkWinUWPFireCrashHook(const char* reason)
+{
+    if (!g_wkWinUWPCrashHook || g_wkWinUWPCrashHookFired)
+        return;
+    g_wkWinUWPCrashHookFired = true;
+    char buffer[768];
+    if (g_wkWinUWPStagedReason[0])
+        snprintf(buffer, sizeof(buffer), "%s | %s", reason ? reason : "CRASH", g_wkWinUWPStagedReason);
+    else
+        snprintf(buffer, sizeof(buffer), "%s", reason ? reason : "CRASH");
+    g_wkWinUWPCrashHook(buffer);
+}
+
+#if ENABLE(CONJECTURE_ASSERT)
+// Apotheosis: fire with a call site the crash function itself knows.
+static void wkWinUWPFireCrashHookAt(const char* tag, const char* file, int line, const char* function, const char* detail)
+{
+    if (!g_wkWinUWPCrashHook || g_wkWinUWPCrashHookFired)
+        return;
+    char buffer[512];
+    snprintf(buffer, sizeof(buffer), "%s: %s at %s:%d in %s",
+        tag, detail ? detail : "(none)", file ? file : "?", line, function ? function : "?");
+    wkWinUWPFireCrashHook(buffer);
+}
+#endif // ENABLE(CONJECTURE_ASSERT)
+
+// Apotheosis: notes that do *not* end the process. They deliberately bypass
+// g_wkWinUWPCrashHookFired (which is the one-shot for fatal paths) and instead carry their own
+// small budget, so a leak that repeats cannot fill LocalState\crash.txt, and so a real crash
+// afterwards still gets its entry.
+static unsigned g_wkWinUWPNoteBudget = 16;
+
+static void wkWinUWPFireNonFatalNote(const char* text)
+{
+    if (!g_wkWinUWPCrashHook || g_wkWinUWPCrashHookFired || !g_wkWinUWPNoteBudget)
+        return;
+    --g_wkWinUWPNoteBudget;
+    g_wkWinUWPCrashHook(text);
+}
+
+// Apotheosis: WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR is about to zero and leak an object that
+// still has CheckedPtrs on it. Upstream says nothing here and aborts much later, in an
+// unrelated CheckedPtr destructor; this names the class while the deleting stack is still live.
+void WTFWinUWPReportCheckedPtrDeletion(const char* className, unsigned checkedPtrCount)
+{
+    char buffer[512];
+    snprintf(buffer, sizeof(buffer), "checked-ptr: %s deleted with %u CheckedPtr(s) outstanding (zeroed and leaked)",
+        className ? className : "?", checkedPtrCount);
+    wkWinUWPFireNonFatalNote(buffer);
+}
+
+// Apotheosis: the delayed half of the same bug - the last CheckedPtr to such an object going
+// away. Survivable here (see CheckedRef.h), so it is a note, not a crash.
+void WTFWinUWPReportDanglingCheckedPtr()
+{
+    wkWinUWPFireNonFatalNote("checked-ptr: released a CheckedPtr to an already-deleted object");
+}
+
+// Apotheosis: reason/misc payload of the CRASH_WITH_INFO()/RELEASE_ASSERT family.
+// Apotheosis: entry for the header-side WTFCrashWithInfo(line, file, function, counter) - a plain
+// RELEASE_ASSERT(x) whose only information is its location.
+void WTFWinUWPReportCrashLocation(int line, const char* file, const char* function)
+{
+    char buffer[512];
+    snprintf(buffer, sizeof(buffer), "WTF RELEASE_ASSERT at %s:%d in %s", file ? file : "?", line, function ? function : "?");
+    wkWinUWPFireCrashHook(buffer);
+}
+
+static void wkWinUWPFireCrashHookWithInfo(int line, const char* file, const char* function, int counter, unsigned count, const uint64_t* values)
+{
+    if (!g_wkWinUWPCrashHook || g_wkWinUWPCrashHookFired)
+        return;
+    char buffer[512];
+    int n = snprintf(buffer, sizeof(buffer), "CRASH_WITH_INFO at %s:%d in %s (counter %d)",
+        file ? file : "?", line, function ? function : "?", counter);
+    if (n < 0)
+        n = 0;
+    for (unsigned i = 0; i < count && static_cast<size_t>(n) + 1 < sizeof(buffer); ++i) {
+        int m = i
+            ? snprintf(buffer + n, sizeof(buffer) - n, " misc%u=0x%llx", i, static_cast<unsigned long long>(values[i]))
+            : snprintf(buffer + n, sizeof(buffer) - n, " reason=0x%llx", static_cast<unsigned long long>(values[i]));
+        if (m < 0)
+            break;
+        n += m;
+    }
+    wkWinUWPFireCrashHook(buffer);
+}
+#endif // defined(WK_WINUWP)
+
