-void WebResourceLoadScheduler::preconnectTo(FrameLoader&, ResourceRequest&&, StoredCredentialsPolicy, ShouldPreconnectAsFirstParty, PreconnectCompletionHandler&&)
+#if defined(WK_WINUWP)
+
+// Apotheosis(WK_WINUWP): DNS prefetch for <link rel="dns-prefetch"> and for the DNS
+// half of <link rel="preconnect"> (LinkLoader::preconnectIfNeeded / FrameLoader::
+// prefetchDNSIfNeeded). WebCore::prefetchDNS() is a dead end in the curl port:
+// DNSResolveQueueCurl::platformResolve() and updateIsUsingProxy() are notImplemented()
+// stubs, and since DNSResolveQueue::m_isUsingProxy starts out true and is never
+// updated, DNSResolveQueue::add() drops every hostname before it can resolve.
+// So resolve here, in the driver: a plain getaddrinfo() on a background queue, which
+// warms the Windows resolver cache that libcurl's own getaddrinfo() hits moments later.
+// Also called by LoadingFrameLoaderClient::prefetchDNS() (port/, same link unit).
+void apotheosisPrefetchDNS(const String& hostname)
 {
+    if (hostname.isEmpty() || hostname.length() > 255)
+        return;
+
+    // The set is never pruned, so cap it. A page referencing more hosts than this gets
+    // no prefetch for the tail - which is what WebCore's own queue does as well.
+    static constexpr unsigned maxPrefetchedHostnames = 128;
+    static NeverDestroyed<HashSet<String>> prefetchedHostnames;
+    static Lock prefetchedHostnamesLock;
+    {
+        Locker locker { prefetchedHostnamesLock };
+        if (prefetchedHostnames->size() >= maxPrefetchedHostnames)
+            return;
+        if (!prefetchedHostnames->add(hostname.isolatedCopy()).isNewEntry)
+            return;
+    }
+
+    static WorkQueue& queue = WorkQueue::create("Apotheosis DNS prefetch"_s).leakRef();
+    queue.dispatch([host = hostname.isolatedCopy()] {
+        // curl_global_init() normally does this, but a dns-prefetch can beat the first
+        // curl transfer. WSAStartup() is reference counted, so calling it again is safe.
+        static bool winsockInitialized = [] {
+            WSADATA data { };
+            return !WSAStartup(MAKEWORD(2, 2), &data);
+        }();
+        if (!winsockInitialized)
+            return;
+
+        struct addrinfo hints { };
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_socktype = SOCK_STREAM;
+        struct addrinfo* result = nullptr;
+        if (!getaddrinfo(host.utf8().data(), nullptr, &hints, &result) && result)
+            freeaddrinfo(result);
+    });
+}
+
+#endif // defined(WK_WINUWP)
+
+void WebResourceLoadScheduler::preconnectTo(FrameLoader&, ResourceRequest&& request, StoredCredentialsPolicy, ShouldPreconnectAsFirstParty, PreconnectCompletionHandler&& completionHandler)
+{
+#if defined(WK_WINUWP)
+    // Apotheosis(WK_WINUWP): DNS-only preconnect. libcurl has no preconnect primitive.
+    // The closest thing, CURLOPT_CONNECT_ONLY, deliberately takes its connection out of
+    // the pool: such a transfer neither reuses an existing connection nor lets any other
+    // easy handle reuse the one it opened. That also holds for CURLOPT_CONNECT_ONLY=2
+    // (curl 7.86+), which does complete the TLS handshake but binds the connection to
+    // that one easy handle. A CONNECT_ONLY warm-up would therefore burn a TCP+TLS
+    // connection the real request can never touch. What CurlContext's CURLSH handle does
+    // share across easy handles is DNS (CURL_LOCK_DATA_DNS, CurlContext.cpp), so warming
+    // the resolver is the one part of preconnect that pays off here - do that, nothing
+    // more. The completion handler is dropped on purpose (as in the upstream stub):
+    // invoking it logs "Successfully preconnected to ..." into the page console, and we
+    // did not preconnect.
+    apotheosisPrefetchDNS(request.url().host().toString());
+    UNUSED_PARAM(completionHandler);
+#else
+    UNUSED_PARAM(request);
+    UNUSED_PARAM(completionHandler);
+#endif
 }
diff --git a/Source/cmake/OptionsWinUWP.cmake b/Source/cmake/OptionsWinUWP.cmake
new file mode 100644
index 0000000000..93d42a527c
--- /dev/null
+++ b/Source/cmake/OptionsWinUWP.cmake
@@ -0,0 +1,391 @@
+# Apotheosis: port options for WinUWP (Windows 10 Mobile ARM32, UWP App Container).
+#
+# Reconstructed from the author's drafts (port/draft-OptionsWinUWP-webcore-block.cmake)
+# and modeled on Source/cmake/OptionsWin.cmake. This port builds WTF + JavaScriptCore +
+# WebCore as STATIC libraries only; the UWP host links them through the out-of-tree
+# WebCoreDriver (port/*.cpp) over a stable C ABI. There is no WebKit/WebKitLegacy UI
+# process, no Tools, no tests.
+#
+# Two graphics configurations share this file:
+#   * software (default)      : Cairo image surfaces -> WriteableBitmap
+#   * -DAPOTHEOSIS_GPU=ON     : + TextureMapper on prebuilt (NuGet) ANGLE -> SwapChainPanel
+#
+# Every deviation from OptionsWin.cmake is either an App Container restriction
+# (no GDI/user32/MediaFoundation/desktop CryptoAPI) or an ARM32 restriction
+# (no FTL, no in-tree ANGLE build for thumbv7).
+
+# -----------------------------------------------------------------------------
+# Compiler flags. NOT include(OptionsMSVC): that module hard-requires
+# clang_rt.builtins-x86_64, which does not exist for thumbv7. Everything else
+# from it is replicated below.
+# -----------------------------------------------------------------------------
+if (MSVC)
+    function(MSVC_ADD_COMPILE_OPTIONS)
+        foreach (_option ${ARGV})
+            add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:${_option}>)
+        endforeach ()
+    endfunction()
+
+    # Use AT&T syntax for inline asm
+    MSVC_ADD_COMPILE_OPTIONS(/clang:-masm=att)
+
+    # Create pdb files for debugging purposes, also for Release builds
+    MSVC_ADD_COMPILE_OPTIONS(/Zi /GS)
+
+    add_link_options(/DEBUG /OPT:NOICF /OPT:REF)
+
+    # Apotheosis: exceptions must stay off. clang's thumbv7-windows-msvc backend
+    # cannot lower cleanupret (Windows unwinding), see CLAUDE.md.
+    add_definitions(-D_HAS_EXCEPTIONS=0)
+    string(REGEX REPLACE "/EH[-a-z]+" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
+    MSVC_ADD_COMPILE_OPTIONS(/EHa- /EHc- /EHs- /fp:except-)
+
+    # Disable RTTI
+    string(REGEX REPLACE "/GR-?" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
+    MSVC_ADD_COMPILE_OPTIONS(/GR-)
+
+    MSVC_ADD_COMPILE_OPTIONS(/analyze- /bigobj)
+
+    add_definitions(-D_CRT_SECURE_NO_WARNINGS)
+    add_definitions(-D_ENABLE_EXTENDED_ALIGNED_STORAGE)
+
+    MSVC_ADD_COMPILE_OPTIONS(/utf-8 /validate-charset)
+
+    if (NOT ${CMAKE_GENERATOR} MATCHES "Ninja")
+        MSVC_ADD_COMPILE_OPTIONS(/MP)
+    endif ()
+
+    string(REGEX REPLACE "/W3" "" CMAKE_C_FLAGS "${CMAKE_C_FLAGS}")
+    string(REGEX REPLACE "/W3" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
+    WEBKIT_PREPEND_GLOBAL_COMPILER_FLAGS(/W4)
+    WEBKIT_PREPEND_GLOBAL_COMPILER_FLAGS(/Zc:dllexportInlines-)
+
+    add_link_options(/INCREMENTAL:NO)
+
+    # Apotheosis: the LLVM Windows installer ships only clang_rt.builtins-x86_64.
+    # A thumbv7 builtins library is optional here (the MSVC ARM CRT provides the
+    # __rt_*/__aeabi_* helpers); link it only if someone cross-built one.
+    string(REGEX MATCH "^[0-9]+" CLANG_CL_MAJOR_VERSION ${CMAKE_CXX_COMPILER_VERSION})
+    cmake_path(REMOVE_FILENAME CMAKE_CXX_COMPILER OUTPUT_VARIABLE CLANG_CL_DIR)
+    cmake_path(APPEND CLANG_CL_DIR "../lib/clang" ${CLANG_CL_MAJOR_VERSION} "lib/windows")
+    find_library(CLANG_BUILTINS_LIBRARY
+        NAMES clang_rt.builtins-arm clang_rt.builtins-armhf
+        PATHS ${CLANG_CL_DIR}
+        NO_DEFAULT_PATH
+    )
+    if (CLANG_BUILTINS_LIBRARY)
+        link_libraries(${CLANG_BUILTINS_LIBRARY})
+    endif ()
+endif ()
+
+# -----------------------------------------------------------------------------
+# Windows / App Container preprocessor environment.
+# WINAPI_FAMILY, WK_WINUWP and the UWP umbrella import library come from
+# port/Toolchain-ARM32-UWP-clang.cmake; only the port-neutral bits live here.
+# -----------------------------------------------------------------------------
+add_definitions(-D_WINDOWS -DNTDDI_VERSION=0x0A000006 -D_WIN32_WINNT=0x0A00)
+add_definitions(-DNOMINMAX)
+add_definitions(-DUNICODE -D_UNICODE)
+add_definitions(-DNOCRYPT)
+add_definitions(-D_CRT_NONSTDC_NO_DEPRECATE)
+add_definitions(-D_SILENCE_CXX23_DENORM_DEPRECATION_WARNING)
+add_definitions(-D_WINSOCKAPI_=)
+
+if (DEFINED ENV{WEBKIT_IGNORE_PATH})
+    list(APPEND CMAKE_IGNORE_PATH $ENV{WEBKIT_IGNORE_PATH})
+endif ()
+
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
+
+# Apotheosis: PCHs are of no use to us (the driver compiles out of tree) and they
+# multiply the ARM32 build cost.
+set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
+
+# -----------------------------------------------------------------------------
+# What gets built. Engine only: no UI process, no legacy WebKit, no inspector
+# front end, no Tools (DumpRenderTree/WebKitTestRunner are desktop-only).
+# -----------------------------------------------------------------------------
+set(ENABLE_WEBCORE ON)
+set(ENABLE_WEBKIT OFF)
+set(ENABLE_WEBKIT_LEGACY OFF)
+set(ENABLE_WEBINSPECTORUI OFF)
+set(ENABLE_TOOLS OFF)
+set(ENABLE_API_TESTS OFF)
+
+# -----------------------------------------------------------------------------
+# Feature options
+# -----------------------------------------------------------------------------
+WEBKIT_OPTION_BEGIN()
+
+# JavaScriptCore is linked statically into WebCoreDriver-*.dll.
+WEBKIT_OPTION_DEFINE(ENABLE_STATIC_JSC "Whether to build JavaScriptCore as a static library." PUBLIC ON)
+
+# --- JSC: ARMv7/Thumb-2 baseline JIT only. FTL is impossible on ARM32, and DFG
+#     is off in the author's shipping configuration (see PLAN.md M4).
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_JIT                PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DFG_JIT            PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTL_JIT            PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SAMPLING_PROFILER  PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY        PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_REMOTE_INSPECTOR   PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC         PRIVATE ON)
+
+# --- test / tooling targets that have no meaning on a phone ---
+# ENABLE_JAVASCRIPT_SHELL builds the jsc executable, which cannot run on the
+# build host anyway (thumbv7 App Container). It also trips over
+# _WEBKIT_TARGET_LINK_FRAMEWORK: with every framework STATIC no target ever
+# records a *_LINKED_INTO property, and the empty right-hand side of its
+# STREQUAL is a hard parse error on CMake 4.x.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_JAVASCRIPT_SHELL   PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_API_TESTS          PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_LAYOUT_TESTS       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MINIBROWSER        PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBDRIVER          PRIVATE OFF)
+
+# --- graphics / GPU ---
+# WebGL stays off in both configurations: the GPU path composites through
+# TextureMapper, it does not expose a WebGL context to content.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGL              PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGPU             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBXR              PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GPU_PROCESS        PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_OFFSCREEN_CANVAS   PRIVATE OFF)
+
+# --- media: none. This is also how the whole MediaFoundation link block and
+#     the only DirectWrite reference are dropped.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO                  PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUDIO              PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SOURCE           PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STREAM           PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_RTC                PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_LEGACY_ENCRYPTED_MEDIA PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ENCRYPTED_MEDIA        PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STATISTICS       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPEECH_SYNTHESIS       PRIVATE OFF)
+
+# --- desktop-shell features that the App Container cannot provide ---
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DRAG_SUPPORT            PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CONTEXT_MENUS           PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FULLSCREEN_API          PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GAMEPAD                 PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GEOLOCATION             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DEVICE_ORIENTATION      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_NOTIFICATIONS           PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPELLCHECK              PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_RESOURCE_USAGE          PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_PERIODIC_MEMORY_MONITOR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CURSOR_VISIBILITY       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MOUSE_CURSOR_SCALE      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_POINTER_LOCK            PRIVATE OFF)
+
+# --- heavy / optional subsystems trimmed for first bring-up ---
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_XSLT                  PRIVATE OFF)  # drops LibXslt
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MATHML                PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SMOOTH_SCROLLING      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ASYNC_SCROLLING       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DARK_MODE_CSS         PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VARIATION_FONTS       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_TOUCH_EVENTS          PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_PAYMENT_REQUEST       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUTHN             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SERVICE_CONTROLS      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CONTENT_EXTENSIONS    PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MHTML                 PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ATTACHMENT_ELEMENT    PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_APPLICATION_MANIFEST  PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTPDIR                PRIVATE OFF)
+
+# --- backend selection (these are WEBKIT_OPTION entries, not plain variables) ---
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA   PRIVATE OFF)  # CRITICAL: selects the Cairo branch
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2  PRIVATE OFF)  # drops the WOFF2 + Brotli requirement
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_AVIF   PRIVATE OFF)  # drops the libavif requirement
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_JPEGXL PRIVATE OFF)  # drops the libjxl requirement
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_LCMS   PRIVATE OFF)  # drops the lcms2 requirement
+# NOTE: USE_AVIF, USE_JPEGXL and USE_LCMS all default to ON in 2.52.4. Leaving
+# any of them at its default makes WebCore link AVIF::/JPEGXL::/LCMS2:: targets
+# that this port never finds a package for.
+
+WEBKIT_OPTION_END()
+
+# -----------------------------------------------------------------------------
+# USE_* build-time facts.
+# We do not include OptionsWin.cmake, so everything OptionsWin exposes and we
+# still need has to be repeated here.
+# -----------------------------------------------------------------------------
+SET_AND_EXPOSE_TO_BUILD(USE_CAIRO          ON)   # software raster + the GPU path's tile paint
+SET_AND_EXPOSE_TO_BUILD(USE_FREETYPE       ON)
+SET_AND_EXPOSE_TO_BUILD(USE_FONTCONFIG     ON)
+SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ       ON)
+SET_AND_EXPOSE_TO_BUILD(USE_CURL           ON)   # the only ResourceLoader backend wired up
+SET_AND_EXPOSE_TO_BUILD(USE_OPENSSL        ON)   # curl's TLS/crypto backend
+SET_AND_EXPOSE_TO_BUILD(USE_THEME_ADWAITA  ON)   # Cairo-painted RenderTheme, never UxTheme/GDI
