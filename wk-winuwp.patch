+// Apotheosis: implementation of the TileGrid v2 store core
+// (docs/TILEGRID-DESIGN.md section 5.1). See the header for what it is for.
+//
+// The whole file is bookkeeping between the model's ids and the backends'
+// handles. It decides nothing the model could decide; the review checklist of
+// section 6 ("the store never decides anything the model could") is meant to be
+// checkable by reading it.
+
+#include "TextureMapperTileGridCore.h"
+
+#include <algorithm>
+#include <map>
+#include <set>
+
+namespace WebCore {
+namespace TileGrid {
+
+namespace {
+
+// A landed pixel buffer belongs to a (grid, cell, first paint | patch) slot -
+// never to a job id, because the job record is gone by the time the upload
+// happens, and never to a tile pointer, because there are none here.
+struct BufferKey {
+    GridId grid { invalidGridId };
+    int column { 0 };
+    int row { 0 };
+    bool isPatch { false };
+};
+
+bool operator<(const BufferKey& a, const BufferKey& b)
+{
+    if (a.grid != b.grid)
+        return a.grid < b.grid;
+    if (a.row != b.row)
+        return a.row < b.row;
+    if (a.column != b.column)
+        return a.column < b.column;
+    return static_cast<int>(a.isPatch) < static_cast<int>(b.isPatch);
+}
+
+BufferKey keyOf(GridId grid, CellIndex cell, bool isPatch)
+{
+    BufferKey key;
+    key.grid = grid;
+    key.column = cell.column;
+    key.row = cell.row;
+    key.isPatch = isPatch;
+    return key;
+}
+
+} // namespace
+
+class TileGridCore::Impl {
+public:
+    struct JobRecord {
+        JobHandle handle { invalidJobHandle };
+        GridId grid { invalidGridId };
+        CellIndex cell;
+        IntRect rect;
+        bool isPatch { false };
+        bool sync { false };
+    };
+
+    struct TextureRecord {
+        TextureHandle handle { invalidTextureHandle };
+        GridId grid { invalidGridId };
+        CellIndex cell;
+        IntSize size;
+        bool reclaimed { false };   // the pool took it back; do not release it again
+    };
+
+    Impl(unsigned storeId, RasterBackend& raster, TextureBackend& textures, const CoreConfig& config)
+        : m_config(config)
+        , m_raster(raster)
+        , m_textureBackend(textures)
+        , m_model(storeId, config.model)
+    {
+    }
+
+    // -----------------------------------------------------------------------
+    // Backend -> model. Called at exactly two points, BeginPass and
+    // BeginComposite (I17). The model queues what arrives here and applies it
+    // itself at the top of runPass()/composite().
+    // -----------------------------------------------------------------------
+
+    void drainBackends()
+    {
+        for (const RasterEvent& event : m_raster.poll()) {
+            auto handle = m_jobIdByHandle.find(event.job);
+            if (handle == m_jobIdByHandle.end())
+                continue; // a job we already cancelled and forgot (R5)
+            const JobId id = handle->second;
+            auto job = m_jobs.find(id);
+            if (job == m_jobs.end()) {
+                m_jobIdByHandle.erase(handle);
+                continue;
+            }
+
+            switch (event.kind) {
+            case RasterEventKind::Started:
+                m_model.noteReplayStarted(id);
+                continue;
+            case RasterEventKind::Finished:
+                m_buffers[keyOf(job->second.grid, job->second.cell, job->second.isPatch)] = event.pixels;
+                m_model.noteReplayFinished(id);
+                break;
+            case RasterEventKind::Failed:
+                m_model.noteReplayFailed(id);
+                break;
+            case RasterEventKind::Watchdog:
+                m_model.noteWatchdog(id);
+                break;
+            }
+            m_jobIdByHandle.erase(handle);
+            m_jobs.erase(job);
+        }
+
+        for (TextureHandle lost : m_textureBackend.takeReclaimedTextures()) {
+            auto it = m_textureIdByHandle.find(lost);
+            if (it == m_textureIdByHandle.end())
+                continue;
+            auto texture = m_textures.find(it->second);
+            if (texture == m_textures.end())
+                continue;
+            texture->second.reclaimed = true;
+            m_model.noteTextureLost(texture->second.grid, texture->second.cell);
+        }
+    }
+
+    // -----------------------------------------------------------------------
+    // Model -> backend
+    // -----------------------------------------------------------------------
+
+    void applyCancels(const std::vector<JobId>& cancels)
+    {
+        for (JobId id : cancels) {
+            auto job = m_jobs.find(id);
+            if (job == m_jobs.end())
+                continue;
+            m_raster.cancel(job->second.handle);
+            m_jobIdByHandle.erase(job->second.handle);
+            // Whatever that job had already produced is not wanted any more.
+            m_buffers.erase(keyOf(job->second.grid, job->second.cell, job->second.isPatch));
+            m_jobs.erase(job);
+        }
+    }
+
+    // I13: exactly once. A texture the pool already took back is dropped, not
+    // released a second time.
+    void applyReleased(const std::vector<TextureId>& released, unsigned& counter)
+    {
+        for (TextureId id : released) {
+            auto it = m_textures.find(id);
+            if (it == m_textures.end())
+                continue;
+            if (!it->second.reclaimed) {
+                m_textureBackend.release(it->second.handle);
+                ++counter;
+            }
+            m_textureIdByHandle.erase(it->second.handle);
+            m_textures.erase(it);
+        }
+    }
+
+    float scaleOfGrid(GridId id) const
+    {
+        const auto primary = m_model.primaryGrid();
+        if (primary && primary->id == id)
+            return primary->scale;
+        const auto backdrop = m_model.backdropGrid();
+        if (backdrop && backdrop->id == id)
+            return backdrop->scale;
+        return m_input.scale;
+    }
+
+    // R3/R5: one raster path. Every request becomes a job in the same priority
+    // queue; Sync only means the pass waits for it before it ends, and it waits
+    // for all of them at once so they replay on every worker in parallel.
+    void dispatch(const PassOutput& out)
+    {
+        std::vector<JobHandle> sync;
+        for (const PaintRequest& request : out.paints) {
+            const bool isSync = request.mode == PaintMode::Sync;
+            const JobHandle handle = m_raster.record(request.grid, request.cell, request.rect,
+                scaleOfGrid(request.grid), isSync);
+            if (handle == invalidJobHandle) {
+                // R5/I9: the model has already moved the tile to Rastering (or
+                // its patch to InFlight) with this job id. Dropping the refusal
+                // on the floor - which is what this used to do - left a tile in
+                // Rastering with nothing behind it, and R5 says a tile leaves
+                // Rastering only through ReplayFinished / ReplayFailed /
+                // Cancelled, so it stayed there for ever. The device showed it
+                // as `rast=4 land=0 ready=0` for thousands of passes on the
+                // sticky header of a news site (0.1.9.29, store S100). A refusal is a
+                // failed replay: the model puts the tile back to Missing and the
+                // next pass asks again.
+                m_model.noteRequestRefused(request.job);
+                ++m_refusedRequests;
+                continue;
+            }
+
+            JobRecord record;
+            record.handle = handle;
+            record.grid = request.grid;
+            record.cell = request.cell;
+            record.rect = request.rect;
+            record.isPatch = request.isPatch;
+            record.sync = isSync;
+            m_jobs[request.job] = record;
+            m_jobIdByHandle[handle] = request.job;
+            if (isSync)
+                sync.push_back(handle);
+        }
+
+        m_lastSyncJobs = static_cast<unsigned>(sync.size());
+        if (sync.empty())
+            return;
+        m_raster.waitFor(sync);
+        // The results are queued into the model's inbox; the model applies them
+        // at the start of the composite that follows in this same frame, which
+        // is where the GL context is current and R4 can upload them.
+        drainBackends();
+    }
+
+    // -----------------------------------------------------------------------
+    // Composite
+    // -----------------------------------------------------------------------
+
+    TextureHandle handleForUpload(const UploadRecord& record, unsigned& acquired)
+    {
+        auto it = m_textures.find(record.texture);
+        if (it != m_textures.end())
+            return it->second.handle;
+
+        TextureRecord texture;
+        texture.handle = m_textureBackend.acquire(record.rect.size());
+        texture.grid = record.grid;
+        texture.cell = record.cell;
+        texture.size = record.rect.size();
+        if (texture.handle == invalidTextureHandle)
+            return invalidTextureHandle;
+        ++acquired;
+        m_textures[record.texture] = texture;
+        m_textureIdByHandle[texture.handle] = record.texture;
+        m_acquiredThisComposite.insert(record.texture);
+        return texture.handle;
+    }
+
+    void appendTile(std::vector<DrawCommand>& into, const TileDraw& tile, bool backdrop, CompositeResult& result)
+    {
+        auto it = m_textures.find(tile.texture);
+        if (it == m_textures.end()) {
+            // The model says this tile is Ready, so it is not a hole and no
+            // backdrop is drawn under it - and yet nothing is drawn at all. That
+            // is a white cell the hole count cannot see, which is exactly what
+            // the device reported at 4x zoom (`ready=10 holes=0` over a white
+            // screen). It is a failed upload after the fact: tell the model, so
+            // the tile goes back to Missing and R3 repaints it.
+            ++result.drawsWithoutTexture;
+            // ... and the composite says so in the same breath. The model
+            // counted this cell as covered when it built the draw list; the
+            // store now knows better, and the number the driver reads has to be
+            // what is on the screen, not what was planned for it.
+            ++result.visibleHoles;
+            m_model.noteUploadFailed(tile.grid, tile.cell);
+            return;
+        }
+        DrawCommand command;
+        command.op = DrawOp::DrawTile;
+        command.rect = tile.target;
+        command.texture = it->second.handle;
+        command.grid = tile.grid;
+        command.cell = tile.cell;
+        command.scale = tile.scale;
+        command.backdrop = backdrop;
+        command.freshTexture = m_acquiredThisComposite.count(tile.texture) != 0;
+        command.paintedRect = tile.target;
+        into.push_back(command);
+    }
+
+    // A landed buffer whose tile no longer exists (removed by R2, cancelled by
+    // a scale change) would otherwise sit in the map forever.
+    void pruneBuffers()
+    {
+        if (m_buffers.empty())
+            return;
+        std::set<BufferKey> live;
+        for (const TileInfo& tile : m_model.tiles()) {
+            if (tile.state == TileState::Landed)
+                live.insert(keyOf(tile.grid, tile.cell, false));
+            if (tile.state == TileState::Rastering)
+                live.insert(keyOf(tile.grid, tile.cell, false));
+            if (tile.patch == PatchState::InFlight || tile.patch == PatchState::Landed)
+                live.insert(keyOf(tile.grid, tile.cell, true));
+        }
+        for (auto it = m_buffers.begin(); it != m_buffers.end();)
+            it = live.count(it->first) ? std::next(it) : m_buffers.erase(it);
+    }
+
+    IntRect compositeVisibleRect() const
+    {
+        if (m_input.visible)
+            return *m_input.visible;
+        return IntRect(0, 0, m_input.boundsScaled.width, m_input.boundsScaled.height);
+    }
+
+    CoreConfig m_config;
+    RasterBackend& m_raster;
+    TextureBackend& m_textureBackend;
+    TileGridModel m_model;
+    PassInput m_input;
+    IntRect m_dirty;
+
+    std::map<JobId, JobRecord> m_jobs;
+    std::map<JobHandle, JobId> m_jobIdByHandle;
+    std::map<BufferKey, PixelBuffer> m_buffers;
+    std::map<TextureId, TextureRecord> m_textures;
+    std::map<TextureHandle, TextureId> m_textureIdByHandle;
+    std::set<TextureId> m_acquiredThisComposite;
+
+    unsigned m_lastSyncJobs { 0 };
+    unsigned m_refusedRequests { 0 };
+    unsigned m_failedUploads { 0 };
+};
+
+// ---------------------------------------------------------------------------
+
+TileGridCore::TileGridCore(unsigned storeId, RasterBackend& raster, TextureBackend& textures, const CoreConfig& config)
+    : m_impl(std::make_unique<Impl>(storeId, raster, textures, config))
+{
+}
+
+TileGridCore::~TileGridCore() = default;
+
+void TileGridCore::setBounds(IntSize bounds) { m_impl->m_input.boundsScaled = bounds; }
+void TileGridCore::setScale(float scale) { m_impl->m_input.scale = scale; }
+void TileGridCore::setVisibleRect(const std::optional<IntRect>& visible) { m_impl->m_input.visible = visible; }
+void TileGridCore::setTileBudget(unsigned budget) { m_impl->m_input.tileBudget = budget; }
+void TileGridCore::setImageStore(bool isImage) { m_impl->m_input.isImage = isImage; }
+void TileGridCore::setThreadedRaster(bool threaded) { m_impl->m_input.threadedRaster = threaded; }
+void TileGridCore::setPanGesture(bool pan) { m_impl->m_input.panGesture = pan; }
+
+void TileGridCore::invalidate(const IntRect& rect)
+{
+    // R10: accumulate. The pass that consumes it decides what it means; it
+    // never adds, removes, hides or cancels anything here.
+    m_impl->m_dirty = m_impl->m_dirty.unite(rect);
+}
+
+PassOutput TileGridCore::runPass()
+{
+    Impl& impl = *m_impl;
+
+    impl.drainBackends();
+
+    impl.m_input.dirty = impl.m_dirty;
+    impl.m_dirty = IntRect();
+
+    PassOutput out = impl.m_model.runPass(impl.m_input);
+
+    // Cancels first: they free the worker slots and the in-flight buffers that
+    // the new requests are about to want (R5).
+    impl.applyCancels(out.cancels);
+    unsigned releasedCount = 0;
+    impl.applyReleased(out.released, releasedCount);
+    (void)releasedCount;
+    impl.dispatch(out);
+    impl.pruneBuffers();
+    return out;
+}
+
+CompositeResult TileGridCore::composite()
+{
+    Impl& impl = *m_impl;
+    CompositeResult result;
+
+    impl.m_textureBackend.beginComposite();
+    impl.drainBackends();
+
+    const IntRect visible = impl.compositeVisibleRect();
+    const unsigned maxUploads = std::min(impl.m_config.maxUploadsPerComposite,
+        impl.m_textureBackend.uploadsRemainingThisComposite());
+
+    DrawList draw = impl.m_model.composite(visible, maxUploads);
+
+    // R9 may have dropped a transient backdrop in there.
+    impl.applyCancels(draw.cancels);
+    impl.applyReleased(draw.released, result.texturesReleased);
+
+    // R4: the model decided what may be uploaded; here it actually happens.
+    //
+    // Both failure branches used to be a bare `continue`. The model has already
+    // committed the upload at that point (commitUpload() moved the tile to Ready
+    // and gave it a fresh TextureId), so a skipped upload left a Ready tile with
+    // a texture that had only been acquired - a pooled texture, reset() and
+    // therefore empty - or with no texture at all. Neither is a hole and neither
+    // draws anything: white where the model reports full coverage. R4 has to
+    // hear about it, and does.
+    //
+    // Device round 2: the model built `draw.tiles` before any of this ran, so a
+    // tile whose upload fails here is still in the list with a texture that
+    // was only acquired - cleared, or holding whatever the pool had in it. It
+    // was drawn regardless (I6: foreign pixels) and not counted as a hole. The
+    // textures that failed this composite are remembered and their tiles are
+    // holes below, never draws.
+    impl.m_acquiredThisComposite.clear();
+    std::set<TextureId> failedThisComposite;
+    for (const UploadRecord& record : draw.uploads) {
+        const TextureHandle handle = impl.handleForUpload(record, result.texturesAcquired);
+        if (handle == invalidTextureHandle) {
+            ++result.uploadsFailed;
+            failedThisComposite.insert(record.texture);
+            impl.m_model.noteUploadFailed(record.grid, record.cell);
+            continue;
+        }
+        auto buffer = impl.m_buffers.find(keyOf(record.grid, record.cell, record.isPatch));
+        if (buffer == impl.m_buffers.end()) {
+            ++result.uploadsFailed;
+            failedThisComposite.insert(record.texture);
+            impl.m_model.noteUploadFailed(record.grid, record.cell);
+            continue;
+        }
+        const bool uploaded = impl.m_textureBackend.upload(handle, buffer->second, record.rect);
+        impl.m_buffers.erase(buffer);
+        if (!uploaded) {
+            ++result.uploadsFailed;
+            failedThisComposite.insert(record.texture);
+            impl.m_model.noteUploadFailed(record.grid, record.cell);
+            continue;
+        }
+        ++result.uploads;
+        if (record.budgetExempt)
+            ++result.uploadsBudgetExempt;
+    }
+
+    // R8: primary Ready tiles, then one clip per visible primary cell without
+    // one. Exactly one source per visible pixel, by construction. The two
+    // counters are taken from the model here and only ever grow below, where the
+    // store finds a cell it cannot actually draw.
+    result.visibleCells = draw.visibleCells;
+    result.visibleHoles = draw.visibleHoles;
+    for (const TileDraw& tile : draw.tiles) {
+        if (failedThisComposite.count(tile.texture)) {
+            // Reported to the model above; on screen it is a hole this frame.
+            // The backdrop was not clipped to this cell (the model thought it
+            // covered), so the cell shows the layer background until the next
+            // composite - still better than a texture of unknown content.
+            ++result.visibleHoles;
+            continue;
+        }
+        impl.appendTile(result.commands, tile, false, result);
+    }
+
+    for (const BackdropClip& clip : draw.backdrop) {
+        if (clip.tiles.empty())
+            continue;
+        DrawCommand begin;
+        begin.op = DrawOp::BeginClip;
+        begin.rect = clip.clip;
+        begin.cell = clip.cell;
+        result.commands.push_back(begin);
+        for (const TileDraw& tile : clip.tiles)
+            impl.appendTile(result.commands, tile, true, result);
+        DrawCommand end;
+        end.op = DrawOp::EndClip;
+        end.rect = clip.clip;
+        end.cell = clip.cell;
+        result.commands.push_back(end);
+        ++result.backdropClips;
+    }
+
+    for (const TileInfo& tile : impl.m_model.tiles()) {
+        if (tile.state == TileState::Landed || tile.patch == PatchState::Landed)
+            ++result.uploadsDeferred;
+    }
+
+    impl.m_failedUploads += result.uploadsFailed + result.drawsWithoutTexture;
+    impl.pruneBuffers();
+    return result;
+}
+
+bool TileGridCore::wantsPass() const { return m_impl->m_model.wantsPass(); }
+unsigned TileGridCore::visibleHoles() const { return m_impl->m_model.visibleHoles(); }
+
+const TileGridModel& TileGridCore::model() const { return m_impl->m_model; }
+TileGridModel& TileGridCore::model() { return m_impl->m_model; }
+
+void TileGridCore::setIllegalArrowObserver(IllegalArrowObserver observer)
+{
+    m_impl->m_model.setIllegalArrowObserver(std::move(observer));
+}
+
+const PassInput& TileGridCore::lastPassInput() const { return m_impl->m_input; }
+IntRect TileGridCore::compositeVisibleRect() const { return m_impl->compositeVisibleRect(); }
+unsigned TileGridCore::outstandingJobs() const { return static_cast<unsigned>(m_impl->m_jobs.size()); }
+unsigned TileGridCore::pendingPixelBuffers() const { return static_cast<unsigned>(m_impl->m_buffers.size()); }
+unsigned TileGridCore::liveTextures() const { return static_cast<unsigned>(m_impl->m_textures.size()); }
+unsigned TileGridCore::lastSyncJobCount() const { return m_impl->m_lastSyncJobs; }
+unsigned TileGridCore::refusedRequests() const { return m_impl->m_refusedRequests; }
+unsigned TileGridCore::failedUploads() const { return m_impl->m_failedUploads; }
+
+TextureHandle TileGridCore::handleFor(TextureId id) const
+{
+    auto it = m_impl->m_textures.find(id);
+    return it == m_impl->m_textures.end() ? invalidTextureHandle : it->second.handle;
+}
+
+} // namespace TileGrid
+} // namespace WebCore
