+# window, which an App Container cannot create. Use the condition-variable
+# based generic event loop instead, like JSCOnly does (WTF_DEFAULT_EVENT_LOOP=0
+# stops PlatformUse.h from auto-selecting USE_WINDOWS_EVENT_LOOP on OS(WINDOWS));
+# matches PlatformWinUWP.cmake shipping generic/RunLoopGeneric.cpp.
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+SET_AND_EXPOSE_TO_BUILD(USE_MEDIA_FOUNDATION OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_GRAPHICS_LAYER_WC OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS OFF)
+SET_AND_EXPOSE_TO_BUILD(ENABLE_DEVELOPER_MODE ${DEVELOPER_MODE})
+
+# Apotheosis (M4): opt-in baseline JIT. wtf/PlatformEnable.h forces ENABLE_JIT=0 on every
+# 32-bit target except ARMv7 Linux, so ENABLE_JIT=ON above is inert by itself; with
+# WK_WINUWP_JIT the header keeps the cmake value. Off by default: the LLInt-only tree
+# stays reproducible and a JIT tree must be a separate build directory (ABI differs).
+option(APOTHEOSIS_JIT "Let ENABLE_JIT take effect on ARMv7 (JSC baseline JIT instead of LLInt)" OFF)
+if (APOTHEOSIS_JIT)
+    add_definitions(-DWK_WINUWP_JIT=1)
+endif ()
+
+option(APOTHEOSIS_GPU "Build the accelerated compositing path (TextureMapper on prebuilt ANGLE)" OFF)
+
+if (APOTHEOSIS_GPU)
+    # GPU recipe: synchronous GraphicsLayerTextureMapper (no coordinated graphics,
+    # no WC layer tree); the driver drives ANGLE/EGL itself and presents into a
+    # SwapChainPanel.
+    SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_GRAPHICS_LAYER_TEXTURE_MAPPER ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_ANGLE ON)
+    # Apotheosis: no GLFence - the prebuilt ANGLE 2.1.13 (ms-master) eglext.h
+    # predates EGL_KHR_fence_sync and the synchronous TextureMapper never
+    # fences; the GLFence* sources are omitted in PlatformWinUWP.cmake.
+    SET_AND_EXPOSE_TO_BUILD(HAVE_GL_FENCE OFF)
+    set(USE_ANGLE_EGL ON)
+    # The old eglext.h only declares the EXT entry points (like
+    # eglGetPlatformDisplayEXT, used by PlatformDisplayWin) behind this macro.
+    add_definitions(-DEGL_EGLEXT_PROTOTYPES=1)
+else ()
+    # Software-only: keep the accelerated compositor symbols out entirely.
+    SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER OFF)
+    SET_AND_EXPOSE_TO_BUILD(USE_GRAPHICS_LAYER_TEXTURE_MAPPER OFF)
+    SET_AND_EXPOSE_TO_BUILD(USE_ANGLE OFF)
+    set(USE_ANGLE_EGL OFF)
+endif ()
+
+# -----------------------------------------------------------------------------
+# Prebuilt ANGLE (NuGet ANGLE.WindowsStore, ARM32).
+# Source/CMakeLists.txt skips add_subdirectory(ThirdParty/ANGLE) when
+# APOTHEOSIS_GPU is on -- cross-building in-tree ANGLE for thumbv7 is not
+# viable -- so the ANGLE::EGL / ANGLE::GLES targets must be provided here.
+# -----------------------------------------------------------------------------
+if (APOTHEOSIS_GPU)
+    set(APOTHEOSIS_ANGLE_ROOT "" CACHE PATH
+        "Root of the prebuilt ANGLE drop: <root>/include headers, <root>/arm import libraries")
+
+    if (NOT APOTHEOSIS_ANGLE_ROOT)
+        foreach (_candidate
+            "${CMAKE_SOURCE_DIR}/../angle"
+            "${CMAKE_SOURCE_DIR}/../Project-Apotheosis/angle"
+        )
+            if (EXISTS "${_candidate}/include/EGL/egl.h")
+                get_filename_component(APOTHEOSIS_ANGLE_ROOT "${_candidate}" ABSOLUTE)
+                break ()
+            endif ()
+        endforeach ()
+    endif ()
+
+    if (NOT APOTHEOSIS_ANGLE_ROOT)
+        message(FATAL_ERROR
+            "APOTHEOSIS_GPU is ON but no prebuilt ANGLE was found. Pass "
+            "-DAPOTHEOSIS_ANGLE_ROOT=<dir> pointing at a directory with include/ and arm/.")
+    endif ()
+
+    set(APOTHEOSIS_ANGLE_INCLUDE_DIR "${APOTHEOSIS_ANGLE_ROOT}/include")
+    set(APOTHEOSIS_ANGLE_LIBRARY_DIR "${APOTHEOSIS_ANGLE_ROOT}/arm")
+
+    find_library(APOTHEOSIS_ANGLE_EGL_LIBRARY libEGL
+        PATHS "${APOTHEOSIS_ANGLE_LIBRARY_DIR}" NO_DEFAULT_PATH)
+    find_library(APOTHEOSIS_ANGLE_GLES_LIBRARY libGLESv2
+        PATHS "${APOTHEOSIS_ANGLE_LIBRARY_DIR}" NO_DEFAULT_PATH)
+
+    if (NOT APOTHEOSIS_ANGLE_EGL_LIBRARY OR NOT APOTHEOSIS_ANGLE_GLES_LIBRARY)
+        message(FATAL_ERROR
+            "Prebuilt ANGLE import libraries (libEGL.lib, libGLESv2.lib) not found in "
+            "${APOTHEOSIS_ANGLE_LIBRARY_DIR}. Extract the ARM payload of the "
+            "ANGLE.WindowsStore NuGet package there.")
+    endif ()
+
+    if (NOT TARGET ANGLE::EGL)
+        add_library(ANGLE::EGL UNKNOWN IMPORTED)
+        set_target_properties(ANGLE::EGL PROPERTIES
+            IMPORTED_LOCATION "${APOTHEOSIS_ANGLE_EGL_LIBRARY}"
+            INTERFACE_INCLUDE_DIRECTORIES "${APOTHEOSIS_ANGLE_INCLUDE_DIR}"
+            INTERFACE_COMPILE_DEFINITIONS "GL_GLEXT_PROTOTYPES;EGL_EGL_PROTOTYPES=1"
+        )
+    endif ()
+    if (NOT TARGET ANGLE::GLES)
+        add_library(ANGLE::GLES UNKNOWN IMPORTED)
+        set_target_properties(ANGLE::GLES PROPERTIES
+            IMPORTED_LOCATION "${APOTHEOSIS_ANGLE_GLES_LIBRARY}"
+            INTERFACE_INCLUDE_DIRECTORIES "${APOTHEOSIS_ANGLE_INCLUDE_DIR}"
+            INTERFACE_COMPILE_DEFINITIONS "GL_GLEXT_PROTOTYPES;GL_GLES_PROTOTYPES=1"
+        )
+    endif ()
+endif ()
+
+# -----------------------------------------------------------------------------
+# External dependencies. All of these come from the vcpkg arm-uwp triplet, from
+# C:\icu-arm-uwp, or from the hand-cross-built libraries under deps-build; they
+# are located through CMAKE_PREFIX_PATH.
+#
+# Kept last on purpose: everything above is port structure, so a failure here is
+# an environment problem, not a port problem.
+# -----------------------------------------------------------------------------
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+find_package(ZLIB 1.2.11 REQUIRED)
+
+if (ENABLE_WEBCORE)
+    find_package(Cairo 1.18.0 REQUIRED)
+    find_package(Freetype 2.9.0 REQUIRED)
+    find_package(Fontconfig 2.13.0 REQUIRED)
+    # Apotheosis: no COMPONENTS ICU -- our harfbuzz is built without hb-icu, and
+    # the single hb_icu_script_to_script() call was rewritten onto plain ICU
+    # (see the WK_WINUWP patch to LocaleICU.cpp / ComplexTextControllerHarfBuzz.cpp).
+    find_package(HarfBuzz 1.4.2 REQUIRED)
+    find_package(JPEG 1.5.2 REQUIRED)
+    find_package(PNG 1.6.34 REQUIRED)
+    find_package(WebP REQUIRED COMPONENTS demux)
+    find_package(LibXml2 2.9.7 REQUIRED)
+    find_package(SQLite3 3.23.1 REQUIRED)
+    find_package(CURL 7.87.0 REQUIRED)
+    find_package(OpenSSL REQUIRED)
+    # Apotheosis: no LibPSL on this port. The author's shipped builds link
+    # without it (PublicSuffixStoreCurl.cpp is not in the WinUWP source list;
+    # the port stubs that area), so unlike WinCairo we do not require it.
+
+    if (NOT TARGET SQLite3::SQLite3) # CMake < 4.3
+        add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
+    endif ()
+
+    # See if the OpenSSL implementation is BoringSSL
+    cmake_push_check_state()
+    set(CMAKE_REQUIRED_INCLUDES "${OPENSSL_INCLUDE_DIR}")
+    set(CMAKE_REQUIRED_LIBRARIES "${OPENSSL_LIBRARIES}")
+    WEBKIT_CHECK_HAVE_SYMBOL(USE_BORINGSSL OPENSSL_IS_BORINGSSL openssl/ssl.h)
+    cmake_pop_check_state()
+
+    if (USE_WOFF2)
+        find_package(WOFF2 1.0.2 REQUIRED COMPONENTS dec)
+        find_package(Brotli REQUIRED COMPONENTS dec)
+    endif ()
+endif ()
+
+# -----------------------------------------------------------------------------
+# Library types. Everything is static: the UWP host links one DLL
+# (WebCoreDriver-*.dll) built out of tree from port/*.cpp plus these archives.
+# -----------------------------------------------------------------------------
+set(bmalloc_LIBRARY_TYPE STATIC)
+set(WTF_LIBRARY_TYPE STATIC)
+set(JavaScriptCore_LIBRARY_TYPE STATIC)
+set(PAL_LIBRARY_TYPE STATIC)
+set(WebCore_LIBRARY_TYPE STATIC)
+set(WebCoreTestSupport_LIBRARY_TYPE STATIC)
