diff --git a/Source/WebCore/PlatformWinUWP.cmake b/Source/WebCore/PlatformWinUWP.cmake
new file mode 100644
index 0000000000..eeb3cbc4f5
--- /dev/null
+++ b/Source/WebCore/PlatformWinUWP.cmake
@@ -0,0 +1,228 @@
+# Apotheosis: WebCore platform glue for the WinUWP port (ARM32 App Container).
+#
+# Modeled on Source/WebCore/PlatformWin.cmake, stripped to the App-Container-safe
+# subset and re-pointed at the Cairo software graphics backend plus the
+# FreeType/Fontconfig/HarfBuzz font backend.
+#
+# Rules applied against PlatformWin.cmake:
+#   * KEEP    compiler-only flags; the coordinate/struct conversion *Win.cpp files;
+#             Curl/OpenSSL/ImageDecoders/Cairo glue; portable text and locale code;
+#             read-only Win helpers (SystemInfo/UserAgent/MIME/Logging).
+#   * DROP    MSAA/oleacc accessibility; clipboard/drag/OLE pasteboard; the native
+#             <select> popup; CreateWindow fullscreen and overlays; cursors;
+#             GDI image/icon/DIB painting; MediaFoundation video; SharedMemoryWin;
+#             Uniscribe and the win/win-cairo GDI+DirectWrite font backend.
+#   * REPLACE the font block with platform/FreeType.cmake.
+#   * DROP    the usp10 link library (Uniscribe -> HarfBuzz) and the whole
+#             MediaFoundation INTERFACE library (ENABLE_VIDEO and
+#             USE_MEDIA_FOUNDATION are forced off, so that block never runs).
+#
+# Files marked "STUB:" compile but call desktop-only APIs; they need a
+# NotImplemented or WinRT replacement before the driver links and runs. That
+# link error surface is milestone M1c, not this file's problem.
+
+add_definitions(/bigobj -D__STDC_CONSTANT_MACROS)
+
+# --- Form-control theming ---------------------------------------------------
+# Adwaita paints controls purely through Cairo (no UxTheme/GDI), so it is the
+# App-Container-safe RenderTheme. We deliberately do not take the RenderThemeWin
+# path.
+include(platform/Adwaita.cmake)
+
+# --- Networking, crypto, image decoding -------------------------------------
+include(platform/Curl.cmake)
+include(platform/ImageDecoders.cmake)
+include(platform/OpenSSL.cmake)
+
+# --- Graphics backend: Cairo software image surfaces ------------------------
+# Cairo.cmake's unified list still contains GraphicsContextGLCairo.cpp, but that
+# file is self-guarded by '#if ENABLE(WEBGL) && USE(CAIRO)' and compiles to
+# nothing here. The GdkPixbuf branch in ImageBufferUtilitiesCairo.cpp is inert
+# because PLATFORM(GTK) is undefined for PORT=WinUWP.
+if (USE_CAIRO)
+    include(platform/Cairo.cmake)
+endif ()
+
+# --- Accelerated compositing (APOTHEOSIS_GPU only) --------------------------
+# TextureMapper with the synchronous GraphicsLayerTextureMapper backend
+# (USE_COORDINATED_GRAPHICS off, USE_GRAPHICS_LAYER_WC off). The driver owns the
+# EGL surface and presents into a SwapChainPanel; WebCore only needs to be able
+# to paint the layer tree through ANGLE's GLES2.
+if (USE_TEXTURE_MAPPER)
+    include(platform/TextureMapper.cmake)
+
+    # UWP-TODO: PlatformDisplayWin.cpp still resolves an HWND for the EGL native
+    # window. The driver supplies the SwapChainPanel surface itself, so this may
+    # have to become a WK_WINUWP-guarded stub once M1c reaches it.
+    list(APPEND WebCore_SOURCES
+        platform/graphics/PlatformDisplay.cpp
+
+        platform/graphics/angle/PlatformDisplayANGLE.cpp
+
+        platform/graphics/egl/GLContext.cpp
+        platform/graphics/egl/GLContextWrapper.cpp
+        platform/graphics/egl/GLDisplay.cpp
+        # Apotheosis: no GLFence* here - the prebuilt ANGLE 2.1.13 (ms-master)
+        # eglext.h predates EGL_KHR_fence_sync, nothing on the synchronous
+        # TextureMapper path uses fences, and the author's draft omits them too.
+
+        platform/graphics/win/PlatformDisplayWin.cpp
+    )
+
+    list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+        platform/graphics/win/PlatformDisplayWin.h
+    )
+endif ()
+
+# --- Font/text backend: FreeType + Fontconfig + HarfBuzz --------------------
+# This replaces the entire win/win-cairo GDI + DirectWrite + Uniscribe + MLang
+# font stack and SystemFontDatabaseWin. FreeType.cmake also pulls in
+# platform/graphics/cairo/FontCairoHarfbuzzNG.cpp, which is the Cairo glyph-draw
+# glue the dropped Font*WinCairo files used to provide.
+# UWP-TODO (runtime, not cmake): Fontconfig needs a writable cache directory or a
+# baked-in fonts.conf inside the App Container sandbox.
+include(platform/FreeType.cmake)
+
+# --- Private include directories --------------------------------------------
+# Dropped versus PlatformWin.cmake: accessibility/win (MSAA) and
+# platform/video-codecs (no media). platform/graphics/egl is NOT added by
+# WebCore/CMakeLists.txt for this option set (texmap includes GLContext.h
+# unqualified), so list it here.
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/accessibility/win" # headers only (AXCoreObject.h includes the wrapper); MSAA sources stay out
+    "${WEBCORE_DIR}/page/win"
+    "${WEBCORE_DIR}/platform/graphics/egl"
+    "${WEBCORE_DIR}/platform/graphics/opentype"
+    "${WEBCORE_DIR}/platform/graphics/win"
+    "${WEBCORE_DIR}/platform/mediacapabilities"
+    "${WEBCORE_DIR}/platform/video-codecs" # headers only (AV1/VP9Utilities include BitReader.h); codec sources stay out
+    "${WEBCORE_DIR}/platform/network/win"
+    "${WEBCORE_DIR}/platform/win"
+)
+
+list(APPEND WebCore_SOURCES
+    # --- page/win: event and frame glue (no HWND message pump involved) ---
+    page/win/EventHandlerWin.cpp
+    page/win/FrameWin.cpp
+
+    # --- portable platform bits ---
+    platform/LocalizedStrings.cpp
+
+    platform/generic/KeyedDecoderGeneric.cpp
+    platform/generic/KeyedEncoderGeneric.cpp
+
+    # --- OpenType / custom-font table parsing (no GDI) ---
+    platform/graphics/opentype/OpenTypeUtilities.cpp
+
+    # --- graphics/win: struct <-> Float/Int conversions only ---
+    platform/graphics/win/FloatPointWin.cpp
+    platform/graphics/win/FloatRectWin.cpp
+    platform/graphics/win/IntPointWin.cpp
+    platform/graphics/win/IntRectWin.cpp
+    platform/graphics/win/IntSizeWin.cpp
+    platform/graphics/win/TransformationMatrixWin.cpp
+
+    # --- network/win: CA certificate load through crypt32 ---
+    # DROPPED NetworkStateNotifierWin.cpp: the overlapped NotifyAddrChange
+    # notification is not in the App Container API set. UWP-TODO: either a WinRT
+    # connectivity-backed notifier or a link stub.
+    platform/network/win/CurlSSLHandleWin.cpp
+
+    # --- text ---
+    platform/text/Hyphenation.cpp
+    platform/text/LocaleICU.cpp
+
+    # --- platform/win: read-only and struct helpers ---
+    platform/win/BString.cpp
+    platform/win/BitmapInfo.cpp
+    platform/win/KeyEventWin.cpp
+    platform/win/LoggingWin.cpp
+    platform/win/MIMETypeRegistryWin.cpp
+    platform/win/SystemInfo.cpp
+    platform/win/UserAgentWin.cpp
+    platform/win/WebCoreTextRenderer.cpp
+    platform/win/WindowsKeyNames.cpp
+
+    # --- sources that build but need a non-desktop reimplementation ---
+    # STUB: stores the HINSTANCE via DllMain, which a UWP app never runs.
+    platform/win/WebCoreInstanceHandle.cpp
+    # STUB: resolves WebKit.resources through GetModuleFileName; repoint at the
+    # UWP package install location.
+    platform/win/WebCoreBundleWin.cpp
+    # STUB: SQLite-backed search autosave; repoint the database at the app-data
+    # sandbox path or make it in-memory.
+    platform/win/SearchPopupMenuDB.cpp
+
+    # DROPPED platform/win/MainThreadSharedTimerWin.cpp: it drives the shared
+    # timer from a hidden HWND_MESSAGE window. The WK_WINUWP patch widens the
+    # generic RunLoop::Timer branch of MainThreadSharedTimer to USE(FREETYPE),
+    # so the portable implementation is active and the Win one would be a
+    # duplicate definition.
+)
+
+list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+    page/win/FrameWin.h
+
+    # RAII wrapper for an in-memory font resource. The header is kept (the
+    # WK_WINUWP patch makes its destructor a no-op outside the desktop
+    # partition); the AddFontMemResourceEx creator lives in an excluded file.
+    platform/graphics/opentype/FontMemoryResource.h
+
+    platform/graphics/win/DIBPixelData.h
+    platform/graphics/win/LocalWindowsContext.h
+    platform/graphics/win/SharedGDIObject.h
+
+    platform/win/BString.h
+    platform/win/BitmapInfo.h
+    platform/win/COMPtr.h
+    platform/win/HWndDC.h
+    platform/win/SearchPopupMenuDB.h
+    platform/win/SystemInfo.h
+    platform/win/WebCoreBundleWin.h
+    platform/win/WebCoreTextRenderer.h
+    platform/win/WindowsKeyNames.h
+)
+
+# crypt32 (certificate store for OpenSSL/curl) and iphlpapi (adapter info) are
+# in the App Container import set. usp10 (Uniscribe) is replaced by HarfBuzz,
+# which FreeType.cmake links.
+list(APPEND WebCore_LIBRARIES
+    crypt32
+    iphlpapi
+)
+
+# Broken-image and resize-corner icons used during paint, plus the modern
+# media-control images.
+set(iconFiles
+    Resources/missingImage.png
+    Resources/missingImage@2x.png
+    Resources/missingImage@3x.png
+    Resources/panIcon.png
+    Resources/textAreaResizeCorner.png
+    Resources/textAreaResizeCorner@2x.png
+)
+
+file(COPY ${iconFiles} DESTINATION ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/WebKit.resources/icons)
+
+file(COPY ${ModernMediaControlsImageFiles}
+    DESTINATION
+    ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/WebKit.resources/media-controls
+)
+
+# The non-font survivors of PlatformWin.cmake's USE_CAIRO block are dropped
+# after all: both files are pure GDI interop (cairo_win32_surface from HDC /
+# HBITMAP) and require the cairo-win32 backend, which cannot exist in an App
+# Container - our cairo is built without it (see local patch skipping the GDI
+# win32 surface/font backends under WINAPI_FAMILY_APP). If the driver link
+# misses GraphicsContext::getWindowsContext/releaseWindowsContext or
+# ImageAdapter symbols, stub them NotImplemented in the driver instead of
+# reintroducing GDI.
+
+# Kept verbatim from PlatformWin.cmake so that flipping USE_WOFF2 on later works
+# unchanged. USE_WOFF2 is off for the minimal bring-up configuration.
+if (USE_WOFF2)
+    list(APPEND WebCore_LIBRARIES
+        Brotli::dec
+        WOFF2::common
+    )
+endif ()
